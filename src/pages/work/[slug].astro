---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const caseStudies = await getCollection('caseStudies');
  return caseStudies.map((entry) => ({
    params: { slug: entry.data.slug || entry.id },
    props: { entry },
  }));
}

export interface Props {
  entry: CollectionEntry<'caseStudies'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const slug = entry.data.slug || entry.id;
const title = entry.data.metaTitle && entry.data.metaTitle.length <= 60
  ? entry.data.metaTitle
  : `${entry.data.title}`.slice(0, 50) + ' | Tibin';
const description = entry.data.description;
const canonicalUrl = `https://tibinjacob.com/work/${slug}`;
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schemaType="Article"
  publishedDate={entry.data.publishedDate}
  updatedDate={entry.data.updatedDate}
  faq={entry.data.faq}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Experience', url: '/work' },
    { name: entry.data.company, url: `/work/${slug}` },
  ]}
>
  <article class="py-6 max-w-4xl mx-auto">
    <!-- 1. Breadcrumb -->
    <nav class="text-xs font-mono text-slate-400 mb-6 flex items-center gap-2" aria-label="Breadcrumb">
      <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
      <span>/</span>
      <a href="/work" class="hover:text-slate-900 transition-colors">Experience</a>
      <span>/</span>
      <span class="text-slate-600 truncate max-w-xs">{entry.data.company}</span>
    </nav>

    <!-- Header -->
    <header class="mb-8 pb-6 border-b border-slate-200">
      <!-- 2. Company + role + dates (small meta line) -->
      <div class="flex flex-wrap items-center gap-3 mb-3 text-xs font-mono text-slate-500">
        <span class="text-slate-900 font-bold">{entry.data.company}</span>
        <span>·</span>
        <span>Role: <strong class="text-slate-800">{entry.data.role}</strong></span>
        <span>·</span>
        <span>{entry.data.dates}</span>
      </div>

      <!-- 3. H1 — case study title -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 mb-4 leading-tight">
        {entry.data.title}
      </h1>

      {entry.data.image && (
        <div class="relative w-full aspect-[16/9] sm:aspect-[21/9] rounded-2xl overflow-hidden bg-zinc-900 my-6 border border-zinc-200 shadow-md">
          <img
            src={entry.data.image}
            alt={entry.data.title}
            class="w-full h-full object-cover"
            referrerpolicy="no-referrer"
          />
        </div>
      )}
    </header>

    <!-- 4-8. Main Content (includes Short Answer, Context, System, How I built it, Results) -->
    <div class="prose max-w-none space-y-6 text-slate-700 leading-relaxed text-sm sm:text-base">
      <Content />
    </div>

    <!-- 9-10. Related Links & CTA -->
    <footer class="mt-12 pt-8 border-t border-slate-200 flex flex-wrap justify-between items-center gap-4">
      {entry.data.proofLink ? (
        <a href={entry.data.proofLink} class="text-xs font-mono text-[#16a34a] hover:underline font-semibold">
          ← See the workflow: Underlying Technical Architecture
        </a>
      ) : (
        <a href="/work" class="text-xs font-mono text-slate-500 hover:text-slate-900 transition-colors">
          ← Back to Selected work
        </a>
      )}

      <a href="/hire" class="cta-button text-xs px-4 py-2 rounded-lg font-bold">
        Hire me for this
      </a>
    </footer>
  </article>
</BaseLayout>
