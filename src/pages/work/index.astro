---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allCaseStudies = await getCollection('caseStudies');
const order = ['mavlers-partner-agency-signals', 'paddleboat-sdr-scaling-signals', 'heurist-autopilot-agents', 'sonic-founder-led-gtm'];
const caseStudies = allCaseStudies.sort((a, b) => {
  const indexA = order.indexOf(a.data.slug || a.id);
  const indexB = order.indexOf(b.data.slug || b.id);
  return (indexA === -1 ? 99 : indexA) - (indexB === -1 ? 99 : indexB);
});

const title = "GTM Engineering Case Studies | Tibin Jacob";
const description = "Production GTM engineering case studies: signal-based outbound, waterfall enrichment, and AI agent architectures across B2B SaaS and agencies.";
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Experience', url: '/work' },
  ]}
>
  <div class="py-6 max-w-5xl mx-auto">
    <div class="mb-10">
      <div class="text-[11px] font-mono uppercase tracking-wider text-zinc-500 font-semibold mb-2">
        Recent experiences
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-zinc-900 mb-4 font-display">
        Selected <span class="heading-highlight">work.</span>
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 leading-relaxed max-w-2xl">
        Real revenue systems engineered in production. Every study documents the core bottleneck, system architecture, failure handling, and verified outcomes.
      </p>
    </div>

    <div class="space-y-6">
      {caseStudies.map((cs) => {
        const slug = cs.data.slug || cs.id;
        const imageUrl = cs.data.image || `/images/case-studies/${slug.split('-')[0]}.jpg`;
        const tag = cs.data.tag || `#${cs.data.cluster.replace(/\s+/g, '')}`;
        const avatarUrl = cs.data.authorAvatar || "/images/tibin-avatar.jpg";

        return (
          <article class="bg-white hover:bg-[#f8fafc] border border-zinc-200 hover:border-[#c7ddff] p-4 sm:p-6 rounded-[24px] sm:rounded-[28px] transition-all duration-300 group shadow-sm hover:shadow-xl">
            <a href={`/work/${slug}`} class="grid grid-cols-1 md:grid-cols-12 gap-5 sm:gap-6 items-center">

              <!-- Left Side: Image with Tag Overlay -->
              <div class="md:col-span-4 relative aspect-[4/3] w-full rounded-2xl overflow-hidden bg-zinc-100 border border-zinc-200">
                <span class="absolute top-3 left-3 z-10 px-2.5 py-1 rounded-md bg-[#0a1428]/90 backdrop-blur-md text-[11px] font-mono font-bold text-[#6fa8ff] tracking-wide border border-white/15">
                  {tag}
                </span>
                <img
                  src={imageUrl}
                  alt={cs.data.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  referrerpolicy="no-referrer"
                  loading="lazy"
                  onerror="this.onerror=null; this.src='/images/hero-bg.webp';"
                />
              </div>

              <!-- Right Side: Content & Metadata -->
              <div class="md:col-span-8 flex flex-col justify-between h-full py-1 gap-4">
                <div class="flex flex-col gap-2.5">
                  <div class="flex items-center justify-between text-xs font-mono">
                    <span class="text-zinc-950 font-bold uppercase">{cs.data.company}</span>
                    <span class="text-zinc-500 font-medium">{cs.data.dates}</span>
                  </div>

                  <h2 class="text-zinc-950 text-[23px] sm:text-[27px] font-bold tracking-tight leading-snug group-hover:text-[#1e5eff] transition-colors">
                    {cs.data.title}
                  </h2>

                  <p class="text-zinc-600 text-sm sm:text-[15px] leading-relaxed font-normal line-clamp-3">
                    {cs.data.description}
                  </p>
                </div>

                <!-- Author & Action Footer Row -->
                <div class="pt-4 border-t border-zinc-200 flex items-center justify-between gap-4 mt-2">
                  <div class="flex items-center gap-3">
                    <img
                      src={avatarUrl}
                      alt={cs.data.author || "Tibin Jacob"}
                      class="w-8 h-8 rounded-full object-cover border border-zinc-200 shrink-0"
                      referrerpolicy="no-referrer"
                    />
                    <div class="flex flex-col">
                      <span class="text-xs font-bold text-zinc-950">
                        by {cs.data.author || "Tibin Jacob"}
                      </span>
                      <span class="text-[11px] text-zinc-500 font-mono">
                        {cs.data.role}
                      </span>
                    </div>
                  </div>

                  <div class="flex items-center gap-2 shrink-0">
                    <div class="w-9 h-9 rounded-full bg-[#0a1428] group-hover:bg-[#10213f] text-[#6fa8ff] flex items-center justify-center transition-all duration-300 border border-white/20 group-hover:scale-105">
                      <svg class="w-4 h-4 transition-transform group-hover:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="7" y1="17" x2="17" y2="7"></line>
                        <polyline points="7 7 17 7 17 17"></polyline>
                      </svg>
                    </div>
                  </div>
                </div>

              </div>
            </a>
          </article>
        );
      })}
    </div>
  </div>
</BaseLayout>
