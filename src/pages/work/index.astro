---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const caseStudies = await getCollection('caseStudies');

const title = "GTM Engineering Case Studies | Tibin Jacob";
const description = "Production GTM engineering case studies: signal-based outbound, waterfall enrichment, and AI agent architectures across B2B SaaS and agencies.";
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Work', url: '/work' },
  ]}
>
  <div class="py-6 max-w-5xl mx-auto">
    <div class="mb-10">
      <div class="text-xs font-mono uppercase tracking-wider text-[var(--accent)] mb-2">
        Portfolio & Architecture
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-white mb-4">
        GTM Engineering Case Studies
      </h1>
      <p class="text-base sm:text-lg text-gray-300 leading-relaxed max-w-2xl">
        Real revenue systems engineered in production. Every study documents the core bottleneck, system architecture, failure handling, and verified outcomes.
      </p>
    </div>

    <div class="space-y-8">
      {caseStudies.map((cs) => (
        <article class="p-6 sm:p-8 rounded-2xl border border-[var(--surface-border)] bg-[var(--surface)] hover:border-white/20 transition-all">
          <div class="flex flex-wrap items-baseline justify-between gap-2 mb-3">
            <div class="flex items-center gap-3">
              <span class="text-base sm:text-lg font-bold text-white">{cs.data.company}</span>
              <span class="text-xs font-mono text-[var(--accent)] bg-[var(--accent)]/10 px-2 py-0.5 rounded">
                {cs.data.cluster}
              </span>
            </div>
            <span class="text-xs font-mono text-gray-400">{cs.data.dates}</span>
          </div>

          <h2 class="text-xl sm:text-2xl font-bold text-white mb-3 leading-snug">
            <a href={`/work/${cs.data.slug || cs.id}`} class="hover:text-[var(--accent)] transition-colors">
              {cs.data.title}
            </a>
          </h2>

          <p class="text-sm text-gray-300 leading-relaxed mb-6 max-w-3xl">
            {cs.data.description}
          </p>

          <div class="pt-4 border-t border-white/5 flex flex-wrap items-center justify-between gap-4">
            <span class="text-xs font-mono text-gray-400">Role: {cs.data.role}</span>
            <div class="flex items-center gap-4">
              {cs.data.proofLink && (
                <a href={cs.data.proofLink} class="text-xs font-mono text-gray-400 hover:text-white transition-colors">
                  View Associated Workflow →
                </a>
              )}
              <a
                href={`/work/${cs.data.slug || cs.id}`}
                class="cta-button px-4 py-2 rounded-lg text-xs font-semibold"
              >
                Read Technical Case Study
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
