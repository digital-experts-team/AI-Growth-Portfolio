---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const caseStudies = await getCollection('caseStudies');

const title = "GTM Engineering Case Studies | Tibin Jacob";
const description = "Production GTM engineering case studies: signal-based outbound, waterfall enrichment, and AI agent architectures across B2B SaaS and agencies.";
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Work', url: '/work' },
  ]}
>
  <div class="py-6 max-w-5xl mx-auto">
    <div class="mb-10">
      <div class="text-[11px] font-mono uppercase tracking-wider text-cyan-600 font-semibold mb-2">
        Portfolio & Architecture
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-slate-900 mb-4">
        GTM Engineering Case Studies
      </h1>
      <p class="text-base sm:text-lg text-slate-500 leading-relaxed max-w-2xl">
        Real revenue systems engineered in production. Every study documents the core bottleneck, system architecture, failure handling, and verified outcomes.
      </p>
    </div>

    <div class="space-y-6">
      {caseStudies.map((cs) => (
        <article class="p-6 sm:p-8 rounded-2xl border border-slate-200/90 bg-white hover:border-slate-300 hover:shadow-sm transition-all group">
          <div class="flex flex-wrap items-baseline justify-between gap-2 mb-3">
            <div class="flex items-center gap-3">
              <span class="text-base sm:text-lg font-bold text-slate-900">{cs.data.company}</span>
              <span class="text-xs font-mono text-cyan-700 bg-cyan-50 border border-cyan-200 px-2 py-0.5 rounded">
                {cs.data.cluster}
              </span>
            </div>
            <span class="text-xs font-mono text-slate-400">{cs.data.dates}</span>
          </div>

          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors mb-3 leading-snug">
            <a href={`/work/${cs.data.slug || cs.id}`}>
              {cs.data.title}
            </a>
          </h2>

          <p class="text-sm text-slate-600 leading-relaxed mb-6 max-w-3xl">
            {cs.data.description}
          </p>

          <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-4">
            <span class="text-xs font-mono text-slate-400">Role: {cs.data.role}</span>
            <div class="flex items-center gap-4">
              {cs.data.proofLink && (
                <a href={cs.data.proofLink} class="text-xs font-mono text-slate-500 hover:text-slate-900 transition-colors">
                  View Associated Workflow →
                </a>
              )}
              <a
                href={`/work/${cs.data.slug || cs.id}`}
                class="text-xs font-semibold text-[#1d6ff2] hover:underline inline-flex items-center gap-1"
              >
                Read Case Study →
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
