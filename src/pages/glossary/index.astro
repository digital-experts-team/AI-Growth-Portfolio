---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const glossaryItems = await getCollection('glossary');

const title = "GTM & RevOps Glossary: Clear AEO Definitions | Tibin";
const description = "Concise, plain-language definitions of core GTM engineering and RevOps concepts: waterfall enrichment, signal-based selling, lead routing, MQL, and SQL.";
---

<BaseLayout
  title={title}
  description={description}
  schemaType="DefinedTermSet"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Glossary', url: '/glossary' },
  ]}
>
  <div class="py-6 max-w-5xl mx-auto">
    <div class="mb-10">
      <div class="text-[11px] font-mono uppercase tracking-wider text-cyan-600 font-semibold mb-2">
        AEO & Vocabulary Index
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-slate-900 mb-4">
        GTM Engineering Glossary
      </h1>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl">
        Clear, 50-word technical definitions of revenue architecture terms, written for sales leaders, engineers, and search engines.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {glossaryItems.map((item) => (
        <article class="p-6 rounded-2xl border border-slate-200/90 bg-white hover:border-slate-300 hover:shadow-sm transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-2">
              <span class="text-cyan-700 bg-cyan-50 border border-cyan-200 px-2 py-0.5 rounded">{item.data.cluster}</span>
              <span class="text-slate-400">Defined Term</span>
            </div>
            <h2 class="text-xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors mb-3">
              <a href={`/glossary/${item.data.slug || item.id}`}>
                {item.data.title}
              </a>
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
              {item.data.definition}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            <span class="text-xs font-mono text-slate-400">Related: {item.data.related.join(', ')}</span>
            <a
              href={`/glossary/${item.data.slug || item.id}`}
              class="text-xs font-semibold text-[#1d6ff2] hover:underline"
            >
              Read Full Entry →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
