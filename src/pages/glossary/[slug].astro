---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const glossary = await getCollection('glossary');
  return glossary.map((entry) => ({
    params: { slug: entry.data.slug || entry.id },
    props: { entry },
  }));
}

export interface Props {
  entry: CollectionEntry<'glossary'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const slug = entry.data.slug || entry.id;
const title = `${entry.data.title}: Definition & GTM Architecture | Tibin`;
const description = entry.data.description;
---

<BaseLayout
  title={title}
  description={description}
  schemaType="DefinedTerm"
  publishedDate={entry.data.publishedDate}
  updatedDate={entry.data.updatedDate}
  faq={entry.data.faq}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Glossary', url: '/glossary' },
    { name: entry.data.title, url: `/glossary/${slug}` },
  ]}
>
  <article class="py-6 max-w-4xl mx-auto">
    <!-- Breadcrumbs -->
    <nav class="text-xs font-mono text-gray-500 mb-6 flex items-center gap-2" aria-label="Breadcrumb">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <span>/</span>
      <a href="/glossary" class="hover:text-white transition-colors">Glossary</a>
      <span>/</span>
      <span class="text-gray-300">{entry.data.title}</span>
    </nav>

    <!-- Header -->
    <header class="mb-10 pb-8 border-b border-[var(--surface-border)]">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-xs font-mono text-[var(--accent)] bg-[var(--accent)]/10 px-2.5 py-1 rounded">
          {entry.data.cluster}
        </span>
        <span class="text-xs font-mono text-gray-400">
          Target Term: <strong class="text-white">{entry.data.title}</strong>
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white mb-4 leading-tight">
        {entry.data.title}
      </h1>

      <p class="text-base sm:text-lg text-gray-300 leading-relaxed max-w-2xl">
        {entry.data.description}
      </p>
    </header>

    <!-- MDX Content -->
    <div class="prose prose-invert max-w-none space-y-6 text-gray-300 leading-relaxed text-sm sm:text-base">
      <Content />
    </div>

    <!-- Related Terms -->
    {entry.data.related && entry.data.related.length > 0 && (
      <div class="my-10 p-6 rounded-xl border border-[var(--surface-border)] bg-[var(--surface)]">
        <h3 class="text-sm font-bold text-white font-mono uppercase tracking-wider mb-3">
          Related GTM Concepts
        </h3>
        <div class="flex flex-wrap gap-2">
          {entry.data.related.map((term) => (
            <a
              href={`/glossary/${term}`}
              class="text-xs font-mono px-3 py-1.5 rounded-lg border border-white/10 bg-white/5 text-gray-300 hover:text-white hover:border-[var(--accent)] transition-all"
            >
              {term} →
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Footer -->
    <footer class="mt-12 pt-8 border-t border-[var(--surface-border)] flex flex-wrap justify-between items-center gap-4">
      <a href="/glossary" class="text-xs font-mono text-gray-400 hover:text-white transition-colors">
        ← Back to All Glossary Terms
      </a>

      <a href="/hire" class="cta-button text-xs px-4 py-2 rounded-lg">
        Hire me to architect your revenue stack
      </a>
    </footer>
  </article>
</BaseLayout>
