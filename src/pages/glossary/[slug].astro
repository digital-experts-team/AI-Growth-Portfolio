---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const glossary = await getCollection('glossary');
  return glossary.map((entry) => ({
    params: { slug: entry.data.slug || entry.id },
    props: { entry },
  }));
}

export interface Props {
  entry: CollectionEntry<'glossary'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const slug = entry.data.slug || entry.id;
const title = `What is ${entry.data.title}? Definition & GTM Architecture | Tibin Jacob`;
const description = entry.data.description;
---

<BaseLayout
  title={title}
  description={description}
  schemaType="DefinedTerm"
  publishedDate={entry.data.publishedDate}
  updatedDate={entry.data.updatedDate}
  faq={entry.data.faq}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Glossary', url: '/glossary' },
    { name: entry.data.title, url: `/glossary/${slug}` },
  ]}
>
  <article class="py-6 max-w-4xl mx-auto">
    <!-- Breadcrumbs -->
    <nav class="text-xs font-mono text-slate-400 mb-6 flex items-center gap-2" aria-label="Breadcrumb">
      <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
      <span>/</span>
      <a href="/glossary" class="hover:text-slate-900 transition-colors">Glossary</a>
      <span>/</span>
      <span class="text-slate-600">{entry.data.title}</span>
    </nav>

    <!-- Header -->
    <header class="mb-10 pb-8 border-b border-slate-200">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-xs font-mono text-cyan-700 bg-cyan-50 border border-cyan-200 px-2.5 py-1 rounded">
          {entry.data.cluster}
        </span>
        <span class="text-xs font-mono text-slate-500">
          Target Term: <strong class="text-slate-900">{entry.data.title}</strong>
        </span>
      </div>

      <div class="text-xs font-mono uppercase tracking-wider text-cyan-600 font-semibold mb-2">
        {entry.data.title}
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-slate-900 mb-4 leading-tight">
        What is {entry.data.title}?
      </h1>

      <!-- AEO Definition Box -->
      <div class="p-5 rounded-xl border border-cyan-200 bg-cyan-50/50 my-6">
        <div class="text-[11px] font-mono text-cyan-700 font-semibold uppercase tracking-wider mb-2">
          Direct AEO Answer / Definition
        </div>
        <p class="text-base sm:text-lg text-slate-900 leading-relaxed font-medium">
          {entry.data.definition}
        </p>
      </div>

      <div class="flex flex-wrap gap-2 text-xs font-mono text-slate-500">
        <span>Related Concepts:</span>
        {entry.data.related.map((r) => (
          <span class="bg-slate-100 border border-slate-200 text-slate-700 px-2 py-0.5 rounded">
            {r}
          </span>
        ))}
      </div>
    </header>

    <!-- Content -->
    <div class="prose max-w-none space-y-6 text-slate-700 leading-relaxed text-sm sm:text-base">
      <Content />
    </div>

    <!-- Related Links & CTA -->
    <footer class="mt-12 pt-8 border-t border-slate-200 flex flex-wrap justify-between items-center gap-4">
      <a href="/glossary" class="text-xs font-mono text-slate-500 hover:text-slate-900 transition-colors">
        ← Back to Glossary Index
      </a>

      <a href="/hire" class="cta-button text-xs px-4 py-2 rounded-lg">
        Discuss Technical Implementation
      </a>
    </footer>
  </article>
</BaseLayout>
