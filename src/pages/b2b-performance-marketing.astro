---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'B2B Performance Marketing Measured to Pipeline | Tibin Jacob';
const description = 'B2B performance marketing on Meta and Google Ads, tracked past the lead form through MQL and SQL stages in HubSpot, so spend is judged on qualified pipeline.';
const faq = [
  {
    q: 'What is B2B performance marketing?',
    a: 'B2B performance marketing is paid acquisition, mostly search and social ads, managed against measurable business outcomes. For B2B that means qualified pipeline and revenue, not clicks or raw lead counts.',
  },
  {
    q: 'Why measure paid ads to SQLs instead of cost per lead?',
    a: 'Cost per lead rewards cheap, low-intent form fills. Tracking each campaign through MQL and SQL stages shows which spend actually produces opportunities sales will work.',
  },
  {
    q: 'Which ad platforms do you work with?',
    a: 'Meta Ads and Google Ads, measured with GA4, Looker Studio, Microsoft Clarity and HubSpot.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'B2B Performance Marketing', url: '/b2b-performance-marketing' },
  ]}
  faq={faq}
>
  <article class="flex flex-col gap-12 py-6 sm:py-10 max-w-[800px]">
    <header class="flex flex-col gap-4">
      <h1 class="text-[34px] sm:text-[42px] font-bold text-slate-900 tracking-tight leading-tight">B2B performance marketing, measured to pipeline</h1>
      <div class="border-l-4 border-[#1d6ff2] pl-4">
        <p class="text-[16px] text-slate-700 leading-relaxed">I run Meta and Google Ads for B2B and track every campaign past the lead form, through MQL and SQL stages in the CRM. Because I also build the routing and scoring behind the form, paid traffic lands in a system that qualifies it, and spend is judged on pipeline rather than clicks.</p>
      </div>
    </header>

    <section class="flex flex-col gap-4" aria-labelledby="how-heading">
      <h2 id="how-heading" class="text-[24px] font-bold text-slate-900">How paid demand connects to GTM engineering</h2>
      <ul class="flex flex-col gap-3 text-[15px] text-slate-700 leading-relaxed list-disc pl-5">
        <li><strong class="text-slate-900">Audience from the ICP.</strong> Targeting and exclusions come from the same ICP and firmographic rules used for outbound, so paid and outbound go after the same accounts.</li>
        <li><strong class="text-slate-900">Every lead source tracked.</strong> UTMs and form fields carry campaign data into HubSpot so each contact keeps its source through the funnel.</li>
        <li><strong class="text-slate-900">Qualified before sales sees it.</strong> Paid leads are enriched, scored and routed with the same MQL to SQL rules as every other source.</li>
        <li><strong class="text-slate-900">Funnel diagnosis.</strong> GA4 and Microsoft Clarity show where visitors drop off on landing pages, before budget gets increased.</li>
        <li><strong class="text-slate-900">Reporting on pipeline.</strong> Looker Studio and HubSpot reports show cost per qualified lead and marketing-sourced pipeline by campaign.</li>
      </ul>
    </section>

    <section class="flex flex-col gap-3" aria-labelledby="tools-heading">
      <h2 id="tools-heading" class="text-[24px] font-bold text-slate-900">Tools</h2>
      <p class="text-[15px] text-slate-700">Meta Ads, Google Ads, GA4, Looker Studio, Microsoft Clarity, HubSpot.</p>
    </section>

    <section class="flex flex-col gap-3 p-6 rounded-2xl bg-slate-50 border border-slate-200" aria-labelledby="proof-heading">
      <h2 id="proof-heading" class="text-[18px] font-bold text-slate-900">Related work</h2>
      <p class="text-[14px] text-slate-600 leading-relaxed">At Mavlers I built the lead qualification side: site intent, firmographics and engagement routed through MQL to SQL stages in HubSpot. <a class="text-[#1d6ff2] hover:underline" href="/work/mavlers-partner-agency-signals">Read the Mavlers case study</a>.</p>
    </section>

    <section class="flex flex-col gap-3" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-[24px] font-bold text-slate-900">Questions</h2>
      {faq.map((item) => (
        <details class="border-b border-slate-200 py-3">
          <summary class="text-[16px] font-semibold text-slate-900 cursor-pointer">{item.q}</summary>
          <p class="text-[14px] text-slate-600 leading-relaxed pt-2">{item.a}</p>
        </details>
      ))}
    </section>

    <footer class="flex flex-wrap gap-4 items-center justify-between pt-4 border-t border-slate-200">
      <a href="/glossary/mql" class="text-[14px] font-semibold text-[#1d6ff2] hover:underline">What counts as an MQL</a>
      <a href="/hire" class="inline-flex items-center px-5 py-2.5 bg-[#1d6ff2] hover:bg-blue-600 text-white text-[14px] font-semibold rounded-lg">Hire me for this</a>
    </footer>
  </article>
</BaseLayout>
