---
import BaseLayout from '../layouts/BaseLayout.astro';
import { WorkflowsCarousel } from '../components/WorkflowsCarousel';
import StoriesSection from '../components/StoriesSection.astro';
import TechStackRail from '../components/TechStackRail.astro';
import { ContactForm } from '../components/ContactForm';
import { getCollection } from 'astro:content';

const allWorkflows = await getCollection('workflows');
const workflowItems = allWorkflows.map((w) => ({
  slug: w.data.slug || w.id,
  tools: w.data.tools ? `• ${w.data.tools.slice(0, 3).join(' • ')}` : '• Clay • HubSpot • n8n',
  title: w.data.title,
  description: w.data.description,
}));

const title = "Tibin Jacob — GTM Engineer | Signals into Pipeline That Drive Your Business";
const description = "GTM Engineer specializing in Clay, n8n, HubSpot, and AI agents, with full-funnel content and demand architecture that feeds them.";
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl="https://gtm-expert-tibin.vercel.app"
>
  <div class="flex flex-col gap-20 py-6 sm:py-10">
    <!-- HERO SECTION -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center pt-2" aria-labelledby="hero-heading">
      <div class="lg:col-span-7 flex flex-col items-start gap-4">
        <span class="text-[11px] font-semibold text-cyan-600 tracking-wider uppercase font-mono">
          AVAILBLE FOR CONTRACTS AND FULL-TIME
        </span>
        <h1 id="hero-heading" class="text-[40px] sm:text-[46px] font-bold text-slate-900 tracking-tight leading-[1.15]">
          Signals into pipeline that<br />will drive your business
        </h1>
        <p class="text-[15px] text-slate-500 leading-relaxed max-w-[500px]">
          GTM Engineer. Clay, n8n, HubSpot and AI agents, content side that feeds them well.
        </p>
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a
            class="inline-flex items-center justify-center px-5 py-2.5 bg-[#1d6ff2] hover:bg-blue-600 text-white text-[13px] font-semibold rounded-lg shadow-sm transition-all"
            href="/resume/tibin-jacob-gtm-engineer.pdf"
            target="_blank"
            rel="noopener noreferrer"
          >
            Download Resume
          </a>
          <a
            class="inline-flex items-center justify-center px-5 py-2.5 bg-white border border-slate-300 hover:bg-slate-50 text-slate-800 text-[13px] font-medium rounded-lg shadow-sm transition-all"
            href="#contact"
          >
            Contact Now
          </a>
        </div>
      </div>

      <!-- Right side of hero: Visual container for user's screenshot/image -->
      <div class="lg:col-span-5 w-full flex items-center justify-center">
        <div class="w-full aspect-[4/3] rounded-2xl bg-[#080d19] border border-slate-900 shadow-xl overflow-hidden flex items-center justify-center relative group">
          <div class="flex flex-col items-center justify-center gap-2 p-6 text-center select-none">
            <span class="material-symbols-outlined text-[36px] text-slate-700 group-hover:text-cyan-500/80 transition-colors">schema</span>
            <span class="text-xs font-mono text-slate-400 font-medium">Hero Architecture Visual</span>
            <span class="text-[11px] font-mono text-slate-600">4:3 Aspect Ratio · Image Placement</span>
          </div>
        </div>
      </div>
    </section>

    <!-- TECH STACK & INTEGRATIONS RAIL -->
    <TechStackRail />

    <!-- WHO I WORK WITH (IDEAL PARTNERS) -->
    <section class="flex flex-col gap-6" aria-labelledby="partners-heading">
      <div class="flex flex-col gap-1">
        <span class="text-[11px] font-semibold text-cyan-600 tracking-wider uppercase font-mono">
          IDEAL PARTNERS
        </span>
        <h2 id="partners-heading" class="text-[28px] font-bold text-slate-900 tracking-tight">
          Who I work with
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="p-6 rounded-2xl border border-slate-200/90 bg-white hover:border-slate-300 hover:shadow-sm transition-all flex flex-col gap-3">
          <div class="w-10 h-10 rounded-xl bg-cyan-50 border border-cyan-100 flex items-center justify-center text-cyan-600">
            <span class="material-symbols-outlined text-[20px]">rocket_launch</span>
          </div>
          <h3 class="text-[16px] font-bold text-slate-900 pt-1">Startups finding ICP Fit</h3>
          <p class="text-[13px] text-slate-500 leading-relaxed">
            Looking to scale outbound and inbound automation without blowing up headcount.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-200/90 bg-white hover:border-slate-300 hover:shadow-sm transition-all flex flex-col gap-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-600">
            <span class="material-symbols-outlined text-[20px]">hub</span>
          </div>
          <h3 class="text-[16px] font-bold text-slate-900 pt-1">Enterprise with PMF Scalling</h3>
          <p class="text-[13px] text-slate-500 leading-relaxed">
            Tight CRM architecture, reliable waterfall enrichment, and clean routing rules.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-200/90 bg-white hover:border-slate-300 hover:shadow-sm transition-all flex flex-col gap-3">
          <div class="w-10 h-10 rounded-xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600">
            <span class="material-symbols-outlined text-[20px]">track_changes</span>
          </div>
          <h3 class="text-[16px] font-bold text-slate-900 pt-1">Founders and Revops Leaders</h3>
          <p class="text-[13px] text-slate-500 leading-relaxed">
            Leaders wanting high-intent signal capture that converts directly into real qualified pipeline.
          </p>
        </div>
      </div>
    </section>

    <!-- MY LIBRARY (PRODUCTION SYSTEMS) -->
    <WorkflowsCarousel client:visible items={workflowItems} />

    <!-- RECENT EXPERIENCE (CASE STUDIES) -->
    <section class="flex flex-col gap-6" aria-labelledby="experience-heading">
      <div class="flex flex-col gap-1">
        <span class="text-[11px] font-semibold text-cyan-600 tracking-wider uppercase font-mono">
          CASE STUDIES
        </span>
        <h2 id="experience-heading" class="text-[28px] font-bold text-slate-900 tracking-tight">
          Recent Experience
        </h2>
      </div>

      <div class="flex flex-col gap-4">
        {/* Featured Case Study: Mavlers */}
        <div class="w-full p-6 sm:p-7 rounded-2xl border border-slate-200/90 bg-white hover:border-slate-300 transition-all flex flex-col gap-3 group">
          <div class="flex items-center gap-2">
            <span class="bg-[#fef9c3] text-[#854d0e] font-semibold text-[11px] px-2 py-0.5 rounded">
              Mavlers
            </span>
            <span class="text-slate-400 text-xs">•</span>
            <span class="text-slate-500 text-[11px] font-mono">GTM Automation Lead • 2026</span>
          </div>
          <h3 class="text-[18px] font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
            <a href="/work/mavlers-partner-agency-signals">
              Finding partner agencies for white-label delivery with a multi-signal HubSpot motion
            </a>
          </h3>
          <p class="text-[13px] text-slate-500 leading-relaxed">
            Architected a synchronized multi-signal pipeline scanning tech stack indicators, job postings, and partner network expansions to identify high-fit agency opportunities automatically.
          </p>
          <div class="pt-2">
            <a
              href="/work/mavlers-partner-agency-signals"
              class="inline-flex items-center gap-1 text-[12px] font-semibold text-[#1d6ff2] hover:underline"
            >
              Read case study architecture →
            </a>
          </div>
        </div>

        {/* Split Case Studies: Paddleboat AI & Heurist AI */}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-6 rounded-2xl border border-slate-200/90 bg-white hover:border-slate-300 transition-all flex flex-col justify-between gap-4 group">
            <div class="flex flex-col gap-2.5">
              <div class="flex items-center justify-between">
                <span class="bg-cyan-50 text-cyan-700 font-semibold text-[11px] px-2 py-0.5 rounded border border-cyan-200">
                  Paddleboat AI
                </span>
                <a href="/work/paddleboat-sdr-scaling-signals" class="text-slate-400 group-hover:text-blue-600 transition-colors" aria-label="View Paddleboat AI case study">
                  <span class="material-symbols-outlined text-[16px]">north_east</span>
                </a>
              </div>
              <h3 class="text-[15px] font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
                <a href="/work/paddleboat-sdr-scaling-signals">
                  Flagging companies scaling their SDR org
                </a>
              </h3>
              <p class="text-[12px] text-slate-500 leading-relaxed">
                Automated intent detection analyzing LinkedIn Sales Nav alerts and job board APIs to alert reps within 2 hours of SDR manager job posts.
              </p>
            </div>
            <span class="text-[11px] font-mono text-slate-400 pt-2 border-t border-slate-100">
              Role: GTM Automation • 2022-2023
            </span>
          </div>

          <div class="p-6 rounded-2xl border border-slate-200/90 bg-white hover:border-slate-300 transition-all flex flex-col justify-between gap-4 group">
            <div class="flex flex-col gap-2.5">
              <div class="flex items-center justify-between">
                <span class="bg-emerald-50 text-emerald-700 font-semibold text-[11px] px-2 py-0.5 rounded border border-emerald-200">
                  Heurist AI
                </span>
                <a href="/work/heurist-autopilot-agents" class="text-slate-400 group-hover:text-blue-600 transition-colors" aria-label="View Heurist AI case study">
                  <span class="material-symbols-outlined text-[16px]">north_east</span>
                </a>
              </div>
              <h3 class="text-[15px] font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
                <a href="/work/heurist-autopilot-agents">
                  Autopilot content agents with a human approval gate
                </a>
              </h3>
              <p class="text-[12px] text-slate-500 leading-relaxed">
                Multi-agent system that synthesizes market themes, drafts targeted sales collateral, and routes to Slack for 1-click human editorial approval.
              </p>
            </div>
            <span class="text-[11px] font-mono text-slate-400 pt-2 border-t border-slate-100">
              Role: GTM Engineer • 2024-2025
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- MY STORIES (PRODUCTION SYSTEMS) -->
    <StoriesSection />

    <!-- START A CONVERSATION -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start pt-4" id="contact" aria-labelledby="contact-heading">
      <div class="lg:col-span-6 flex flex-col gap-5">
        <div class="flex flex-col gap-1">
          <span class="text-[11px] font-semibold text-cyan-600 tracking-wider uppercase font-mono">
            START A CONVERSATION
          </span>
          <h2 id="contact-heading" class="text-[28px] font-bold text-slate-900 tracking-tight leading-snug">
            Tell me what's leaking<br />in your pipeline.
          </h2>
        </div>

        <ContactForm client:visible />
      </div>

      <!-- Right side of contact: Visual container for user's pipeline schematic/diagram -->
      <div class="lg:col-span-6 w-full">
        <div class="w-full h-96 rounded-2xl bg-[#080d19] border border-slate-900 shadow-xl overflow-hidden flex items-center justify-center relative group">
          <div class="flex flex-col items-center justify-center gap-2 p-6 text-center select-none">
            <span class="material-symbols-outlined text-[36px] text-slate-700 group-hover:text-cyan-500/80 transition-colors">hub</span>
            <span class="text-xs font-mono text-slate-400 font-medium">Pipeline Flow Diagram</span>
            <span class="text-[11px] font-mono text-slate-600">Schematic & Routing Graphic Placement</span>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
