---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroFromUIUX from '../components/HeroFromUIUX.astro';
import WhoIWorkWithSection from '../components/WhoIWorkWithSection.astro';
import DarkToolRail from '../components/DarkToolRail.astro';
import MyLibrarySection from '../components/MyLibrarySection.astro';
import RecognitionSection from '../components/RecognitionSection.astro';
import RecentExperiencesSection from '../components/RecentExperiencesSection.astro';
import WalkthroughVideosSection from '../components/WalkthroughVideosSection.astro';
import QuestionsSection from '../components/QuestionsSection.astro';
import DirectPipelineSection from '../components/DirectPipelineSection.astro';
import QuickContactRow from '../components/QuickContactRow.astro';

const title = "Tibin Jacob — AI Growth Expert for B2B Companies | GTM Engineer";
const description = "I turn buying signals, AI search and paid demand into pipeline your sales team can work. Clay, n8n and HubSpot for GTM automation; ChatGPT, Perplexity and Google AI Overviews for AI search; Meta and Google Ads measured to SQLs.";
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl="https://tibinjacob.com"
  preloadImage="/images/hero-bg.webp"
  transparentHeader={true}
>
  <!-- 1. HERO SECTION (CONTAINER RECTANGLE WITH PHOTO + FLOATING CONTENT) -->
  <HeroFromUIUX
    slot="hero"
    photoUrl="/images/hero-bg.webp"
  />

  <div class="flex flex-col gap-16 sm:gap-24 py-4 bg-[#000000]">
    <!-- 2. PARTNERSHIP TYPES / WHO I WORK WITH -->
    <WhoIWorkWithSection />

    <!-- 3. CORE INTEGRATIONS MARQUEE RAIL -->
    <DarkToolRail />

    <!-- 4. MODERN AI GROWTH WORKFLOWS / MY LIBRARY -->
    <MyLibrarySection />

    <!-- 5. RECOGNITION & AWARDS -->
    <RecognitionSection />

    <!-- 6. EVIDENCE & OUTCOMES / RECENT EXPERIENCES -->
    <RecentExperiencesSection />

    <!-- 7. VIDEO DEMOS / WALKTHROUGHS VIDEOS -->
    <WalkthroughVideosSection />

    <!-- 8. CLEAR ANSWERS / QUESTIONS ACCORDION -->
    <QuestionsSection />

    <!-- 9. BIG IMPACTFUL CALLOUT BANNER (SUPER BLACK NO GRADIENTS) -->
    <div class="py-12 sm:py-16 flex flex-col items-center text-center gap-5 border-t border-zinc-900 bg-[#000000]">
      <span class="px-4 py-1.5 rounded-full bg-[#000000] border border-zinc-800 text-zinc-400 text-[11px] font-mono tracking-widest uppercase">
        AVAILABLE FOR NEW PROJECTS & ROLES
      </span>
      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight max-w-4xl leading-tight">
        Let’s build something <span class="text-[#b4f04d] underline decoration-[#b4f04d] underline-offset-8">impactful.</span>
      </h2>
      <p class="text-zinc-400 text-[15px] sm:text-[17px] max-w-xl leading-relaxed font-light">
        Tell me what’s leaking in your pipeline or let’s talk about a zero-to-one growth motion.
      </p>
    </div>

    <!-- 10. DIRECT PIPELINE (LEAKING PIPELINE FORM + BOOKING STEPS) -->
    <DirectPipelineSection />

    <!-- 11. QUICK CONTACT ROW (EMAIL, LINKEDIN, WHATSAPP) -->
    <QuickContactRow />
  </div>
</BaseLayout>
