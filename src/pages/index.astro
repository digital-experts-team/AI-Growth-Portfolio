---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroFromUIUX from '../components/HeroFromUIUX.astro';
import WhoIWorkWithSection from '../components/WhoIWorkWithSection.astro';
import MyLibrarySection from '../components/MyLibrarySection.astro';
import DarkToolRail from '../components/DarkToolRail.astro';
import RecentExperiencesSection from '../components/RecentExperiencesSection.astro';
import WalkthroughVideosSection from '../components/WalkthroughVideosSection.astro';
import QuestionsSection from '../components/QuestionsSection.astro';
import DirectPipelineSection from '../components/DirectPipelineSection.astro';
import QuickContactRow from '../components/QuickContactRow.astro';

const title = "GTM Engineer & AI Search (AEO/GEO) | Tibin Jacob";
const description = "GTM Engineer in Bengaluru building signal-based outbound, waterfall enrichment, and HubSpot lead routing engines for high-growth B2B teams.";
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl="https://tibinjacob.com"
  preloadImage="/images/hero-bg.webp"
  transparentHeader={true}
>
  <!-- 1. FULL WIDTH HERO SECTION (WITH TRANSPARENT HEADER OVERLAP) -->
  <HeroFromUIUX
    slot="hero"
    photoUrl="/images/hero-bg.webp"
  />

  <!-- 2. WHO I WORK WITH SECTION (DIRECTLY BELOW HERO) -->
  <WhoIWorkWithSection />

  <div class="flex flex-col bg-white text-zinc-900">
    <!-- 3. MY LIBRARY / WORKFLOW LIBRARY -->
    <MyLibrarySection />

    <!-- 4. MY TOOL STACK -->
    <DarkToolRail />

    <!-- 5. RECENT EXPERIENCE / CASE STUDIES -->
    <RecentExperiencesSection />

    <!-- 6. WALKTHROUGH REELS / VIDEOS -->
    <WalkthroughVideosSection />

    <!-- 7. CLEAR ANSWERS / QUESTIONS ACCORDION -->
    <QuestionsSection />

    <!-- 8. CALLOUT BANNER -->
    <div class="py-16 sm:py-20 lg:py-24 flex flex-col items-center text-center gap-5 border-b border-zinc-200 bg-white px-4">
      <span class="px-4 py-1.5 rounded-full bg-zinc-100 border border-zinc-200 text-zinc-600 text-[11px] font-mono tracking-widest uppercase">
        AVAILABLE FOR NEW PROJECTS & ROLES
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-[44px] font-extrabold text-zinc-950 tracking-tight max-w-4xl leading-tight">
        Let’s build something <span class="heading-highlight">impactful.</span>
      </h2>
      <p class="text-zinc-600 text-[15px] sm:text-[17px] max-w-xl leading-relaxed font-light">
        Tell me what’s leaking in your pipeline or let’s talk about a zero-to-one growth motion.
      </p>
    </div>

    <!-- 9. DIRECT PIPELINE -->
    <DirectPipelineSection />

    <!-- 10. QUICK CONTACT ROW -->
    <QuickContactRow />
  </div>
</BaseLayout>
