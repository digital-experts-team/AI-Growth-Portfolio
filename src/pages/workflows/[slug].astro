---
import { isLive } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const workflows = await getCollection('workflows', isLive);
  return workflows.map((entry) => ({
    params: { slug: entry.data.slug || entry.id },
    props: { entry },
  }));
}

export interface Props {
  entry: CollectionEntry<'workflows'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const slug = entry.data.slug || entry.id;
const title = `${entry.data.title} Workflow (${entry.data.tools.join(' + ')}) | Tibin Jacob`;
const description = entry.data.description;
---

<BaseLayout
  title={title}
  description={description}
  schemaType="HowTo"
  publishedDate={entry.data.publishedDate}
  updatedDate={entry.data.updatedDate}
  faq={entry.data.faq}
  howToSteps={entry.data.steps}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Workflows', url: '/workflows' },
    { name: entry.data.title, url: `/workflows/${slug}` },
  ]}
>
  <article class="py-6 max-w-4xl mx-auto">
    <!-- Breadcrumbs -->
    <nav class="text-xs font-mono text-slate-400 mb-6 flex items-center gap-2" aria-label="Breadcrumb">
      <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
      <span>/</span>
      <a href="/workflows" class="hover:text-slate-900 transition-colors">Workflows</a>
      <span>/</span>
      <span class="text-slate-600 truncate max-w-xs">{entry.data.title}</span>
    </nav>

    <!-- Header -->
    <header class="mb-10 pb-8 border-b border-slate-200">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="text-xs font-mono text-cyan-700 bg-cyan-50 border border-cyan-200 px-2.5 py-1 rounded">
          {entry.data.cluster}
        </span>
        <span class="text-xs font-mono text-slate-500">
          Target Keyword: <strong class="text-slate-900">{entry.data.targetKeyword || 'GTM Automation'}</strong>
        </span>
        {entry.data.updatedDate && (
          <span class="text-xs font-mono text-slate-400">
            · Updated: {entry.data.updatedDate.toISOString().split('T')[0]}
          </span>
        )}
      </div>

      <div class="text-xs font-mono uppercase tracking-wider text-cyan-600 font-semibold mb-2">
        {entry.data.title}
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-slate-900 mb-4 leading-tight">
        {entry.data.title} Workflow ({entry.data.tools.join(' + ')})
      </h1>

      <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl mb-6">
        {entry.data.description}
      </p>

      <!-- Technical Stack Strip -->
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-mono text-slate-400 mr-2">Orchestration:</span>
        {entry.data.tools.map((t) => (
          <span class="text-xs font-mono bg-slate-100 border border-slate-200 text-slate-700 px-2.5 py-1 rounded">
            {t}
          </span>
        ))}
      </div>
    </header>

    <!-- Content -->
    <div class="prose max-w-none space-y-6 text-slate-700 leading-relaxed text-sm sm:text-base">
      <Content />
    </div>

    <!-- Related Links & CTA -->
    <footer class="mt-12 pt-8 border-t border-slate-200 flex flex-wrap justify-between items-center gap-4">
      <a href="/workflows" class="text-xs font-mono text-slate-500 hover:text-slate-900 transition-colors">
        ← Back to All Workflows
      </a>

      <a href="/hire" class="cta-button text-xs px-4 py-2 rounded-lg">
        Deploy this in your stack
      </a>
    </footer>
  </article>
</BaseLayout>
