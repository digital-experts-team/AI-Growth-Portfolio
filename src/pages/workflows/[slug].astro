---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const workflows = await getCollection('workflows');
  return workflows.map((entry) => ({
    params: { slug: entry.data.slug || entry.id },
    props: { entry },
  }));
}

export interface Props {
  entry: CollectionEntry<'workflows'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const slug = entry.data.slug || entry.id;
const title = entry.data.metaTitle && entry.data.metaTitle.length <= 60
  ? entry.data.metaTitle
  : `${entry.data.title} Workflow`.slice(0, 50) + ' | Tibin';
const description = entry.data.description;
const canonicalUrl = `https://tibinjacob.com/workflows/${slug}`;
const formattedDate = entry.data.updatedDate
  ? entry.data.updatedDate.toISOString().split('T')[0]
  : entry.data.publishedDate
  ? entry.data.publishedDate.toISOString().split('T')[0]
  : '2026-09-25';
const toolsListText = entry.data.tools.join(' · ');
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schemaType="HowTo"
  publishedDate={entry.data.publishedDate}
  updatedDate={entry.data.updatedDate}
  faq={entry.data.faq}
  howToSteps={entry.data.steps}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Workflows', url: '/workflows' },
    { name: entry.data.title, url: `/workflows/${slug}` },
  ]}
>
  <article class="py-6 max-w-4xl mx-auto">
    <!-- 1. Breadcrumb -->
    <nav class="text-xs font-mono text-slate-400 mb-6 flex items-center gap-2" aria-label="Breadcrumb">
      <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
      <span>/</span>
      <a href="/workflows" class="hover:text-slate-900 transition-colors">GTM Workflows</a>
      <span>/</span>
      <span class="text-slate-600 truncate max-w-xs">{entry.data.title}</span>
    </nav>

    <!-- Header -->
    <header class="mb-8 pb-6 border-b border-slate-200">
      <!-- 2. Cluster label pill -->
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs font-mono text-cyan-700 bg-cyan-50 border border-cyan-200 px-2.5 py-1 rounded font-semibold">
          {entry.data.cluster}
        </span>
      </div>

      <!-- 3. H1 — workflow title -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 mb-4 leading-tight">
        {entry.data.title}
      </h1>

      <!-- 4. Updated date and tools list (plain text) -->
      <div class="text-xs font-mono text-slate-500 mb-6">
        Updated {formattedDate} · Stack: <strong class="text-slate-800">{toolsListText}</strong>
      </div>

      <!-- 5. Short answer block (lime left border callout) -->
      <div class="p-5 rounded-xl border-l-4 border-[#d2f39c] my-6">
        <div class="text-[11px] font-mono text-slate-500 font-bold uppercase tracking-wider mb-1">
          Workflow Architecture Summary
        </div>
        <p class="text-base sm:text-lg text-slate-900 leading-relaxed font-medium">
          {entry.data.description}
        </p>
      </div>
    </header>

    <!-- 6-10. Main Article Body -->
    <div class="prose max-w-none space-y-6 text-slate-700 leading-relaxed text-sm sm:text-base">
      <Content />
    </div>

    <!-- 11. FAQ section (visible <details><summary> accordion) -->
    {entry.data.faq && entry.data.faq.length > 0 && (
      <section class="mt-12 pt-8 border-t border-slate-200">
        <h2 class="text-xl font-bold text-slate-900 mb-6">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {entry.data.faq.map((item: { q: string; a: string }) => (
            <details class="group rounded-xl border border-slate-200 bg-white p-4 [&_summary::-webkit-details-marker]:none">
              <summary class="flex cursor-pointer items-center justify-between gap-1.5 text-slate-900 font-semibold text-sm sm:text-base">
                <span>{item.q}</span>
                <span class="shrink-0 rounded-full bg-slate-100 p-1.5 text-slate-900 sm:p-2 transition group-open:-rotate-180">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <p class="mt-4 leading-relaxed text-xs sm:text-sm text-slate-600 border-t border-slate-100 pt-3">
                {item.a}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Navigation Footer -->
    <footer class="mt-12 pt-8 border-t border-slate-200 flex flex-wrap justify-between items-center gap-4">
      <a href="/workflows" class="text-xs font-mono text-slate-500 hover:text-slate-900 transition-colors">
        ← Back to All Workflows
      </a>

      <a href="/hire" class="cta-button text-xs px-4 py-2 rounded-lg font-bold">
        Deploy this in your stack
      </a>
    </footer>
  </article>
</BaseLayout>
