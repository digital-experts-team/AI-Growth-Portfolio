---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkflowDiagram from '../../components/WorkflowDiagram.astro';
import Steps from '../../components/Steps.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const workflows = await getCollection('workflows');
  return workflows.map((entry) => ({
    params: { slug: entry.data.slug || entry.id },
    props: { entry },
  }));
}

export interface Props {
  entry: CollectionEntry<'workflows'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const slug = entry.data.slug || entry.id;
const title = entry.data.metaTitle && entry.data.metaTitle.length <= 60
  ? entry.data.metaTitle
  : `${entry.data.title} Workflow`.slice(0, 50) + ' | Tibin';
const description = entry.data.description;
const canonicalUrl = `https://tibinjacob.com/workflows/${slug}`;
const formattedDate = entry.data.updatedDate
  ? entry.data.updatedDate.toISOString().split('T')[0]
  : entry.data.publishedDate
  ? entry.data.publishedDate.toISOString().split('T')[0]
  : '2026-09-25';
const toolsListText = entry.data.tools.join(' · ');
const outputLabel = entry.data.steps && entry.data.steps.length > 0
  ? entry.data.steps[entry.data.steps.length - 1].title
  : 'Workflow Output';
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schemaType="HowTo"
  publishedDate={entry.data.publishedDate}
  updatedDate={entry.data.updatedDate}
  faq={entry.data.faq}
  howToSteps={entry.data.steps}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Workflows', url: '/workflows' },
    { name: entry.data.title, url: `/workflows/${slug}` },
  ]}
>
  <article class="py-8 max-w-4xl mx-auto">
    <!-- 1. Breadcrumb -->
    <nav class="text-xs font-mono text-zinc-500 mb-8 flex items-center gap-2" aria-label="Breadcrumb">
      <a href="/" class="hover:text-green-600 transition-colors font-medium">Home</a>
      <span>/</span>
      <a href="/workflows" class="hover:text-green-600 transition-colors font-medium">Workflows</a>
      <span>/</span>
      <span class="text-zinc-800 font-semibold truncate max-w-xs">{entry.data.title}</span>
    </nav>

    <!-- Header -->
    <header class="mb-10 pb-8 border-b border-zinc-200">
      <div class="flex flex-wrap items-center gap-3 mb-4 text-xs font-mono">
        <span class="text-green-600 font-bold uppercase tracking-wider">
          {entry.data.cluster}
        </span>
        <span class="text-zinc-300">|</span>
        <span class="text-zinc-500">Stack: <strong class="text-zinc-800 font-bold">{toolsListText}</strong></span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-zinc-950 mb-6 leading-tight font-display">
        {entry.data.title}
      </h1>

      <div class="text-xs font-mono text-zinc-500 mb-6">
        Last updated: {formattedDate}
      </div>

      <!-- Short answer block -->
      <div class="p-6 rounded-r-2xl border-l-4 border-[#d2f39c] bg-[#f8fafc] border-y border-r border-zinc-200 my-6 shadow-sm">
        <div class="text-xs font-mono text-zinc-500 font-bold uppercase tracking-wider mb-2">
          Architecture Summary
        </div>
        <p class="text-base sm:text-lg text-zinc-800 leading-relaxed font-normal">
          {entry.data.description}
        </p>
      </div>
    </header>

    <!-- Visual Architecture Diagram (rendered from trigger/tools/steps frontmatter) -->
    {entry.data.steps && entry.data.steps.length > 0 && (
      <WorkflowDiagram
        trigger={entry.data.trigger}
        tools={entry.data.tools}
        steps={entry.data.steps}
        output={outputLabel}
      />
    )}

    <!-- Step-by-step visual breakdown -->
    {entry.data.steps && entry.data.steps.length > 0 && (
      <Steps steps={entry.data.steps} title="How It Works, Step by Step" />
    )}

    <!-- Main Article Body -->
    <div class="prose max-w-none space-y-6 text-zinc-800 leading-relaxed font-normal">
      <Content />
    </div>

    <!-- FAQ section -->
    {entry.data.faq && entry.data.faq.length > 0 && (
      <section class="mt-16 pt-10 border-t border-zinc-200">
        <h2 class="text-2xl font-bold text-zinc-950 mb-6 tracking-tight font-display">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {entry.data.faq.map((item: { q: string; a: string }) => (
            <details class="group rounded-2xl border border-zinc-200 bg-white p-5 [&_summary::-webkit-details-marker]:none transition-all hover:border-zinc-300">
              <summary class="flex cursor-pointer items-center justify-between gap-2 text-zinc-900 font-bold text-base sm:text-lg">
                <span>{item.q}</span>
                <span class="shrink-0 rounded-full bg-zinc-100 p-1.5 text-zinc-600 transition group-open:-rotate-180 group-open:bg-green-600 group-open:text-white">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <p class="mt-4 leading-relaxed text-sm sm:text-base text-zinc-600 font-normal border-t border-zinc-100 pt-4">
                {item.a}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Navigation Footer -->
    <footer class="mt-16 pt-10 border-t border-zinc-200 flex flex-wrap justify-between items-center gap-6">
      <a href="/workflows" class="text-xs font-mono font-bold text-zinc-500 hover:text-green-600 transition-colors flex items-center gap-1.5">
        ← Back to All Workflows
      </a>

      <a
        href="/hire"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-xs font-bold text-black bg-[#d2f39c] hover:bg-[#c2e887] transition-all"
      >
        <span>Deploy this in your stack</span>
        <svg class="w-4 h-4 text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>
    </footer>
  </article>
</BaseLayout>
