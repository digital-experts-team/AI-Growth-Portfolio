---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allWorkflows = await getCollection('workflows');

// Helper map to quickly find workflow item by slug/id
const workflowMap = new Map();
allWorkflows.forEach(wf => {
  const s = wf.data.slug || wf.id;
  workflowMap.set(s, wf);
});

const gtmPillars = [
  {
    id: 'prospecting',
    title: 'Prospecting',
    description: 'signals + enrichment — finding and building the account/contact',
    slugs: ['clay-waterfall-enrichment', 'waterfall-enrichment', 'hiring-funding-signal-watcher', 'website-signal-to-outbound-engine'],
  },
  {
    id: 'outreach',
    title: 'Outreach',
    description: 'personalization, sequencing, deliverability',
    slugs: ['llm-personalization-guardrails'],
  },
  {
    id: 'conversion',
    title: 'Conversion',
    description: 'routing + qualification — getting the reply to the right rep, fast',
    slugs: ['hubspot-lead-routing', 'crm-dedupe-write-back', 'reply-triage-agent'],
  },
];

const aeoPillars = [
  {
    id: 'visibility',
    title: 'Visibility',
    description: 'schema, structured data, LLM citation/share-of-answer tracking',
    slugs: ['aeo-citation-schema-indexing'],
  },
  {
    id: 'content',
    title: 'Content',
    description: 'AI-assisted content ops, entity/topic coverage',
    slugs: ['tofu-content-agent'],
  },
  {
    id: 'distribution',
    title: 'Distribution',
    description: 'syndication, repurposing, multi-surface publishing',
    slugs: ['multi-surface-content-syndication'],
  },
];

const title = "AI Growth systems I ship | Tibin Jacob";
const description = "Systems that turn signals into revenue";
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Workflows', url: '/workflows' },
  ]}
>
  <div class="py-8 max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-10 pb-8 border-b border-zinc-200">
      <div class="text-xs font-mono uppercase tracking-widest text-zinc-500 font-bold mb-3">
        SYSTEM SCHEMATICS / ARCHITECTURES
      </div>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-zinc-950 mb-4 leading-tight font-display text-wrap: balance">
        AI Growth systems I <span class="heading-highlight">ship.</span>
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 leading-relaxed max-w-2xl font-normal">
        Systems that turn signals into revenue
      </p>
    </div>

    <!-- Symmetrical Filter Bar: All · GTM (Outbound) · AEO (AI Search) -->
    <div class="mb-12 flex flex-wrap items-center gap-2 bg-zinc-50 border border-zinc-200/80 p-1.5 rounded-xl w-fit">
      <button data-filter="all" class="filter-btn px-5 py-2 text-xs font-bold rounded-lg bg-[#d2f39c] text-[#0f1115] shadow-xs transition-all whitespace-nowrap cursor-pointer">
        All
      </button>
      <button data-filter="gtm" class="filter-btn px-5 py-2 text-xs font-bold rounded-lg text-zinc-600 hover:text-zinc-950 hover:bg-zinc-100 transition-all whitespace-nowrap cursor-pointer">
        GTM (Outbound)
      </button>
      <button data-filter="aeo" class="filter-btn px-5 py-2 text-xs font-bold rounded-lg text-zinc-600 hover:text-zinc-950 hover:bg-zinc-100 transition-all whitespace-nowrap cursor-pointer">
        AEO (AI Search)
      </button>
    </div>

    <!-- MAIN SYMMETRICAL WORKFLOW SECTIONS (3 + 3) -->
    <div class="flex flex-col gap-16 mb-20">

      <!-- PILLAR 1: GTM (OUTBOUND) -->
      <section id="section-gtm" class="flex flex-col gap-8">
        <div class="pb-4 border-b border-zinc-200">
          <div class="flex items-center gap-2 text-xs font-mono font-bold text-zinc-500 uppercase tracking-widest mb-1">
            <span class="w-2 h-2 rounded-full bg-[#d2f39c]"></span>
            <span>01 — OUTBOUND MOTION</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 tracking-tight font-display">
            GTM (Outbound)
          </h2>
        </div>

        <div class="flex flex-col gap-10">
          {gtmPillars.map((pillar) => {
            const pillarWorkflows = pillar.slugs.map(s => workflowMap.get(s)).filter(Boolean);
            if (pillarWorkflows.length === 0) return null;

            return (
              <div class="flex flex-col gap-4">
                <!-- Sub-Pillar Title & Description -->
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pb-2 border-b border-zinc-100">
                  <h3 class="text-lg sm:text-xl font-bold text-zinc-900 font-display">
                    {pillar.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-zinc-500 font-mono">
                    {pillar.description}
                  </p>
                </div>

                <!-- Cards Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                  {pillarWorkflows.map((wf) => {
                    const slug = wf.data.slug || wf.id;
                    const isConstrained = slug.includes('enrichment') || slug.includes('watcher');
                    
                    let statusLabel = 'Live';
                    if (wf.data.status === 'draft') {
                      statusLabel = 'Build note';
                    } else if (isConstrained) {
                      statusLabel = 'Constrained';
                    }

                    return (
                      <a
                        href={`/workflows/${slug}`}
                        class="bento-card p-6 sm:p-7 rounded-[20px] flex flex-col justify-between gap-6 group hover:border-[#d2f39c]/40 transition-all duration-300"
                      >
                        <div>
                          <div class="flex items-center justify-between text-xs font-mono mb-3">
                            <span class="text-[#d2f39c] font-bold uppercase tracking-wider">Outbound</span>
                            <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider ${
                              statusLabel === 'Build note'
                                ? 'bg-zinc-900 text-zinc-400 border border-zinc-800'
                                : statusLabel === 'Constrained'
                                ? 'bg-amber-950/80 text-amber-400 border border-amber-800/60'
                                : 'bg-green-950/80 text-green-400 border border-green-800/60'
                            }`}>
                              {statusLabel}
                            </span>
                          </div>
                          <h4 class="text-lg sm:text-xl font-bold text-white group-hover:text-[#d2f39c] transition-colors mb-2 leading-snug">
                            {wf.data.title}
                          </h4>
                          <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed font-normal mb-3 line-clamp-3">
                            {wf.data.description}
                          </p>
                        </div>

                        <div class="pt-4 border-t border-zinc-800/80 flex items-center justify-between gap-4 flex-wrap">
                          <div class="flex flex-wrap gap-1.5">
                            {wf.data.tools.map((tool: string) => (
                              <span class="px-2.5 py-1 rounded-md bg-zinc-900 text-zinc-300 border border-zinc-800 font-mono text-[11px] font-medium">
                                {tool}
                              </span>
                            ))}
                          </div>
                          <span class="text-[#d2f39c] font-bold text-xs font-mono uppercase tracking-wider group-hover:translate-x-1 transition-transform flex items-center gap-1 shrink-0">
                            View system →
                          </span>
                        </div>
                      </a>
                    );
                  })}
                </div>
              </div>
            );
          })}
        </div>
      </section>

      <!-- PILLAR 2: AEO (AI SEARCH) -->
      <section id="section-aeo" class="flex flex-col gap-8">
        <div class="pb-4 border-b border-zinc-200">
          <div class="flex items-center gap-2 text-xs font-mono font-bold text-zinc-500 uppercase tracking-widest mb-1">
            <span class="w-2 h-2 rounded-full bg-[#d2f39c]"></span>
            <span>02 — INBOUND & AI CITATIONS</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 tracking-tight font-display">
            AEO (AI Search)
          </h2>
        </div>

        <div class="flex flex-col gap-10">
          {aeoPillars.map((pillar) => {
            const pillarWorkflows = pillar.slugs.map(s => workflowMap.get(s)).filter(Boolean);
            if (pillarWorkflows.length === 0) return null;

            return (
              <div class="flex flex-col gap-4">
                <!-- Sub-Pillar Title & Description -->
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pb-2 border-b border-zinc-100">
                  <h3 class="text-lg sm:text-xl font-bold text-zinc-900 font-display">
                    {pillar.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-zinc-500 font-mono">
                    {pillar.description}
                  </p>
                </div>

                <!-- Cards Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                  {pillarWorkflows.map((wf) => {
                    const slug = wf.data.slug || wf.id;
                    let statusLabel = wf.data.status === 'draft' ? 'Build note' : 'Live';

                    return (
                      <a
                        href={`/workflows/${slug}`}
                        class="bento-card p-6 sm:p-7 rounded-[20px] flex flex-col justify-between gap-6 group hover:border-[#d2f39c]/40 transition-all duration-300"
                      >
                        <div>
                          <div class="flex items-center justify-between text-xs font-mono mb-3">
                            <span class="text-[#d2f39c] font-bold uppercase tracking-wider">Inbound</span>
                            <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider ${
                              statusLabel === 'Build note'
                                ? 'bg-zinc-900 text-zinc-400 border border-zinc-800'
                                : 'bg-green-950/80 text-green-400 border border-green-800/60'
                            }`}>
                              {statusLabel}
                            </span>
                          </div>
                          <h4 class="text-lg sm:text-xl font-bold text-white group-hover:text-[#d2f39c] transition-colors mb-2 leading-snug">
                            {wf.data.title}
                          </h4>
                          <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed font-normal mb-3 line-clamp-3">
                            {wf.data.description}
                          </p>
                        </div>

                        <div class="pt-4 border-t border-zinc-800/80 flex items-center justify-between gap-4 flex-wrap">
                          <div class="flex flex-wrap gap-1.5">
                            {wf.data.tools.map((tool: string) => (
                              <span class="px-2.5 py-1 rounded-md bg-zinc-900 text-zinc-300 border border-zinc-800 font-mono text-[11px] font-medium">
                                {tool}
                              </span>
                            ))}
                          </div>
                          <span class="text-[#d2f39c] font-bold text-xs font-mono uppercase tracking-wider group-hover:translate-x-1 transition-transform flex items-center gap-1 shrink-0">
                            View system →
                          </span>
                        </div>
                      </a>
                    );
                  })}
                </div>
              </div>
            );
          })}
        </div>
      </section>

    </div>
  </div>

  <script>
    const buttons = document.querySelectorAll('.filter-btn');
    const gtmSection = document.getElementById('section-gtm');
    const aeoSection = document.getElementById('section-aeo');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update active filter button styling
        buttons.forEach(b => {
          b.classList.remove('bg-[#d2f39c]', 'text-[#0f1115]', 'shadow-xs');
          b.classList.add('text-zinc-600', 'hover:text-zinc-950', 'hover:bg-zinc-100');
        });
        btn.classList.add('bg-[#d2f39c]', 'text-[#0f1115]', 'shadow-xs');
        btn.classList.remove('text-zinc-600', 'hover:text-zinc-950', 'hover:bg-zinc-100');

        // Filter main symmetrical sections
        if (filter === 'all') {
          if (gtmSection) gtmSection.style.display = 'flex';
          if (aeoSection) aeoSection.style.display = 'flex';
        } else if (filter === 'gtm') {
          if (gtmSection) gtmSection.style.display = 'flex';
          if (aeoSection) aeoSection.style.display = 'none';
        } else if (filter === 'aeo') {
          if (gtmSection) gtmSection.style.display = 'none';
          if (aeoSection) aeoSection.style.display = 'flex';
        }
      });
    });
  </script>
</BaseLayout>
