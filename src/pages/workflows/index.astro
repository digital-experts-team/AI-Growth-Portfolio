---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allWorkflows = await getCollection('workflows');
const liveWorkflows = allWorkflows.filter((w) => w.data.status === 'live');
const draftWorkflows = allWorkflows.filter((w) => w.data.status === 'draft');

const title = "GTM Automation Workflows: Clay, n8n & HubSpot | Tibin Jacob";
const description = "Open-source and production-tested GTM workflows: waterfall enrichment, anonymous visitor identification, HubSpot lead routing, and AI reply triage.";
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Workflows', url: '/workflows' },
  ]}
>
  <div class="py-8 max-w-[1200px] mx-auto">
    <!-- Header -->
    <div class="mb-12 pb-8 border-b border-zinc-200">
      <div class="text-xs font-mono uppercase tracking-widest text-zinc-500 font-bold mb-3">
        MY LIBRARY / AUTOMATION BLUEPRINTS
      </div>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-zinc-950 mb-4 leading-tight font-display">
        GTM Automation Workflows: <span class="heading-highlight">Clay, n8n & HubSpot.</span>
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 leading-relaxed max-w-2xl font-normal">
        Deterministic revenue automations engineered with Clay, n8n, and HubSpot. Every blueprint features verified triggers, cascading logic, and circuit-breaker failure handling.
      </p>
    </div>

    <!-- Live Production Blueprints -->
    <div class="mb-16">
      <div class="flex items-center justify-between gap-4 mb-8 pb-4 border-b border-zinc-200">
        <div class="flex items-center gap-3">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
          <h2 class="text-xl sm:text-2xl font-bold text-zinc-950 tracking-tight font-display">Production Blueprints</h2>
          <span class="text-xs font-mono font-semibold px-2.5 py-0.5 rounded-full bg-zinc-100 text-zinc-600 border border-zinc-200">
            {liveWorkflows.length}
          </span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {liveWorkflows.map((wf) => (
          <a
            href={`/workflows/${wf.data.slug || wf.id}`}
            class="bento-card p-6 sm:p-8 rounded-[20px] flex flex-col justify-between gap-6 group hover:border-[#d2f39c]/40 transition-all"
          >
            <div>
              <div class="flex items-center justify-between text-xs font-mono mb-3">
                <span class="text-[#d2f39c] font-bold uppercase tracking-wider">{wf.data.cluster}</span>
                <span class="text-zinc-400 font-mono text-xs font-medium">Production Live</span>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold text-white group-hover:text-[#d2f39c] transition-colors mb-3 leading-snug">
                {wf.data.title}
              </h3>
              <p class="text-sm sm:text-[15px] text-zinc-300 leading-relaxed font-normal mb-4 line-clamp-3">
                {wf.data.description}
              </p>
            </div>

            <div class="pt-4 border-t border-zinc-800/80 flex items-center justify-between gap-4 flex-wrap">
              <div class="flex flex-wrap gap-1.5">
                {wf.data.tools.map((tool) => (
                  <span class="px-2.5 py-1 rounded-md bg-zinc-900 text-zinc-300 border border-zinc-800 font-mono text-xs font-medium">
                    {tool}
                  </span>
                ))}
              </div>
              <span class="text-[#d2f39c] font-bold text-xs font-mono uppercase tracking-wider group-hover:translate-x-1 transition-transform flex items-center gap-1 shrink-0">
                View Blueprint →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Draft / Lab Blueprints -->
    {draftWorkflows.length > 0 && (
      <div>
        <div class="flex items-center justify-between gap-4 mb-8 pb-4 border-b border-zinc-200">
          <div class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
            <h2 class="text-xl sm:text-2xl font-bold text-zinc-950 tracking-tight font-display">Reference Schematics</h2>
            <span class="text-xs font-mono font-semibold px-2.5 py-0.5 rounded-full bg-zinc-100 text-zinc-600 border border-zinc-200">
              {draftWorkflows.length}
            </span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {draftWorkflows.map((wf) => (
            <a
              href={`/workflows/${wf.data.slug || wf.id}`}
              class="bento-card p-6 sm:p-8 rounded-[20px] flex flex-col justify-between gap-6 group hover:border-amber-400/40 transition-all"
            >
              <div>
                <div class="flex items-center justify-between text-xs font-mono mb-3">
                  <span class="text-amber-400 font-bold uppercase tracking-wider">{wf.data.cluster}</span>
                  <span class="text-zinc-400 font-mono text-xs font-medium">Reference Design</span>
                </div>
                <h3 class="text-xl font-bold text-white group-hover:text-amber-300 transition-colors mb-3 leading-snug">
                  {wf.data.title}
                </h3>
                <p class="text-sm sm:text-[15px] text-zinc-300 leading-relaxed font-normal mb-4 line-clamp-3">
                  {wf.data.description}
                </p>
              </div>

              <div class="pt-4 border-t border-zinc-800/80 flex items-center justify-between gap-4 flex-wrap">
                <div class="flex flex-wrap gap-1.5">
                  {wf.data.tools.map((tool) => (
                    <span class="px-2.5 py-1 rounded-md bg-zinc-900 text-zinc-300 border border-zinc-800 font-mono text-xs font-medium">
                      {tool}
                    </span>
                  ))}
                </div>
                <span class="text-amber-400 font-bold text-xs font-mono uppercase tracking-wider group-hover:translate-x-1 transition-transform flex items-center gap-1 shrink-0">
                  View Blueprint →
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
