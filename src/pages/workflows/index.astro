---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allWorkflows = await getCollection('workflows');
const liveWorkflows = allWorkflows.filter((w) => w.data.status === 'live');
const draftWorkflows = allWorkflows.filter((w) => w.data.status === 'draft');

const title = "GTM Automation Workflows: Clay, n8n & HubSpot | Tibin Jacob";
const description = "Open-source and production-tested GTM workflows: waterfall enrichment, anonymous visitor identification, HubSpot lead routing, and AI reply triage.";
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Workflows', url: '/workflows' },
  ]}
>
  <div class="py-6 max-w-5xl mx-auto">
    <div class="mb-10">
      <div class="text-[11px] font-mono uppercase tracking-wider text-cyan-600 font-semibold mb-2">
        My Library
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-slate-900 mb-4">
        GTM Automation Workflows: Clay, n8n & HubSpot
      </h1>
      <p class="text-base sm:text-lg text-slate-500 leading-relaxed max-w-2xl">
        Deterministic revenue automations engineered with Clay, n8n, and HubSpot. Each blueprint features exact trigger payloads, cascading logic, and circuit-breaker failure guards.
      </p>
    </div>

    <!-- Live Production Blueprints -->
    <div class="mb-12">
      <div class="flex items-center gap-2 mb-6">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <h2 class="text-xl font-bold text-slate-900">Live Production Blueprints</h2>
        <span class="text-xs font-mono text-slate-400">({liveWorkflows.length})</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {liveWorkflows.map((wf) => (
          <article class="p-6 rounded-2xl border border-slate-200/90 bg-white hover:border-slate-300 hover:shadow-sm transition-all flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-2">
                <span class="text-cyan-700 bg-cyan-50 border border-cyan-200 px-2 py-0.5 rounded">{wf.data.cluster}</span>
                <span class="text-emerald-600 font-semibold">● Live Blueprint</span>
              </div>
              <h3 class="text-xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors mb-2 leading-snug">
                <a href={`/workflows/${wf.data.slug || wf.id}`}>
                  {wf.data.title}
                </a>
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
                {wf.data.description}
              </p>
            </div>

            <div>
              <div class="flex flex-wrap gap-1.5 mb-4">
                {wf.data.tools.map((t) => (
                  <span class="text-[11px] font-mono bg-slate-100 text-slate-700 px-2 py-0.5 rounded">
                    {t}
                  </span>
                ))}
              </div>
              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs font-mono text-slate-400">Time: {(wf.data as any).buildTime || '2-4 hrs'}</span>
                <a
                  href={`/workflows/${wf.data.slug || wf.id}`}
                  class="text-xs font-semibold text-[#1d6ff2] hover:underline"
                >
                  View Schematic →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Draft / Lab Blueprints -->
    {draftWorkflows.length > 0 && (
      <div>
        <div class="flex items-center gap-2 mb-6">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
          <h2 class="text-xl font-bold text-slate-900">Lab & Reference Schematics</h2>
          <span class="text-xs font-mono text-slate-400">({draftWorkflows.length})</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {draftWorkflows.map((wf) => (
            <article class="p-6 rounded-2xl border border-slate-200/90 bg-white hover:border-slate-300 hover:shadow-sm transition-all flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-2">
                  <span class="text-slate-600 bg-slate-100 px-2 py-0.5 rounded">{wf.data.cluster}</span>
                  <span class="text-amber-600 font-semibold">● Lab Reference</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors mb-2">
                  <a href={`/workflows/${wf.data.slug || wf.id}`}>
                    {wf.data.title}
                  </a>
                </h3>
                <p class="text-xs text-slate-600 leading-relaxed mb-4">
                  {wf.data.description}
                </p>
              </div>

              <div>
                <div class="flex flex-wrap gap-1.5 mb-4">
                  {wf.data.tools.map((t) => (
                    <span class="text-[10px] font-mono bg-slate-100 text-slate-600 px-2 py-0.5 rounded">
                      {t}
                    </span>
                  ))}
                </div>
                <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                  <span class="text-xs font-mono text-slate-400">Time: {(wf.data as any).buildTime || '2-4 hrs'}</span>
                  <a
                    href={`/workflows/${wf.data.slug || wf.id}`}
                    class="text-xs font-semibold text-[#1d6ff2] hover:underline"
                  >
                    View Schematic →
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
