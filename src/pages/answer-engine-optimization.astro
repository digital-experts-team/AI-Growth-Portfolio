---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Answer Engine Optimization (AEO) & GEO for B2B | Tibin";
const description = "Engineer your B2B brand and technical documentation to get cited by Perplexity, ChatGPT, Gemini, and Google AI Overviews.";
const canonicalUrl = "https://tibinjacob.com/answer-engine-optimization";

const faqList = [
  {
    q: "How is Answer Engine Optimization (AEO) different from traditional SEO?",
    a: "Traditional SEO focuses on earning clicks from blue links on search engine result pages. AEO and GEO focus on structuring entity schemas, brand references, and technical documentation so large language models select and cite your business as the recommended solution in AI-generated answers."
  },
  {
    q: "Which AI answer engines are targeted?",
    a: "Optimization strategies cover Perplexity AI, ChatGPT Search, Google AI Overviews, Gemini, and Claude web-search models."
  },
  {
    q: "How long does it take for AI search engines to index and cite updated content?",
    a: "Indexing cycles range from 3 to 14 days depending on crawl frequencies of PerplexityBot, GPTBot, and Googlebot."
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schemaType="WebPage"
  faq={faqList}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Answer Engine Optimization', url: '/answer-engine-optimization' },
  ]}
>
  <div class="py-6 max-w-4xl mx-auto">
    <!-- 1. Breadcrumb -->
    <nav class="text-xs font-mono text-slate-400 mb-6 flex items-center gap-2" aria-label="Breadcrumb">
      <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-600">Answer Engine Optimization</span>
    </nav>

    <!-- Header -->
    <header class="mb-8 pb-6 border-b border-slate-200">
      <!-- 2. Service category label (small pill) -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-cyan-200 bg-cyan-50 text-cyan-700 text-xs font-mono font-semibold mb-4">
        <span>AEO & GEO Strategy</span>
      </div>

      <!-- 3. H1 — keyword-first -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 mb-4 leading-tight">
        Answer Engine Optimization (AEO) and GEO for B2B
      </h1>

      <!-- 4. Short answer block (lime left border) -->
      <div class="p-5 rounded-xl border-l-4 border-[#d2f39c] bg-slate-50 my-6">
        <div class="text-[11px] font-mono text-slate-500 font-bold uppercase tracking-wider mb-1">
          Service Overview
        </div>
        <p class="text-base sm:text-lg text-slate-900 leading-relaxed font-medium">
          I help B2B technology companies optimize their brand references, technical documentation, and structured schema so they get cited as recommended solutions in Perplexity, ChatGPT, Gemini, and Google AI Overviews when prospective buyers research software categories.
        </p>
      </div>
    </header>

    <!-- 5. Body sections with H2 headings (min 500 words) -->
    <div class="prose max-w-none space-y-8 text-slate-700 leading-relaxed text-sm sm:text-base">
      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Why AI Search Matters for B2B Buyer Journeys</h2>
        <p>
          B2B software buyers increasingly bypass traditional search result pages when evaluating products. Instead of clicking through ten blue links, revenue leaders and technical buyers ask answer engines like Perplexity and ChatGPT for product comparisons, architectural trade-offs, and software recommendations.
        </p>
        <p>
          To win citations in generative AI answers, your digital presence must provide structured, machine-readable facts that LLMs can extract, verify, and reference as authoritative sources.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Pillar 1: Structured Entity Schema & Documentation</h2>
        <p>
          Generative AI models rely heavily on clear JSON-LD schema objects (such as SoftwareApplication, DefinedTerm, FAQPage, and HowTo) to parse core business claims. By embedding strict entity schemas directly into clean HTML, we ensure scrapers like GPTBot, PerplexityBot, and Googlebot index your value proposition accurately.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Pillar 2: Generative Engine Optimization (GEO)</h2>
        <p>
          Generative Engine Optimization (GEO) aligns content structure with the retrieval-augmented generation (RAG) pipelines used by AI search engines. This includes creating direct answer blocks, objective comparison tables, concise term definitions, and markdown-first specifications that fit neatly into context windows.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Pillar 3: AI Crawler Access & llms.txt Optimization</h2>
        <p>
          We implement standardized machine-readable endpoints—such as `/llms.txt` and `/llms-full.txt`—to provide LLMs with lightweight, markdown-formatted summaries of your products, workflows, and case studies. This improves indexation speed and retrieval accuracy during live user queries.
        </p>
      </section>

      <!-- 6. Proof section -->
      <section class="p-6 rounded-2xl border border-slate-200 bg-slate-50">
        <h2 class="text-lg font-bold text-slate-900 mb-2">See AEO Architecture in Production</h2>
        <p class="text-xs sm:text-sm text-slate-600 mb-4 leading-relaxed">
          Explore how structured signal processing and machine-readable data pipelines are implemented in my case studies and live workflows.
        </p>
        <div class="flex flex-wrap gap-4 text-xs font-mono">
          <a href="/work/heurist-autopilot-agents" class="text-[#1d6ff2] hover:underline font-semibold">
            Heurist AI Case Study →
          </a>
          <a href="/workflows/website-visitors-to-hubspot" class="text-[#1d6ff2] hover:underline font-semibold">
            Website Visitors Workflow →
          </a>
        </div>
      </section>
    </div>

    <!-- 7. FAQ section (<details><summary>) -->
    <section class="mt-12 pt-8 border-t border-slate-200">
      <h2 class="text-2xl font-bold text-slate-900 mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqList.map((item) => (
          <details class="group rounded-xl border border-slate-200 bg-white p-4 [&_summary::-webkit-details-marker]:none">
            <summary class="flex cursor-pointer items-center justify-between gap-1.5 text-slate-900 font-semibold text-sm sm:text-base">
              <span>{item.q}</span>
              <span class="shrink-0 rounded-full bg-slate-100 p-1.5 text-slate-900 sm:p-2 transition group-open:-rotate-180">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <p class="mt-4 leading-relaxed text-xs sm:text-sm text-slate-600 border-t border-slate-100 pt-3">
              {item.a}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- 8. "Hire me for this" CTA button -->
    <div class="mt-12 p-8 rounded-2xl bg-slate-900 text-white flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="text-xl font-bold mb-2">Ready to rank in Perplexity & ChatGPT?</h3>
        <p class="text-xs sm:text-sm text-slate-300">Let’s audit your current AEO visibility and deploy an AI search strategy.</p>
      </div>
      <a href="/hire" class="cta-button text-xs px-6 py-3 rounded-full font-bold uppercase tracking-wider shrink-0">
        Hire me for this
      </a>
    </div>
  </div>
</BaseLayout>
