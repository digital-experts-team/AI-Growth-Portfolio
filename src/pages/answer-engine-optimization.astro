---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const title = "Answer Engine Optimization (AEO) & GEO for B2B | Tibin Jacob";
const description = "Engineer your B2B brand and technical documentation to get cited by Perplexity, ChatGPT, Gemini, and Google AI Overviews.";
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'AI Search (AEO/GEO)', url: '/answer-engine-optimization' },
  ]}
>
  <div class="py-6 max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-10">
      <div class="text-[11px] font-mono uppercase tracking-wider text-cyan-600 font-semibold mb-2">
        Get cited by AI search
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-slate-900 mb-4">
        Answer Engine Optimization (AEO) & GEO for B2B
      </h1>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl">
        B2B buyers research solutions directly inside ChatGPT, Perplexity, and Claude before ever visiting a vendor site. Here is how we engineer technical content, schema, and brand references to get cited in AI answers.
      </p>
    </div>

    <!-- Core AEO Pillars -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-10">
      <div class="p-6 rounded-2xl border border-slate-200/90 bg-white shadow-sm flex flex-col justify-between">
        <div>
          <div class="text-xs font-mono text-cyan-600 font-semibold mb-2">PILLAR 01</div>
          <h2 class="text-xl font-bold text-slate-900 mb-2">Structured Entity Schema & Technical Docs</h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
            JSON-LD schema, static-first markdown specs, and clear term definitions engineered for LLM web crawlers to scrape, index, and cite.
          </p>
        </div>
        <span class="text-xs font-mono text-slate-400">Signal: LLM scraper inclusion & citation rate</span>
      </div>

      <div class="p-6 rounded-2xl border border-slate-200/90 bg-white shadow-sm flex flex-col justify-between">
        <div>
          <div class="text-xs font-mono text-cyan-600 font-semibold mb-2">PILLAR 02</div>
          <h2 class="text-xl font-bold text-slate-900 mb-2">Generative Engine Optimization (GEO)</h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
            Optimizing comparison queries, category teardowns, and architectural trade-off specs that generative engines reference when recommending B2B SaaS tools.
          </p>
        </div>
        <span class="text-xs font-mono text-slate-400">Signal: AI Overviews & ChatGPT answer citations</span>
      </div>
    </div>

    <div class="mt-12 p-8 rounded-2xl bg-slate-900 text-white flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="text-xl font-bold mb-2">Want to rank in Perplexity & ChatGPT for your category?</h3>
        <p class="text-xs sm:text-sm text-slate-300">Let’s audit your current AEO visibility and build an AI search strategy.</p>
      </div>
      <a href="/hire" class="px-6 py-3 rounded-full bg-[#d2f39c] text-black font-bold text-xs uppercase tracking-wider hover:bg-[#c2e887] transition-all shrink-0">
        Work with me →
      </a>
    </div>
  </div>
</BaseLayout>
