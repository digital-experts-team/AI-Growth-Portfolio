---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ContactForm } from '../../components/ContactForm';

const title = "RevOps Templates & Blueprints (Coming Soon) | Tibin";
const description = "Production RevOps templates, n8n workflow JSON blueprints, and Clay formulas. Currently in active curation.";
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'RevOps Templates', url: '/revops' },
  ]}
>
  <div class="py-12 max-w-3xl mx-auto text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-zinc-200 bg-zinc-50 text-xs text-zinc-600 font-mono mb-6">
      <span class="w-2 h-2 rounded-full bg-amber-400"></span>
      <span>In Curation</span>
    </div>

    <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-slate-900 mb-6">
      RevOps Templates & Blueprints
    </h1>

    <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-8">
      I am currently packaging my production n8n workflows, Clay waterfall sheets, and HubSpot lead-routing blueprints into downloadable, ready-to-import templates.
    </p>

    <div class="p-6 rounded-2xl border border-slate-200 bg-white text-left mb-12 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900 mb-3">Planned Template Releases</h2>
      <ul class="space-y-2 text-xs sm:text-sm text-slate-600 list-disc list-inside">
        <li>n8n Waterfall Enrichment Engine with Apollo & Clay fallback (.json)</li>
        <li>HubSpot Round-Robin Lead Routing with Slack SLA Escalation</li>
        <li>Clay Inbound ICP Fit Calculator Workbook Formula Matrix</li>
        <li>AI Cold Email Reply Sentiment Classification Agent</li>
      </ul>
    </div>

    <div class="p-8 rounded-2xl border border-slate-200 bg-slate-50 text-left">
      <h3 class="text-xl font-bold text-slate-900 mb-2">Request an Early Template or Custom Build</h3>
      <p class="text-xs sm:text-sm text-slate-600 mb-6">
        Need one of these templates immediately for your team? Let me know which architecture you need, and I'll send you the raw configuration.
      </p>

      <ContactForm client:visible />
    </div>
  </div>
</BaseLayout>
