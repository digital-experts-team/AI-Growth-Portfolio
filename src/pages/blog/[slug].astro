---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((entry) => ({
    params: { slug: entry.data.slug || entry.id },
    props: { entry },
  }));
}

export interface Props {
  entry: CollectionEntry<'posts'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const slug = entry.data.slug || entry.id;
const title = `${entry.data.title} | Tibin Jacob`;
const description = entry.data.description;
---

<BaseLayout
  title={title}
  description={description}
  schemaType="Article"
  publishedDate={entry.data.publishedDate}
  updatedDate={entry.data.updatedDate}
  faq={entry.data.faq}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog' },
    { name: entry.data.title, url: `/blog/${slug}` },
  ]}
>
  <article class="py-6 max-w-4xl mx-auto">
    <!-- Breadcrumbs -->
    <nav class="text-xs font-mono text-gray-500 mb-6 flex items-center gap-2" aria-label="Breadcrumb">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <span>/</span>
      <a href="/blog" class="hover:text-white transition-colors">Blog</a>
      <span>/</span>
      <span class="text-gray-300 truncate max-w-xs">{entry.data.title}</span>
    </nav>

    <!-- Header -->
    <header class="mb-10 pb-8 border-b border-[var(--surface-border)]">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="text-xs font-mono text-[var(--accent)] bg-[var(--accent)]/10 px-2.5 py-1 rounded">
          {entry.data.cluster}
        </span>
        <span class="text-xs font-mono text-gray-400">
          Format: <strong class="text-white capitalize">{entry.data.type} Guide</strong>
        </span>
        <span class="text-xs font-mono text-amber-400 bg-amber-950/30 border border-amber-800/40 px-2 py-0.5 rounded">
          Draft / Outline
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white mb-4 leading-tight">
        {entry.data.title}
      </h1>

      <p class="text-base sm:text-lg text-gray-300 leading-relaxed max-w-2xl mb-4">
        {entry.data.description}
      </p>

      <div class="text-xs font-mono text-gray-500">
        Primary Search Intent: {entry.data.targetKeyword} · Target: {entry.data.audience.join(', ')}
      </div>
    </header>

    <!-- Content / Outline -->
    <div class="prose prose-invert max-w-none space-y-6 text-gray-300 leading-relaxed text-sm sm:text-base">
      <Content />
    </div>

    <!-- FAQ Section -->
    {entry.data.faq && entry.data.faq.length > 0 && (
      <FAQ items={entry.data.faq} />
    )}

    <!-- Footer -->
    <footer class="mt-12 pt-8 border-t border-[var(--surface-border)] flex flex-wrap justify-between items-center gap-4">
      {entry.data.proofLink ? (
        <a href={entry.data.proofLink} class="text-xs font-mono text-[var(--accent)] hover:underline inline-flex items-center gap-1">
          ← View Related Case Study
        </a>
      ) : (
        <a href="/blog" class="text-xs font-mono text-gray-400 hover:text-white transition-colors">
          ← Back to All Articles
        </a>
      )}

      <a href="/hire" class="cta-button text-xs px-4 py-2 rounded-lg">
        Discuss this architecture with Tibin
      </a>
    </footer>
  </article>
</BaseLayout>
