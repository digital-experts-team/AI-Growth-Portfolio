---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((entry) => ({
    params: { slug: entry.data.slug || entry.id },
    props: { entry },
  }));
}

export interface Props {
  entry: CollectionEntry<'posts'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const slug = entry.data.slug || entry.id;
const title = `${entry.data.title} | Tibin Jacob`;
const description = entry.data.description;
---

<BaseLayout
  title={title}
  description={description}
  schemaType="Article"
  publishedDate={entry.data.publishedDate}
  updatedDate={entry.data.updatedDate}
  faq={entry.data.faq}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Writing', url: '/blog' },
    { name: entry.data.title, url: `/blog/${slug}` },
  ]}
>
  <article class="py-6 max-w-4xl mx-auto">
    <!-- Breadcrumbs -->
    <nav class="text-xs font-mono text-slate-400 mb-6 flex items-center gap-2" aria-label="Breadcrumb">
      <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
      <span>/</span>
      <a href="/blog" class="hover:text-slate-900 transition-colors">Writing</a>
      <span>/</span>
      <span class="text-slate-600 truncate max-w-xs">{entry.data.title}</span>
    </nav>

    <!-- Header -->
    <header class="mb-10 pb-8 border-b border-slate-200">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="text-xs font-mono text-cyan-700 bg-cyan-50 border border-cyan-200 px-2.5 py-1 rounded">
          {entry.data.cluster}
        </span>
        <span class="text-xs font-mono text-slate-500">
          Format: <strong class="text-slate-900 capitalize">{entry.data.type} Guide</strong>
        </span>
        <span class="text-xs font-mono text-slate-600 bg-slate-100 border border-slate-200 px-2 py-0.5 rounded">
          {entry.data.status === 'draft' ? 'Draft Outline' : 'Published'}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-slate-900 mb-4 leading-tight">
        {entry.data.title}
      </h1>

      <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl mb-6">
        {entry.data.description}
      </p>

      <div class="text-xs font-mono text-slate-400">
        Primary Search Intent: <span class="text-slate-700">{entry.data.targetKeyword || 'GTM Strategy'}</span>
      </div>
    </header>

    <!-- Content -->
    <div class="prose max-w-none space-y-6 text-slate-700 leading-relaxed text-sm sm:text-base">
      <Content />
    </div>

    <!-- FAQ Component -->
    {entry.data.faq && entry.data.faq.length > 0 && (
      <div class="mt-12 pt-8 border-t border-slate-200">
        <FAQ items={entry.data.faq} />
      </div>
    )}

    <!-- Related Links & CTA -->
    <footer class="mt-12 pt-8 border-t border-slate-200 flex flex-wrap justify-between items-center gap-4">
      <a href="/blog" class="text-xs font-mono text-slate-500 hover:text-slate-900 transition-colors">
        ← Back to Writing Index
      </a>

      <a href="/hire" class="cta-button text-xs px-4 py-2 rounded-lg">
        Discuss GTM Strategy
      </a>
    </footer>
  </article>
</BaseLayout>
