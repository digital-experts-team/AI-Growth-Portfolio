---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');

const title = "Articles - GTM Engineering & RevOps | Tibin Jacob";
const description = "Technical articles, evergreen pillars, and GTM insights on signal-based outbound, HubSpot routing, and workflows.";

interface FieldNote {
  ourHeadline: string;
  ourTake: string;
  source: {
    publication: string;
    title: string;
    url: string;
    isPaid?: boolean;
  };
  savedHereUrl: string; // /work/*, /workflows/*, or an Our-articles slug
  dateLogged: string;
  pillarChip: 'Signal → SQL' | 'Data systems' | 'HITL agents' | 'AI search' | 'Paid demand' | 'Operator notes';
}

// Declared empty as per specification (no hardcoded fake external articles)
const fieldNotes: FieldNote[] = [];
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Articles', url: '/blog' },
  ]}
>
  <div class="py-6 max-w-6xl mx-auto">
    <!-- Header -->
    <div class="mb-12 pb-8 border-b border-zinc-200">
      <div class="text-[11px] font-mono uppercase tracking-wider text-green-600 font-semibold mb-2">
        Publications & Insights
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-zinc-950 mb-4 font-display">
        Articles
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 leading-relaxed max-w-2xl font-normal">
        Architectural breakdowns, operational playbooks, and strategic perspectives on building predictable B2B revenue infrastructure.
      </p>
    </div>

    <!-- Split Grid (Owned Articles primary on Left, From the field secondary on Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- 1) Our articles (Pillar / Evergreen) -->
      <section class="lg:col-span-8 flex flex-col gap-6" aria-labelledby="our-articles-heading">
        <div class="flex items-center gap-3 pb-3 border-b border-zinc-100 mb-2">
          <span class="w-2.5 h-2.5 rounded-full bg-green-600"></span>
          <h2 id="our-articles-heading" class="text-xl sm:text-2xl font-bold text-zinc-950 tracking-tight font-display">
            Our articles
          </h2>
        </div>

        <div class="space-y-6">
          {posts.map((post) => {
            const dateStr = post.data.publishedDate
              ? post.data.publishedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
              : 'Sep 25, 2026';

            return (
              <article class="p-6 rounded-2xl border border-zinc-200 bg-white hover:border-zinc-300 hover:shadow-xs transition-all flex flex-col justify-between group">
                <div class="flex flex-wrap items-baseline justify-between gap-2 mb-3">
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-mono text-green-700 bg-green-50 border border-green-200 px-2 py-0.5 rounded">
                      {post.data.cluster}
                    </span>
                    {post.data.type === 'pillar' && (
                      <span class="text-xs font-mono text-green-700 bg-green-100 border border-green-300 px-2 py-0.5 rounded">
                        Pillar Guide
                      </span>
                    )}
                  </div>
                  <span class="text-xs font-mono text-zinc-400">
                    {dateStr}
                  </span>
                </div>

                <h3 class="text-xl sm:text-2xl font-bold text-zinc-900 group-hover:text-green-600 transition-colors mb-2 leading-snug font-display">
                  <a href={`/blog/${post.data.slug || post.id}`}>
                    {post.data.title}
                  </a>
                </h3>

                <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed mb-4 max-w-3xl font-medium">
                  {post.data.description}
                </p>

                <div class="pt-4 border-t border-zinc-100 flex items-center justify-between">
                  <span class="text-xs font-mono text-zinc-400">
                    Target: {post.data.targetKeyword || 'GTM Engineering'}
                  </span>
                  <a
                    href={`/blog/${post.data.slug || post.id}`}
                    class="text-xs font-bold text-green-600 hover:text-green-700 hover:underline"
                  >
                    Read article →
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <!-- 2) From the field (Secondary, smaller cards) -->
      <section class="lg:col-span-4 flex flex-col gap-6" aria-labelledby="from-the-field-heading">
        <div class="flex items-center gap-3 pb-3 border-b border-zinc-100 mb-2">
          <span class="w-2.5 h-2.5 rounded-full bg-zinc-400"></span>
          <h2 id="from-the-field-heading" class="text-xl sm:text-2xl font-bold text-zinc-950 tracking-tight font-display">
            From the field
          </h2>
        </div>

        {fieldNotes.length === 0 ? (
          <div class="p-8 rounded-2xl border border-zinc-200 bg-zinc-50/50 text-center">
            <span class="text-xs font-mono text-zinc-400 block mb-2 uppercase tracking-widest">Field Observations</span>
            <p class="text-sm sm:text-base text-zinc-600 font-medium">No field notes yet.</p>
          </div>
        ) : (
          <div class="space-y-4">
            {fieldNotes.map((note) => {
              const relVal = note.source.isPaid ? 'noopener nofollow sponsored' : 'noopener';
              return (
                <div class="p-5 rounded-xl border border-zinc-200 bg-white shadow-xs flex flex-col justify-between gap-4">
                  <div class="flex items-center justify-between text-[10px] font-mono text-zinc-400">
                    <span class="text-green-700 bg-green-50 border border-green-100 px-2 py-0.5 rounded">{note.pillarChip}</span>
                    <span>{note.dateLogged}</span>
                  </div>
                  <div>
                    <h4 class="text-sm font-bold text-zinc-900 leading-snug mb-1 font-display">{note.ourHeadline}</h4>
                    <p class="text-xs text-zinc-600 leading-relaxed font-medium mb-3">{note.ourTake}</p>
                    
                    <div class="text-[11px] text-zinc-400 font-mono">
                      Source: <a href={note.source.url} target="_blank" rel={relVal} class="text-green-600 hover:underline">{note.source.publication} — {note.source.title}</a>
                    </div>
                  </div>
                  
                  <div class="pt-3 border-t border-zinc-100">
                    <a href={note.savedHereUrl} class="inline-flex items-center gap-1.5 text-xs font-bold text-green-600 hover:text-green-700 hover:underline">
                      <span>Our take</span>
                      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="7" y1="17" x2="17" y2="7"></line>
                        <polyline points="7 7 17 7 17 17"></polyline>
                      </svg>
                    </a>
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </section>
      
    </div>
  </div>
</BaseLayout>
