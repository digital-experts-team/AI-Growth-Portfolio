---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');

const title = "GTM Engineering & RevOps Articles | Tibin Jacob";
const description = "Technical articles and guides on GTM engineering, MQL vs SQL alignment, automated lead routing, and human-in-the-loop AI sales agents.";
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog' },
  ]}
>
  <div class="py-6 max-w-5xl mx-auto">
    <div class="mb-10">
      <div class="text-xs font-mono uppercase tracking-wider text-[var(--accent)] mb-2">
        Technical Writing & Guides
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-white mb-4">
        GTM Engineering & RevOps Articles
      </h1>
      <p class="text-base sm:text-lg text-gray-300 leading-relaxed max-w-2xl">
        Architectural breakdowns, operational playbooks, and strategic perspectives on building predictable B2B revenue infrastructure.
      </p>
    </div>

    <div class="space-y-6">
      {posts.map((post) => (
        <article class="p-6 rounded-2xl border border-[var(--surface-border)] bg-[var(--surface)] hover:border-white/20 transition-all flex flex-col justify-between">
          <div class="flex flex-wrap items-baseline justify-between gap-2 mb-2">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono text-[var(--accent)] bg-[var(--accent)]/10 px-2 py-0.5 rounded">
                {post.data.cluster}
              </span>
              {post.data.type === 'pillar' && (
                <span class="text-xs font-mono text-emerald-400 bg-emerald-950/40 border border-emerald-800/40 px-2 py-0.5 rounded">
                  Pillar Guide
                </span>
              )}
            </div>
            <span class="text-xs font-mono text-gray-500">
              {post.data.status === 'draft' ? 'Under Review / Draft' : 'Published'}
            </span>
          </div>

          <h2 class="text-xl sm:text-2xl font-bold text-white mb-2 leading-snug">
            <a href={`/blog/${post.data.slug || post.id}`} class="hover:text-[var(--accent)] transition-colors">
              {post.data.title}
            </a>
          </h2>

          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed mb-4 max-w-3xl">
            {post.data.description}
          </p>

          <div class="pt-3 border-t border-white/5 flex items-center justify-between">
            <span class="text-xs font-mono text-gray-500">Target Keyword: {post.data.targetKeyword}</span>
            <a
              href={`/blog/${post.data.slug || post.id}`}
              class="text-xs font-mono text-[var(--accent)] hover:underline inline-flex items-center gap-1"
            >
              Read Article Outline & FAQ →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
