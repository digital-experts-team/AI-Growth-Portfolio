---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "GTM Engineer & AI Growth Lead, Bengaluru | Tibin Jacob";
const description = "Background and career timeline of Tibin Jacob, GTM Engineer with 4+ years architecting signal-based sales systems across Mavlers, Heurist AI, and Paddleboat AI.";

const timeline = [
  {
    company: "Mavlers",
    role: "GTM Automation Lead",
    dates: "Apr 2026 – Sep 2026",
    location: "Remote, India",
    type: "Agency (white-label PPC / SEO / AEO)",
    highlights: [
      "Owned inbound-to-outbound end to end: visitor flagged → scored against ICP → pushed into active follow-up sequences in HubSpot.",
      "Built multi-signal intent routing to separate white-label partner agencies from retail brand MQLs.",
      "Conducted executive ICP workshop that created the brief for an automated delivery add-on vertical.",
    ],
    proofLink: "/work/mavlers-partner-agency-signals",
  },
  {
    company: "Heurist AI",
    role: "GTM Automation — Autopilot Agents",
    dates: "Oct 2024 – Nov 2025",
    location: "Remote, US",
    type: "Product / SaaS (Decentralized AI Cloud)",
    highlights: [
      "Built autopilot agents that generated and distributed top-of-funnel content on X and LinkedIn.",
      "Designed agent workflows with deterministic state-machine logic, retries, and error handling.",
      "Enforced a 100% human-in-the-loop Slack approval gate to maintain brand compliance.",
    ],
    proofLink: "/work/heurist-autopilot-agents",
  },
  {
    company: "Sonic (sonic.ooo)",
    role: "Founder-led GTM Automation",
    dates: "Jan 2024 – Sep 2024",
    location: "Remote",
    type: "Product / DeFi",
    highlights: [
      "Built multi-channel automations to brief institutional investors and drive user growth across X, LinkedIn, Discord, and email.",
      "Captured on-site buyer signals with Sales IQ and routed them directly into priority conversion paths.",
      "Diagnosed drop-off points with Microsoft Clarity session telemetry before sales or support engaged.",
    ],
    proofLink: "/work/sonic-founder-led-gtm",
  },
  {
    company: "Paddleboat AI",
    role: "GTM Engineer — Outbound & Sales Enablement",
    dates: "May 2022 – Dec 2023",
    location: "Bengaluru, Hybrid",
    type: "AI sales roleplay / coaching",
    highlights: [
      "Engineered multi-signal outbound architecture targeting VP and Head of Sales at 50–500 person B2B SaaS companies.",
      "Combined site intent with hiring and funding signals to flag organizations scaling their SDR teams.",
      "Collaborated with reps to design objection personas and LLM scorecards for sales enablement.",
    ],
    proofLink: "/work/paddleboat-sdr-scaling-signals",
  },
];
---

<BaseLayout
  title={title}
  description={description}
  schemaType="Person"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'About', url: '/about' },
  ]}
>
  <div class="py-6 max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-10">
      <div class="text-[11px] font-mono uppercase tracking-wider text-green-600 font-semibold mb-2">
        Tibin Jacob.
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-slate-900 mb-6">
        Tibin Jacob — <span class="heading-highlight">GTM Engineer</span> & AI Growth Lead, Bengaluru
      </h1>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl font-normal">
        I am a GTM Engineer based in Bengaluru, India. Over the past 4+ years, I have architected automated outbound pipelines, multi-vendor waterfall enrichment engines, and CRM lifecycle routing for high-growth B2B teams.
      </p>

      <div class="mt-6 flex flex-wrap gap-4 items-center">
        <a
          href="/resume/tibin-jacob-gtm-engineer.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-5 py-2.5 bg-green-600 hover:bg-green-700 text-white text-[13px] font-semibold rounded-lg shadow-sm transition-all gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download Resume (PDF)
        </a>
        <a
          href="/hire"
          class="btn-secondary px-5 py-2.5 rounded-lg text-xs font-medium"
        >
          Hire Me / 30-60-90 Plan
        </a>
        <a
          href="https://www.linkedin.com/in/tibinjacob"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-mono text-slate-500 hover:text-slate-900 transition-colors"
        >
          LinkedIn Profile →
        </a>
      </div>
    </div>

    <!-- What I Actually Do -->
    <section class="my-12 p-6 sm:p-8 rounded-2xl border border-slate-200/90 bg-white shadow-sm" aria-labelledby="discipline-heading">
      <h2 id="discipline-heading" class="text-xl sm:text-2xl font-bold text-slate-900 mb-4">
        What I Do as a GTM Engineer
      </h2>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed mb-4">
        Traditional sales operations maintains CRM records and reports. Traditional marketing runs ad campaigns and generates contact forms. As a GTM Engineer, I write the connective software and automation that joins them:
      </p>
      <ul class="space-y-3 text-xs sm:text-sm text-slate-600 list-disc list-inside">
        <li><strong class="text-slate-900">Signal-Driven Outbound:</strong> Intercepting buyer intent before they fill out a form (site visits, hiring surges, funding events).</li>
        <li><strong class="text-slate-900">Waterfall Data Engineering:</strong> Chaining multiple providers (Apollo, Clay) with MX deliverability checks.</li>
        <li><strong class="text-slate-900">Deterministic Lead Routing:</strong> Ensuring qualified SQLs land in rep queues with complete context.</li>
        <li><strong class="text-slate-900">AI Agent State Machines:</strong> Deploying content and outbound LLM agents with human-in-the-loop review gates to safeguard brand integrity.</li>
      </ul>
    </section>

    <!-- Experience Timeline -->
    <section class="my-12" aria-labelledby="timeline-heading">
      <h2 id="timeline-heading" class="text-2xl font-bold text-slate-900 mb-8">
        Career & Engagement Timeline
      </h2>

      <div class="relative border-l border-slate-200 ml-3 sm:ml-4 space-y-10">
        {timeline.map((item) => (
          <div class="relative pl-6 sm:pl-8 group">
            <!-- Node Marker -->
            <div class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-white border-2 border-green-600 group-hover:scale-125 transition-transform shadow-sm"></div>

            <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
              <h3 class="text-xl font-bold text-slate-900 group-hover:text-green-600 transition-colors font-display">
                {item.company}
              </h3>
              <span class="text-xs font-mono text-slate-500 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">
                {item.dates}
              </span>
            </div>

            <div class="text-sm font-semibold text-green-700 mb-1">
              {item.role}
            </div>

            <div class="text-xs font-mono text-slate-400 mb-3">
              {item.location} · {item.type}
            </div>

            <ul class="space-y-2 mb-4 text-xs sm:text-sm text-slate-600 list-disc list-inside">
              {item.highlights.map((h) => (
                <li class="leading-relaxed">{h}</li>
              ))}
            </ul>

            <a
              href={item.proofLink}
              class="text-xs font-semibold text-green-600 hover:underline inline-flex items-center gap-1"
            >
              Read full case study architecture →
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- Education -->
    <section class="my-12 p-6 rounded-2xl border border-slate-200/90 bg-white shadow-sm" aria-labelledby="education-heading">
      <h2 id="education-heading" class="text-xl font-bold text-slate-900 mb-4">
        Education & Foundations
      </h2>
      <div class="flex flex-wrap justify-between items-baseline gap-2">
        <div>
          <h3 class="text-base font-semibold text-slate-900">Amity University</h3>
          <p class="text-sm text-slate-500">Bachelor of Computer Applications (BCA)</p>
        </div>
        <span class="text-xs font-mono text-slate-500 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">
          2014 – 2017
        </span>
      </div>
    </section>

    <!-- CTA -->
    <div class="mt-12 p-6 rounded-2xl border border-green-200 bg-green-50/50 flex flex-wrap items-center justify-between gap-4">
      <div>
        <h3 class="text-lg font-bold text-slate-900 mb-1">Looking for a technical GTM partner?</h3>
        <p class="text-xs text-slate-600">Available for full-time GTM Engineer roles or fractional RevOps automation builds.</p>
      </div>
      <a href="/hire" class="inline-flex items-center justify-center px-5 py-2.5 bg-green-600 hover:bg-green-700 text-white text-[13px] font-semibold rounded-lg shadow-sm transition-all">
        View Engagement Models
      </a>
    </div>
  </div>
</BaseLayout>
