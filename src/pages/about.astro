---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'About Tibin Jacob — GTM Engineer, AI Search & B2B Growth';
const description = 'Tibin Jacob is a GTM Engineer and AI growth expert for B2B based in Bengaluru, with 4+ years across Mavlers, Heurist AI, Sonic and Paddleboat AI.';
const timeline = [
  {
    company: 'Mavlers',
    role: 'GTM Automation Lead',
    dates: 'Apr 2026 – Sep 2026',
    location: 'Remote, India',
    type: 'Agency (white-label PPC / SEO / AEO)',
    highlights: [
      'Mavlers sells delivery capacity to other agencies, so the GTM problem was finding partner agencies, not brand-side MQLs.',
      'Designed a multi-signal motion (Sales IQ site intent, firmographics, engagement) routed into HubSpot, so sales worked SQL-ready partner accounts.',
      'Owned inbound-to-outbound end to end: visitor flagged, scored against ICP, pushed into a defined follow-up sequence using the MQL to SQL stages sales already trusted.',
      "Ran an ICP workshop that became the brief for a new business vertical: automation packaged on top of Mavlers' white-label PPC and SEO/AEO delivery.",
    ],
    proofLink: '/work/mavlers-partner-agency-signals',
  },
  {
    company: 'Heurist AI',
    role: 'GTM Automation — Autopilot Agents',
    dates: 'Oct 2024 – Nov 2025',
    location: 'Remote, US',
    type: 'Product / SaaS',
    highlights: [
      'Built autopilot agents that generated and distributed top-of-funnel content on X and LinkedIn, keeping the product in the feed without a full content team.',
      'Designed agent workflows with state-machine logic, retries and error handling, so generation and outbound ran behind a human approval gate.',
    ],
    proofLink: '/work/heurist-autopilot-agents',
  },
  {
    company: 'Sonic (sonic.ooo)',
    role: 'Founder-led GTM Automation',
    dates: 'Jan 2024 – Sep 2024',
    location: 'Remote',
    type: 'Product / DeFi',
    highlights: [
      "Built and ran automations to brief investors and drive the product's growth across X, LinkedIn, Discord, and inbound/outbound email for product and customer support.",
      'Captured on-site signals with Sales IQ and routed them into conversion paths; used analytics and Microsoft Clarity to find where users dropped off before sales or support engaged.',
    ],
    proofLink: '/work/sonic-founder-led-gtm',
  },
  {
    company: 'Paddleboat AI',
    role: 'GTM Engineer — Outbound & Sales Enablement',
    dates: 'May 2022 – Dec 2023',
    location: 'Bengaluru, Hybrid',
    type: 'AI sales roleplay / coaching',
    highlights: [
      'Built a multi-signal GTM system targeting VPs and Heads of Sales at 50–500 person B2B SaaS companies.',
      'Combined site intent and engagement data with funding, hiring and team-scale signals to flag companies scaling their SDR org.',
      'Worked with SDRs and founders to turn real rep workflows into product design: personas by difficulty, industry and deal stage; LLM scorecards and missed-opportunity flags.',
      'Contributed to a #1 Product Hunt launch.',
    ],
    proofLink: '/work/paddleboat-sdr-scaling-signals',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  ogType="profile"
  schemaType="Person"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'About', url: '/about' },
  ]}
>
  <div class="flex flex-col gap-14 py-6 sm:py-10 max-w-[820px]">
    <header class="flex flex-col gap-4">
      <h1 class="flex flex-col gap-2">
        <span class="text-[36px] sm:text-[44px] font-bold text-slate-900 tracking-tight leading-tight">Tibin Jacob</span>
        <span class="text-[17px] font-semibold text-slate-600">GTM Engineer · AI Search (AEO/GEO) · B2B Performance Marketing</span>
      </h1>
      <p class="text-[16px] text-slate-600 leading-relaxed">
        I'm a GTM Engineer based in Bengaluru with 4+ years building the systems that turn buying signals into pipeline for B2B teams. I sit inside the team, next to sales and marketing: I've done this inside an agency packaging white-label delivery, inside a product team running always-on social GTM, and inside a founder-led motion working for investors and customers at the same time.
      </p>
      <div class="flex flex-wrap gap-3 pt-1">
        <a class="inline-flex items-center px-5 py-2.5 bg-[#1d6ff2] hover:bg-blue-600 text-white text-[14px] font-semibold rounded-lg" href="/resume/tibin-jacob-gtm-engineer.pdf" target="_blank" rel="noopener noreferrer">Download resume</a>
        <a class="inline-flex items-center px-5 py-2.5 bg-white border border-slate-300 hover:bg-slate-50 text-slate-800 text-[14px] font-medium rounded-lg" href="/hire">Hiring? See my 30/60/90 plan</a>
        <a class="inline-flex items-center px-5 py-2.5 text-[14px] font-medium text-slate-700 hover:text-slate-900" href="https://www.linkedin.com/in/tibinjacob" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </header>

    <section class="flex flex-col gap-4" aria-labelledby="what-heading">
      <h2 id="what-heading" class="text-[24px] font-bold text-slate-900">What I do</h2>
      <p class="text-[15px] text-slate-600 leading-relaxed">GTM engineering is my core. AI search and performance marketing are the demand sources I know how to feed into it.</p>
      <ul class="flex flex-col gap-3 text-[15px] text-slate-700 leading-relaxed">
        <li><strong class="text-slate-900">GTM automation.</strong> Signal capture (site intent, funding, hiring, engagement), waterfall enrichment, ICP scoring, lead routing and CRM write-back in HubSpot, plus AI agents with a human approval gate. Stack: Clay, n8n, HubSpot, Apollo, Zoho SalesIQ, Claude, Make, Zapier, Instantly.</li>
        <li><strong class="text-slate-900">AI search (AEO/GEO).</strong> Making B2B sites easy for ChatGPT, Perplexity and Google AI Overviews to read and cite: server-rendered pages, direct answers, schema and llms.txt, measured in Search Console and GA4.</li>
        <li><strong class="text-slate-900">B2B performance marketing.</strong> Meta and Google Ads tracked through MQL and SQL stages, with GA4, Looker Studio and Microsoft Clarity for funnel diagnosis.</li>
      </ul>
    </section>

    <section class="flex flex-col gap-6" aria-labelledby="timeline-heading">
      <h2 id="timeline-heading" class="text-[24px] font-bold text-slate-900">Experience</h2>
      <ol class="flex flex-col gap-8 border-l-2 border-slate-200 pl-6">
        {timeline.map((item) => (
          <li class="relative flex flex-col gap-2">
            <span class="absolute -left-[31px] top-1.5 w-3 h-3 rounded-full bg-[#1d6ff2]" aria-hidden="true"></span>
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-[18px] font-bold text-slate-900">{item.role} — {item.company}</h3>
              <span class="text-[13px] text-slate-500">{item.dates}</span>
            </div>
            <p class="text-[13px] text-slate-500">{item.location} · {item.type}</p>
            <ul class="list-disc pl-5 flex flex-col gap-1.5 text-[14px] text-slate-700 leading-relaxed">
              {item.highlights.map((h) => <li>{h}</li>)}
            </ul>
            <a href={item.proofLink} class="text-[13px] font-semibold text-[#1d6ff2] hover:underline">Read the {item.company} case study</a>
          </li>
        ))}
      </ol>
    </section>

    <section class="flex flex-col gap-3" aria-labelledby="education-heading">
      <h2 id="education-heading" class="text-[24px] font-bold text-slate-900">Education</h2>
      <p class="text-[15px] text-slate-700">Bachelor of Computer Applications, Amity University, 2014 – 2017</p>
    </section>

    <section class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-6 rounded-2xl bg-slate-50 border border-slate-200">
      <div>
        <h2 class="text-[18px] font-bold text-slate-900">Looking for a GTM engineer or AI growth lead?</h2>
        <p class="text-[14px] text-slate-600">Open to full-time roles and project-based builds.</p>
      </div>
      <a href="/hire" class="inline-flex items-center px-5 py-2.5 bg-[#1d6ff2] hover:bg-blue-600 text-white text-[14px] font-semibold rounded-lg">Hire me for this</a>
    </section>
  </div>
</BaseLayout>
