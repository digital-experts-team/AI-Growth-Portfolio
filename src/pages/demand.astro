---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const title = "Demand Generation & Upstream Signal Feed | Tibin Jacob";
const description = "How upstream demand channels—PPC, technical SEO, AEO, and content distribution—feed into automated B2B GTM engineering pipelines.";

const caseStudies = await getCollection('caseStudies');
const mavlersCaseStudy = caseStudies.find(c => (c.data.slug || c.id) === 'mavlers-partner-agency-signals');
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Demand', url: '/demand' },
  ]}
>
  <div class="py-6 max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-10">
      <div class="text-[11px] font-mono uppercase tracking-wider text-green-600 font-semibold mb-2">
        Upstream Inbound Engine
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-slate-900 mb-4">
        Demand Generation Meets GTM Engineering
      </h1>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl">
        Outbound automations and waterfall engines only work when high-intent buying signals feed them. Here is how paid media, technical SEO, AEO, and content function as the upstream input into revenue pipelines.
      </p>
    </div>

    <!-- The 4 Upstream Feeds -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-10">
      <div class="p-6 rounded-2xl border border-slate-200/90 bg-white shadow-sm flex flex-col justify-between">
        <div>
          <div class="text-xs font-mono text-green-600 font-semibold mb-2">FEED 01</div>
          <h2 class="text-xl font-bold text-slate-900 mb-2">High-Intent Paid Acquisition (PPC)</h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
            Rather than optimizing solely for raw lead form fills, paid traffic is targeted at high-intent comparison queries. Unconverted traffic is captured via reverse IP resolution and enriched into account lists.
          </p>
        </div>
        <span class="text-xs font-mono text-slate-400">Signal: Dedicated landing page dwell time</span>
      </div>

      <div class="p-6 rounded-2xl border border-slate-200/90 bg-white shadow-sm flex flex-col justify-between">
        <div>
          <div class="text-xs font-mono text-green-600 font-semibold mb-2">FEED 02</div>
          <h2 class="text-xl font-bold text-slate-900 mb-2">Technical SEO & Answer Engine Optimization (AEO)</h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
            Static-first architectures engineered for AI citations (Perplexity, ChatGPT, Gemini) and Google featured snippets. Captures procurement teams researching architectural specifications.
          </p>
        </div>
        <span class="text-xs font-mono text-slate-400">Signal: Documentation depth & term searches</span>
      </div>

      <div class="p-6 rounded-2xl border border-slate-200/90 bg-white shadow-sm flex flex-col justify-between">
        <div>
          <div class="text-xs font-mono text-green-600 font-semibold mb-2">FEED 03</div>
          <h2 class="text-xl font-bold text-slate-900 mb-2">Social Ingestion & Signal Mining</h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
            Monitoring hiring surges, funding rounds, and executive role shifts across LinkedIn and public channels to trigger automated outbound at the precise inflection point of organizational change.
          </p>
        </div>
        <span class="text-xs font-mono text-slate-400">Signal: SDR job openings, Series A rounds</span>
      </div>

      <div class="p-6 rounded-2xl border border-slate-200/90 bg-white shadow-sm flex flex-col justify-between">
        <div>
          <div class="text-xs font-mono text-green-600 font-semibold mb-2">FEED 04</div>
          <h2 class="text-xl font-bold text-slate-900 mb-2">Autopilot TOFU Content Agents</h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
            Autonomous multi-agent workflows that monitor market trends, draft hyper-relevant commentary, and push to a human-in-the-loop Slack queue for instant review and scheduled release.
          </p>
        </div>
        <span class="text-xs font-mono text-slate-400">Signal: Engagement velocity & direct mentions</span>
      </div>
    </div>

    <!-- The Closed-Loop Pipeline Bridge -->
    <section class="my-12 p-6 sm:p-8 rounded-2xl border border-slate-200/90 bg-white shadow-sm" aria-labelledby="bridge-heading">
      <h2 id="bridge-heading" class="text-xl sm:text-2xl font-bold text-slate-900 mb-4">
        The Feedback Loop to Campaign Spend
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
        Most marketing teams measure cost per lead (CPL). GTM engineering provides closed-loop revenue attribution back to the specific campaign, ad group, or search cluster that originated an SQL.
      </p>
      <div class="space-y-3 text-xs sm:text-sm text-slate-600">
        <div class="flex items-start gap-2">
          <span class="text-emerald-500 font-bold">✓</span>
          <span>Automatic conversion value write-backs to Google Ads & Meta Pixel via server-side APIs.</span>
        </div>
        <div class="flex items-start gap-2">
          <span class="text-emerald-500 font-bold">✓</span>
          <span>Negative audience syncs from HubSpot deal stages (excludes existing pipeline from ad spend).</span>
        </div>
        <div class="flex items-start gap-2">
          <span class="text-emerald-500 font-bold">✓</span>
          <span>Content topic validation driven by actual sales call objections and closed-lost reasons.</span>
        </div>
      </div>
    </section>

    <!-- Relevant Case Study Link -->
    <div class="my-8 p-6 rounded-2xl border border-green-200 bg-green-50/50 flex flex-wrap items-center justify-between gap-4">
      <div>
        <span class="text-[11px] font-mono uppercase text-green-700 font-semibold">Production Example</span>
        <h3 class="text-lg font-bold text-slate-900 mt-1">Mavlers Agency Multi-Signal Motion</h3>
        <p class="text-xs text-slate-600">See how technical PPC & partner signals combined into a custom HubSpot pipeline.</p>
      </div>
      <a href="/work/mavlers-partner-agency-signals" class="inline-flex items-center justify-center px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-xs font-semibold rounded-lg shadow-sm transition-all">
        Read Case Study →
      </a>
    </div>
  </div>
</BaseLayout>
