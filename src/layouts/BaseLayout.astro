---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article' | 'profile';
  publishedDate?: Date;
  updatedDate?: Date;
  breadcrumbs?: { name: string; url: string }[];
  schemaType?: 'Person' | 'Article' | 'HowTo' | 'FAQPage' | 'DefinedTermSet' | 'DefinedTerm' | 'WebPage';
  faq?: { q: string; a: string }[];
  howToSteps?: { title: string; body: string }[];
}

const props = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Plus Jakarta Sans and JetBrains Mono + Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
      rel="stylesheet"
    />

    <!-- SEO & Metadata -->
    <SEO {...props} />
  </head>
  <body class="text-slate-900 min-h-screen flex flex-col font-sans selection:bg-[#acedff] selection:text-[#001f26]">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-[#1d6ff2] focus:text-white font-semibold"
    >
      Skip to main content
    </a>

    <Header />

    <main id="main-content" class="flex-1 w-full max-w-[1160px] mx-auto px-4 sm:px-6 py-6 sm:py-8">
      <slot />
    </main>

    <Footer />
  </body>
</html>
