---
const workflows = [
  { title: 'HubSpot lead scoring & routing', slug: 'hubspot-lead-scoring', description: 'Separate fit and engagement scores, MQL thresholds agreed with sales, and automatic stage changes, owners and follow-up.', tools: 'HubSpot · Clay · n8n' },
  { title: 'Waterfall enrichment agent', slug: 'waterfall-enrichment', description: 'Queries data providers in order until a field is filled with a verified value, then writes it back to HubSpot with its source.', tools: 'Clay · Apollo · n8n' },
  { title: 'Website visitors to HubSpot', slug: 'website-visitors-to-hubspot', description: 'Flags high-intent visits at account level with Zoho SalesIQ, scores them against the ICP and routes qualified accounts into HubSpot.', tools: 'Zoho SalesIQ · HubSpot · n8n' },
];
---

<section class="relative w-full rounded-[28px] sm:rounded-[36px] overflow-hidden bg-[#000000] border border-zinc-800 p-6 sm:p-10 lg:p-12 text-white shadow-2xl flex flex-col gap-8 sm:gap-10" aria-labelledby="library-heading">
  <!-- Section Header -->
  <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 pb-4 border-b border-zinc-800/80">
    <div class="flex flex-col gap-1.5">
      <span class="text-[12px] font-bold text-[#d2f39c] tracking-widest uppercase font-mono">
        My Library.
      </span>
      <h2 id="library-heading" class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        GTM automation workflows I build
      </h2>
    </div>

    <!-- Production Deployments Pill -->
    <span class="px-4 py-1.5 rounded-full bg-[#000000] border border-zinc-800 text-[11px] font-mono font-semibold uppercase tracking-wider text-zinc-300">
      PRODUCTION DEPLOYMENTS
    </span>
  </div>

  <!-- Workflows Grid: Black Container Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {workflows.map((wf) => (
      <a
        href={`/workflows/${wf.slug}`}
        class="p-7 rounded-[22px] bg-[#000000] hover:bg-zinc-950 border border-zinc-800 hover:border-zinc-700 transition-all flex flex-col justify-between gap-6 group shadow-lg"
      >
        <div class="flex flex-col gap-3">
          <h3 class="text-white text-[18px] font-bold tracking-tight group-hover:text-[#d2f39c] transition-colors">
            {wf.title}
          </h3>
          <p class="text-zinc-400 text-[13px] sm:text-[14px] leading-relaxed font-light">
            {wf.description}
          </p>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-zinc-900">
          <span class="px-3 py-1 rounded-full bg-[#000000] border border-zinc-800 text-[11px] font-mono text-zinc-300">
            {wf.tools}
          </span>
          <div class="w-8 h-8 rounded-full bg-zinc-900 group-hover:bg-[#d2f39c] flex items-center justify-center text-zinc-400 group-hover:text-black transition-all">
            <svg class="w-4 h-4 transition-transform group-hover:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
