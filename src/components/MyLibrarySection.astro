---
import { getCollection } from 'astro:content';

const allWorkflows = await getCollection('workflows');

const outboundPriority = ['website-signal-to-outbound-engine', 'clay-waterfall-enrichment'];

const outboundWorkflows = allWorkflows

  .sort((a, b) => {
    const aSlug = a.data.slug || a.id;
    const bSlug = b.data.slug || b.id;
    const aIdx = outboundPriority.indexOf(aSlug);
    const bIdx = outboundPriority.indexOf(bSlug);
    if (aIdx !== -1 && bIdx !== -1) return aIdx - bIdx;
    if (aIdx !== -1) return -1;
    if (bIdx !== -1) return 1;
    return 0;
  })
  .slice(0, 3); // Display top 3 Outbound systems, pinned order first

---

<section class="w-full bg-[var(--bg)] text-zinc-950 border-b border-zinc-200" aria-labelledby="library-heading">
  <!-- Inner Container: main heading now lives inside the same dark section as the cards -->
  <div class="w-full pt-14 sm:pt-20 pb-24 sm:pb-36 px-4 sm:px-6 lg:px-12">
    <div class="max-w-[1360px] mx-auto flex flex-col gap-16 sm:gap-24">

      <!-- Section Main Header (integrated, not a separate block) -->
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 pb-6 border-b border-zinc-200">
        <div class="flex flex-col gap-1.5">
          <span class="text-xs font-bold text-zinc-600 tracking-widest uppercase font-mono">
            CRM automation, lead routing, account enrichment, and AI workflows with human review
          </span>
          <h2 id="library-heading" class="text-2xl sm:text-3xl lg:text-[44px] font-extrabold text-zinc-950 tracking-tight leading-tight font-display">
            GTM workflows and <span class="heading-highlight">notes from the build.</span>
          </h2>
        </div>

        <!-- View All Workflows CTA -->
        <a
          href="/workflows"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#eef3ff] hover:bg-[#dce7ff] text-zinc-950 text-xs font-bold tracking-wider transition-all font-display whitespace-nowrap shrink-0 shadow-sm"
        >
          <span>Explore workflows</span>
          <svg class="w-3.5 h-3.5 text-zinc-950" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>

      <p class="max-w-2xl text-sm text-zinc-600">Each walkthrough explains the trigger, the decision the workflow makes, and what reaches the team that owns the next step. <a class="font-bold text-[#315bd6] underline" href="/blog">Read the blog</a></p>

      <!-- SUB-SECTION 1: OUTBOUND SYSTEMS -->
      <div class="flex flex-col gap-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-5 border-b border-zinc-200">
          <div class="flex items-start gap-4">
            <!-- Icon Badge for Outbound -->
            <div class="p-3 rounded-2xl bg-[#eef3ff] border border-zinc-200 text-[#315bd6] shrink-0 mt-1">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#315bd6]">GTM & Prospecting</span>
              </div>
              <h3 class="text-2xl sm:text-3xl lg:text-[36px] font-semibold text-zinc-950 tracking-tight font-display">
                Outbound GTM Systems
              </h3>
              <p class="text-sm sm:text-base font-semibold text-zinc-600 mt-1 font-sans">
                Signal enrichment, prospecting & response routing engines
              </p>
            </div>
          </div>
          <span class="text-xs font-mono text-zinc-600 font-medium shrink-0">3 featured engines</span>
        </div>

        <!-- Outbound Cards Grid (3 green cards + 1 visible blurred preview card) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {outboundWorkflows.map((wf) => {
            const slug = wf.data.slug || wf.id;
            const isConstrained = slug.includes('enrichment') || slug.includes('watcher');
            
            let statusLabel = 'Live';
            if (wf.data.status === 'draft') {
              statusLabel = 'Build note';
            } else if (isConstrained) {
              statusLabel = 'Constrained';
            }

            return (
              <a
                href={`/workflows/${slug}`}
                class="bg-white hover:border-[#91aeff] border border-zinc-200 p-7 sm:p-8 rounded-[24px] flex flex-col justify-between gap-6 group transition-colors"
              >
                <div>
                  <div class="flex items-center justify-between text-xs font-mono mb-4">
                    <span class="flex items-center gap-1.5 text-zinc-950 font-black uppercase tracking-wider text-[11px]">
                      <svg class="w-3.5 h-3.5 text-zinc-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                      </svg>
                      Outbound
                    </span>
                    <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider ${
                      statusLabel === 'Build note'
                        ? 'bg-zinc-800 text-zinc-200 border border-zinc-700'
                        : statusLabel === 'Constrained'
                        ? 'bg-amber-900 text-amber-100 border border-amber-800'
                        : 'bg-[#eef3ff] text-[#284cba]'
                    }`}>
                      {statusLabel}
                    </span>
                  </div>
                  
                  <h4 class="text-xl sm:text-2xl font-semibold text-zinc-950 group-hover:text-black transition-colors mb-3 leading-snug font-display">
                    {wf.data.title}
                  </h4>

                  <!-- Tool Pills placed BETWEEN Title and Description -->
                  <div class="flex flex-wrap gap-1.5 mb-4">
                    {wf.data.tools.slice(0, 3).map((tool) => (
                      <span class="px-2.5 py-1 rounded-md bg-[#eef3ff] text-zinc-950 font-mono text-[11px] font-bold border border-zinc-200">
                        {tool}
                      </span>
                    ))}
                    {wf.data.tools.length > 3 && (
                      <span class="px-2 py-1 rounded-md bg-[#eef3ff] text-zinc-800 font-mono text-[11px] font-bold">
                        +{wf.data.tools.length - 3}
                      </span>
                    )}
                  </div>

                  <p class="text-xs sm:text-sm text-zinc-900 font-medium leading-relaxed line-clamp-3 opacity-95">
                    {wf.data.description}
                  </p>
                </div>

                <div class="pt-4 border-t border-zinc-200 flex items-center justify-between">
                  <span class="text-zinc-950 font-black text-xs font-mono uppercase tracking-wider group-hover:translate-x-1.5 transition-transform flex items-center gap-1.5">
                    View system →
                  </span>
                </div>
              </a>
            );
          })}

          <div class="flex flex-col items-start justify-center gap-4 rounded-2xl border border-zinc-200 bg-white p-7">
            <h4 class="text-xl font-semibold text-zinc-950">Workflow library</h4>
            <p class="text-sm leading-relaxed text-zinc-600">Browse the systems behind account research, qualification, and follow-up.</p>
            <a href="/workflows" class="text-sm font-semibold text-[#315bd6] underline underline-offset-4">Explore all workflows</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
