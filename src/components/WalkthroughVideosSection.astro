---
// Walkthrough Videos Section
const videos = [
  {
    title: 'Clay Waterfall Pipeline Engine',
    category: 'ENRICHMENT',
    description: 'Multi-provider cascading validation from Apollo to Clay with automated deduplication.',
  },
  {
    title: 'HubSpot SLA Routing Rules',
    category: 'REVOPS ARCHITECTURE',
    description: 'Lead assignment round-robin and MQL-to-SQL stage progression across rep queues.',
  },
  {
    title: 'Slack Human Approval Gate Agent',
    category: 'AI AGENTS',
    description: 'Autonomous research and draft generation paused for single-click editorial approval in Slack.',
  },
  {
    title: 'Real-Time Intent Ingestion & Scoring',
    category: 'SIGNALS',
    description: 'Live visitor identification triggered directly into personalized SDR sequence drafts.',
  },
];
---

<section class="w-full bg-white text-zinc-900 py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-12 border-b border-zinc-200" aria-labelledby="videos-heading">
  <div class="max-w-[1360px] mx-auto flex flex-col gap-8">
    <!-- Section Header -->
    <div class="flex items-center justify-between pb-6 border-b border-zinc-200 mb-2">
      <div class="flex flex-col gap-1.5">
        <span class="text-xs font-bold text-zinc-500 tracking-widest uppercase font-mono">
          Outbound GTM and AI citation tracking walkthroughs
        </span>
        <h2 id="videos-heading" class="text-2xl sm:text-3xl lg:text-[44px] font-extrabold text-zinc-950 tracking-tight leading-tight font-display">
          Walkthrough <span class="heading-highlight">Reels.</span>
        </h2>
      </div>

      <span class="text-zinc-500 text-xs font-mono font-bold tracking-widest uppercase">
        SYSTEM DEMOS
      </span>
    </div>

    <!-- Video Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {videos.map((vid) => (
        <div class="bento-card aspect-[9/14] rounded-[24px] p-5 sm:p-6 flex flex-col justify-between relative overflow-hidden group hover:border-[#d2f39c]/40 transition-all">
          <!-- Subtle Schematic Lines -->
          <div class="absolute inset-0 opacity-10 pointer-events-none group-hover:opacity-20 transition-opacity">
            <svg class="w-full h-full" viewBox="0 0 200 350" fill="none" xmlns="http://www.w3.org/2000/svg">
              <line x1="20" y1="50" x2="180" y2="50" stroke="#d2f39c" stroke-dasharray="4 4" stroke-width="1.5" />
              <line x1="20" y1="120" x2="180" y2="120" stroke="white" stroke-dasharray="2 4" stroke-width="1" />
              <circle cx="100" cy="175" r="45" stroke="#d2f39c" stroke-width="1" stroke-dasharray="6 6" />
              <rect x="30" y="240" width="140" height="60" rx="10" stroke="white" stroke-width="1" />
            </svg>
          </div>

          <!-- Top Badge: Category -->
          <div class="relative z-10 flex items-center justify-between">
            <span class="px-2.5 py-1 rounded-md bg-zinc-900 border border-zinc-800 text-xs font-mono font-bold text-[#d2f39c] tracking-wider uppercase">
              {vid.category}
            </span>
          </div>

          <!-- Center: Play Button -->
          <div class="relative z-10 flex items-center justify-center my-auto">
            <div class="w-14 h-14 rounded-full bg-zinc-900 group-hover:bg-[#d2f39c] border border-zinc-800 group-hover:border-transparent flex items-center justify-center text-zinc-300 group-hover:text-black transition-all duration-300 shadow-2xl group-hover:scale-110 cursor-pointer">
              <svg class="w-6 h-6 translate-x-0.5" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
            </div>
          </div>

          <!-- Bottom: Title & Description -->
          <div class="relative z-10 flex flex-col gap-1.5 pt-4 border-t border-zinc-800/85">
            <h3 class="text-white text-[15px] sm:text-[16px] font-bold group-hover:text-[#d2f39c] transition-colors leading-snug font-display">
              {vid.title}
            </h3>
            <p class="text-zinc-300 text-xs leading-relaxed font-normal line-clamp-2">
              {vid.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
