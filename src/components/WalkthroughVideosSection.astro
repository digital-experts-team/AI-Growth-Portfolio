---
// Walkthrough Videos Section - Pure Solid Super Black (No Gradients)
const videos = [
  {
    title: 'Clay Waterfall Pipeline Engine',
    duration: '04:12',
    category: 'ENRICHMENT',
    description: 'Multi-provider cascading validation from Apollo to Hunter with automated deduplication.',
  },
  {
    title: 'HubSpot Zero-Leak Routing Rules',
    duration: '03:45',
    category: 'REVOPS ARCHITECTURE',
    description: 'Lead assignment round-robin and MQL-to-SQL stage progression with zero dropped accounts.',
  },
  {
    title: 'Slack Human Approval Gate Agent',
    duration: '05:20',
    category: 'AI AGENTS',
    description: 'Autonomous research and draft generation paused for single-click editorial approval in Slack.',
  },
  {
    title: 'Real-Time Intent Ingestion & Scoring',
    duration: '04:50',
    category: 'SIGNALS',
    description: 'Live visitor identification triggered directly into personalized SDR sequence drafts.',
  },
];
---

<section class="flex flex-col gap-6 bg-[#000000]" aria-labelledby="videos-heading">
  <!-- Section Header -->
  <div class="flex items-center justify-between">
    <div class="flex flex-col gap-1.5">
      <span class="text-[12px] font-bold text-[#d2f39c] tracking-widest uppercase font-mono">
        Walkthroughs Videos
      </span>
      <h2 id="videos-heading" class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        GTM system walkthrough videos
      </h2>
    </div>

    <span class="text-zinc-500 text-[11px] font-mono tracking-widest uppercase">
      NO PLACEHOLDERS
    </span>
  </div>

  <!-- Video Grid: 4 Tall Cards in Solid Super Black -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    {videos.map((vid) => (
      <div class="aspect-[9/15] rounded-[24px] bg-[#000000] hover:bg-zinc-950 border border-zinc-800 hover:border-zinc-700 transition-all duration-300 p-5 sm:p-6 flex flex-col justify-between relative overflow-hidden group shadow-xl">
        <!-- Subtle Schematic Lines (No Gradients) -->
        <div class="absolute inset-0 opacity-15 pointer-events-none group-hover:opacity-25 transition-opacity">
          <svg class="w-full h-full" viewBox="0 0 200 350" fill="none" xmlns="http://www.w3.org/2000/svg">
            <line x1="20" y1="50" x2="180" y2="50" stroke="#d2f39c" stroke-dasharray="4 4" stroke-width="1.5" />
            <line x1="20" y1="120" x2="180" y2="120" stroke="white" stroke-dasharray="2 4" stroke-width="1" />
            <circle cx="100" cy="175" r="45" stroke="#d2f39c" stroke-width="1" stroke-dasharray="6 6" />
            <rect x="30" y="240" width="140" height="60" rx="10" stroke="white" stroke-width="1" />
          </svg>
        </div>

        <!-- Top Badge: Category & Duration -->
        <div class="relative z-10 flex items-center justify-between">
          <span class="px-2.5 py-1 rounded-full bg-[#000000] border border-zinc-800 text-[10px] font-mono font-semibold text-[#d2f39c] tracking-wider uppercase">
            {vid.category}
          </span>
          <span class="px-2.5 py-1 rounded-full bg-[#000000] border border-zinc-800 text-[11px] font-mono text-zinc-400">
            {vid.duration}
          </span>
        </div>

        <!-- Center: Play Button -->
        <div class="relative z-10 flex items-center justify-center my-auto">
          <div class="w-14 h-14 rounded-full bg-zinc-900 group-hover:bg-[#d2f39c] border border-zinc-700 group-hover:border-transparent flex items-center justify-center text-white group-hover:text-black transition-all duration-300 shadow-2xl group-hover:scale-110 cursor-pointer">
            <svg class="w-6 h-6 translate-x-0.5" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
          </div>
        </div>

        <!-- Bottom: Title & Description -->
        <div class="relative z-10 flex flex-col gap-1.5 pt-4 border-t border-zinc-900">
          <h3 class="text-white text-[15px] sm:text-[16px] font-bold group-hover:text-[#d2f39c] transition-colors leading-snug">
            {vid.title}
          </h3>
          <p class="text-zinc-400 text-[12px] leading-relaxed line-clamp-2">
            {vid.description}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
