      </div>
    </div>

    <!-- Bottom Row: Copyright on Left, Architecture Badge on Right -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-6 border-t border-zinc-900/80 text-[11px] font-mono text-zinc-600">
      <span>© {currentYear} Tibin Jacob. All rights reserved.</span>
      <span class="text-[#b4f04d]/70 tracking-widest uppercase">PRECISION-GRADE ARCHITECTURE</span>
    </div>
  </div>
</footer>
