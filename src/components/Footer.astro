---
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-[var(--surface-border)] bg-black py-12 text-sm text-gray-400">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: Bio -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-[var(--accent)]"></span>
          <span class="font-display font-semibold text-white tracking-tight text-base">
            Tibin Jacob
          </span>
          <span class="text-xs font-mono text-gray-500">· Bengaluru, IN</span>
        </div>
        <p class="text-xs sm:text-sm text-gray-400 leading-relaxed max-w-sm">
          GTM Engineer with 4+ years architecting signal-based outbound, waterfall enrichment, and RevOps data routing across Clay, n8n, and HubSpot.
        </p>
        <div class="pt-2">
          <a
            href="mailto:tibin.jacob.uiux@gmail.com"
            class="text-xs font-mono text-[var(--accent)] hover:underline inline-flex items-center gap-1"
          >
            tibin.jacob.uiux@gmail.com
          </a>
        </div>
      </div>

      <!-- Col 2: Architecture & Content -->
      <div>
        <h4 class="text-xs font-mono uppercase tracking-wider text-white font-semibold mb-3">
          Architecture
        </h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/work" class="hover:text-white transition-colors">Case Studies</a></li>
          <li><a href="/workflows" class="hover:text-white transition-colors">Workflow Schematics</a></li>
          <li><a href="/blog" class="hover:text-white transition-colors">RevOps & GTM Articles</a></li>
          <li><a href="/glossary" class="hover:text-white transition-colors">AEO GTM Glossary</a></li>
          <li><a href="/demand" class="hover:text-white transition-colors">Demand Generation Hub</a></li>
        </ul>
      </div>

      <!-- Col 3: Machine & Discovery Endpoints -->
      <div>
        <h4 class="text-xs font-mono uppercase tracking-wider text-white font-semibold mb-3">
          Index & Verification
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="https://www.linkedin.com/in/tibinjacob" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
              LinkedIn Profile
            </a>
          </li>
          <li>
            <a href="https://github.com/digital-experts-team" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
              GitHub Repositories
            </a>
          </li>
          <li><a href="/sitemap-index.xml" class="hover:text-white transition-colors">XML Sitemap</a></li>
          <li><a href="/rss.xml" class="hover:text-white transition-colors">RSS Feed</a></li>
          <li><a href="/llms.txt" class="hover:text-white transition-colors font-mono">/llms.txt (GEO Endpoint)</a></li>
          <li><a href="/hire" class="text-[var(--accent)] font-medium hover:underline">Hire Me / 30-60-90</a></li>
        </ul>
      </div>
    </div>

    <div class="pt-6 border-t border-[var(--surface-border)] flex flex-col sm:flex-row items-center justify-between text-xs text-gray-500 gap-4">
      <p>© {currentYear} Tibin Jacob. Built static-first with Astro 5, optimized for SEO, AEO, and GEO.</p>
      <p class="font-mono text-[11px]">Strict Signal-to-Pipeline Flow Discipline</p>
    </div>
  </div>
</footer>
