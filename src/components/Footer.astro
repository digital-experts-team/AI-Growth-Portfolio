<footer class="w-full bg-[#000000] border-t border-zinc-900/80 pt-16 pb-12 text-zinc-400">
  <div class="max-w-[1360px] mx-auto px-6 sm:px-10 lg:px-12 flex flex-col gap-10">
    <!-- Top Row: Identity on Left, Nav Links on Right -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="flex flex-col gap-1.5">
        <span class="text-white text-[15px] sm:text-[16px] font-bold tracking-tight">
          Tibin Jacob. GTM Engineer & AI growth for B2B
        </span>
        <span class="text-[12px] sm:text-[13px] text-zinc-500 font-mono">
          Bengaluru, working with US and European hours
        </span>
      </div>

      <div class="flex flex-wrap items-center gap-5 sm:gap-7 text-[11px] font-mono tracking-wider uppercase text-zinc-400">
        <a class="hover:text-white transition-colors" href="mailto:tibin.jacob.uiux@gmail.com">EMAIL</a>
        <a class="hover:text-white transition-colors" href="https://www.linkedin.com/in/tibinjacob" target="_blank" rel="noopener noreferrer">LINKEDIN</a>
