---
export interface Props {
  trigger: string;
  tools: string[];
  steps: { title: string; body: string }[];
  output: string;
}

const { trigger, tools, steps, output } = Astro.props;
---

<div class="workflow-diagram my-8 p-6 rounded-2xl border border-slate-200/90 bg-white shadow-sm overflow-x-auto">
  <div class="text-xs font-mono uppercase tracking-wider text-slate-500 mb-6 flex items-center justify-between">
    <span>Architecture Schematic (Deterministic Signal Flow)</span>
    <span class="text-[#1748d1] bg-[#e8f1ff] border border-[#c7ddff] px-2 py-0.5 rounded text-[11px] font-semibold">
      Zero-Human Manual Routing
    </span>
  </div>

  <div class="min-w-[620px] flex items-center justify-between gap-3 relative py-4">
    <!-- Trigger Node -->
    <div class="w-44 p-3.5 rounded-xl border border-slate-200 bg-slate-50 shrink-0">
      <div class="text-[10px] font-mono text-[#1e5eff] uppercase mb-1 font-semibold">Trigger Event</div>
      <div class="text-xs font-semibold text-slate-900 leading-snug">{trigger}</div>
    </div>

    <!-- Connector 1 -->
    <div class="flex-1 flex items-center justify-center relative min-w-[36px]">
      <div class="h-[2px] w-full bg-gradient-to-r from-[#6fa8ff] to-[#1e5eff]"></div>
      <div class="absolute right-0 w-2 h-2 border-t-2 border-r-2 border-[#1e5eff] rotate-45"></div>
    </div>

    <!-- Processing & Logic Nodes -->
    {steps.slice(0, 2).map((s, idx) => (
      <>
        <div class="w-48 p-3.5 rounded-xl border border-[#c7ddff] bg-[#e8f1ff]/50 shrink-0">
          <div class="text-[10px] font-mono text-slate-500 uppercase mb-1 font-semibold">Step 0{idx + 1} Logic</div>
          <div class="text-xs font-semibold text-slate-900 leading-snug">{s.title}</div>
        </div>
        <div class="flex-1 flex items-center justify-center relative min-w-[36px]">
          <div class="h-[2px] w-full bg-gradient-to-r from-[#1e5eff] to-[#1748d1]"></div>
          <div class="absolute right-0 w-2 h-2 border-t-2 border-r-2 border-[#1748d1] rotate-45"></div>
        </div>
      </>
    ))}

    <!-- Output / CRM Node -->
    <div class="w-44 p-3.5 rounded-xl border border-[#c7ddff] bg-[#e8f1ff]/50 shrink-0">
      <div class="text-[10px] font-mono text-[#1748d1] uppercase mb-1 font-semibold">CRM Target</div>
      <div class="text-xs font-semibold text-slate-900 leading-snug">{output}</div>
    </div>
  </div>

  <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap gap-2 items-center text-xs">
    <span class="text-slate-500 font-mono">Engineered Stack:</span>
    {tools.map(tool => (
      <span class="px-2 py-0.5 rounded bg-slate-100 border border-slate-200 text-slate-700 font-mono text-[11px]">
        {tool}
      </span>
    ))}
  </div>
</div>
