---
export interface Props {
  trigger: string;
  tools: string[];
  steps: { title: string; body: string }[];
  output: string;
}

const { trigger, tools, steps, output } = Astro.props;
---

<div class="workflow-diagram my-8 p-6 rounded-2xl border border-[var(--surface-border)] bg-[var(--surface)] overflow-x-auto">
  <div class="text-xs font-mono uppercase tracking-wider text-gray-400 mb-6 flex items-center justify-between">
    <span>Architecture Schematic (Deterministic Signal Flow)</span>
    <span class="text-[var(--accent)] bg-[var(--accent)]/10 px-2 py-0.5 rounded text-[11px]">
      Zero-Human Manual Routing
    </span>
  </div>

  <div class="min-w-[620px] flex items-center justify-between gap-3 relative py-4">
    <!-- Trigger Node -->
    <div class="w-44 p-3.5 rounded-xl border border-white/10 bg-[var(--surface-elevated)] shrink-0">
      <div class="text-[10px] font-mono text-[var(--accent)] uppercase mb-1">Trigger Event</div>
      <div class="text-xs font-semibold text-white leading-snug">{trigger}</div>
    </div>

    <!-- Connector 1 -->
    <div class="flex-1 flex items-center justify-center relative min-w-[36px]">
      <div class="h-[2px] w-full signal-flow-line"></div>
      <div class="absolute right-0 w-2 h-2 border-t-2 border-r-2 border-[var(--accent-light)] rotate-45"></div>
    </div>

    <!-- Processing & Logic Nodes -->
    {steps.slice(0, 2).map((s, idx) => (
      <>
        <div class="w-48 p-3.5 rounded-xl border border-[var(--accent)]/30 bg-[var(--surface-elevated)] shrink-0">
          <div class="text-[10px] font-mono text-gray-400 uppercase mb-1">Step 0{idx + 1} Logic</div>
          <div class="text-xs font-semibold text-white leading-snug">{s.title}</div>
        </div>
        <div class="flex-1 flex items-center justify-center relative min-w-[36px]">
          <div class="h-[2px] w-full signal-flow-line"></div>
          <div class="absolute right-0 w-2 h-2 border-t-2 border-r-2 border-[var(--accent-light)] rotate-45"></div>
        </div>
      </>
    ))}

    <!-- Output / CRM Node -->
    <div class="w-44 p-3.5 rounded-xl border border-white/10 bg-[var(--surface-elevated)] shrink-0">
      <div class="text-[10px] font-mono text-emerald-400 uppercase mb-1">CRM Target</div>
      <div class="text-xs font-semibold text-white leading-snug">{output}</div>
    </div>
  </div>

  <div class="mt-4 pt-3 border-t border-[var(--surface-border)] flex flex-wrap gap-2 items-center text-xs">
    <span class="text-gray-400 font-mono">Engineered Stack:</span>
    {tools.map(tool => (
      <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-gray-300 font-mono text-[11px]">
        {tool}
      </span>
    ))}
  </div>
</div>
