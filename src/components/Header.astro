---
export interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;

const navLinks = [
  { name: 'Work', href: '/work' },
  { name: 'Workflows', href: '/workflows' },
  { name: 'Writing', href: '/blog' },
  { name: 'About', href: '/about' },
];

const currentPath = Astro.url.pathname;
---

<header
  class={`w-full z-50 transition-all duration-300 ${
    transparent
      ? 'absolute top-0 left-0 bg-transparent border-transparent'
      : 'sticky top-0 backdrop-blur-md bg-white/90 border-b border-slate-100/80'
  }`}
>
  <div class="h-20 max-w-[1160px] mx-auto px-4 sm:px-6 flex items-center justify-between">
    <a
      href="/"
      class={`font-bold tracking-tight flex items-center gap-2 text-[16px] group transition-colors ${
        transparent ? 'text-white' : 'text-slate-900'
      }`}
    >
      <span
        class={`w-2.5 h-2.5 rounded-full transition-transform group-hover:scale-125 ${
          transparent ? 'bg-[#d2f39c] shadow-[0_0_12px_rgba(210,243,156,0.9)]' : 'bg-cyan-500'
        }`}
      ></span>
      <span>Tibin Jacob{transparent ? <span class="text-[#d2f39c]">.</span> : ''}</span>
    </a>

    <div class="flex items-center gap-6">
      <nav class="hidden md:flex items-center gap-7" aria-label="Primary Navigation">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`text-[13px] uppercase tracking-[0.14em] font-medium transition-colors ${
                transparent
                  ? isActive
                    ? 'text-[#d2f39c] font-semibold'
                    : 'text-white/80 hover:text-white'
                  : isActive
                    ? 'text-cyan-600 font-semibold'
                    : 'text-slate-600 hover:text-slate-900'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <a
        href="https://wa.me/918129917227?text=Hi%20Tibin,%20interested%20in%20discussing%20GTM%20and%20product%20architecture"
        target="_blank"
        rel="noopener noreferrer"
        class={`inline-flex items-center justify-center px-5 py-2.5 rounded-full text-[12px] font-bold uppercase tracking-[0.15em] transition-all shadow-sm active:scale-95 ${
          transparent
            ? 'bg-white/10 hover:bg-white/20 border border-white/20 text-white backdrop-blur-md hover:border-white/40'
            : 'bg-[#1d6ff2] hover:bg-blue-600 text-white'
        }`}
      >
        WhatsApp
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-nav-toggle"
        class={`md:hidden p-2 rounded-xl border transition-all ${
          transparent
            ? 'text-white border-white/20 bg-white/10 backdrop-blur-md'
            : 'text-slate-600 hover:text-slate-900 border-slate-200 bg-white'
        }`}
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div
    id="mobile-nav-menu"
    class={`hidden md:hidden border-b px-5 pt-3 pb-6 space-y-3 transition-all ${
      transparent
        ? 'bg-black/95 border-white/10 text-white backdrop-blur-2xl'
        : 'bg-white border-slate-200 text-slate-900'
    }`}
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class={`block px-3 py-2 rounded-lg text-sm font-semibold tracking-wider uppercase ${
          transparent
            ? 'text-white/80 hover:text-white hover:bg-white/10'
            : 'text-slate-700 hover:text-cyan-600 hover:bg-slate-50'
        }`}
      >
        {link.name}
      </a>
    ))}
    <div
      class={`pt-3 border-t flex gap-4 text-xs font-mono px-3 ${
        transparent ? 'border-white/10 text-slate-400' : 'border-slate-100 text-slate-500'
      }`}
    >
      <a href="/glossary" class={transparent ? 'hover:text-white' : 'hover:text-slate-900'}>Glossary</a>
      <a href="/demand" class={transparent ? 'hover:text-white' : 'hover:text-slate-900'}>Demand</a>
      <a href="/hire" class={transparent ? 'hover:text-white' : 'hover:text-slate-900'}>Hire Me</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const menu = document.getElementById('mobile-nav-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
    });
  }
</script>
