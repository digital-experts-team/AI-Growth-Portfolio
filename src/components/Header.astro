---
export interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;

const navLinks = [
  { name: 'EXPERIENCE', href: '/work' },
  { name: 'WORKFLOWS', href: '/workflows' },
  { name: 'ARTICLES', href: '/blog' },
  { name: 'LAB', href: '/lab' },
  { name: 'BRIEFING', href: '/briefing' },
  { name: 'ABOUT', href: '/about' },
];

const currentPath = Astro.url.pathname;
---

<header
  class={`w-full z-50 transition-all duration-300 ${
    transparent
      ? 'absolute top-0 left-0 bg-transparent border-transparent text-white'
      : 'sticky top-0 backdrop-blur-md bg-white/95 border-b border-zinc-200 text-zinc-900 shadow-xs'
  }`}
>
  <div class="h-20 sm:h-24 max-w-[1360px] mx-auto px-6 sm:px-10 lg:px-12 flex items-center justify-between">
    <!-- Brand Logo -->
    <a
      href="/"
      class={`font-bold tracking-tight text-[18px] sm:text-[20px] lg:text-[22px] transition-colors shrink-0 ${
        transparent
          ? 'text-white hover:text-[#d2f39c]'
          : 'text-zinc-900 hover:text-green-600'
      }`}
    >
      Tibin Jacob<span class={transparent ? 'text-[#d2f39c]' : 'text-green-600'}>.</span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-5 xl:gap-8 whitespace-nowrap" aria-label="Primary Navigation">
      {navLinks.map((link) => {
        const isActive = currentPath.startsWith(link.href);
        return (
          <a
            href={link.href}
            class={`text-[11px] xl:text-[12px] font-bold tracking-[0.12em] xl:tracking-[0.16em] uppercase transition-colors whitespace-nowrap shrink-0 ${
              isActive
                ? transparent
                  ? 'text-[#d2f39c] underline decoration-[#d2f39c] underline-offset-6 decoration-2'
                  : 'text-green-600 underline decoration-green-600 underline-offset-6 decoration-2'
                : transparent
                ? 'text-zinc-300 hover:text-white'
                : 'text-zinc-600 hover:text-zinc-950'
            }`}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    <!-- Right Actions: WhatsApp & Hire Me -->
    <div class="flex items-center gap-3 sm:gap-3.5">
      <!-- WhatsApp Button -->
      <a
        href="https://wa.me/918129917227?text=Hi%20Tibin,%20interested%20in%20discussing%20GTM%20and%20AI%20Growth%20systems"
        target="_blank"
        rel="noopener noreferrer"
        class={`inline-flex items-center gap-2 px-4 sm:px-5 py-2 sm:py-2.5 rounded-full text-[11px] sm:text-[12px] font-bold tracking-wider uppercase transition-all active:scale-95 border shadow-sm ${
          transparent
            ? 'bg-[#1a1b1e] hover:bg-zinc-800 text-white border-zinc-700/80'
            : 'bg-white hover:bg-zinc-50 text-zinc-950 border-zinc-200'
        }`}
      >
        <span>WHATSAPP</span>
        <svg
          class={`w-3.5 h-3.5 ${transparent ? 'text-zinc-300' : 'text-zinc-500'}`}
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>

      <!-- Hire Me Button -->
      <a
        href="/hire"
        class="inline-flex items-center gap-1.5 px-5 sm:px-6 py-2 sm:py-2.5 rounded-full text-[12px] sm:text-[13px] font-extrabold text-black bg-[#d2f39c] hover:bg-[#c2e887] shadow-sm transition-all active:scale-95"
      >
        <span>Hire me</span>
        <svg
          class="w-3.5 h-3.5 text-black"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-nav-toggle"
        class={`lg:hidden p-2 rounded-xl border transition-all ${
          transparent
            ? 'border-zinc-800 bg-[#1a1b1e] text-white hover:text-[#d2f39c]'
            : 'border-zinc-200 bg-white text-zinc-900 hover:text-green-600'
        }`}
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div
    id="mobile-nav-menu"
    class={`hidden lg:hidden border-b px-6 pt-4 pb-6 space-y-3 transition-all ${
      transparent
        ? 'border-zinc-800 bg-[#121316] text-white'
        : 'border-zinc-200 bg-white text-zinc-900'
    }`}
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class={`block px-3 py-2 rounded-lg text-sm font-bold tracking-wider uppercase ${
          transparent
            ? 'text-zinc-200 hover:text-[#d2f39c] hover:bg-zinc-900'
            : 'text-zinc-700 hover:text-black hover:bg-zinc-100'
        }`}
      >
        {link.name}
      </a>
    ))}
    <div
      class={`pt-4 border-t flex flex-wrap gap-4 text-xs font-mono px-3 ${
        transparent
          ? 'border-zinc-800 text-zinc-400'
          : 'border-zinc-200 text-zinc-500'
      }`}
    >
      <a href="/glossary" class={transparent ? 'hover:text-[#d2f39c]' : 'hover:text-green-600'}>Glossary</a>
      <a href="/demand" class={transparent ? 'hover:text-[#d2f39c]' : 'hover:text-green-600'}>Demand</a>
      <a href="/hire" class={transparent ? 'hover:text-[#d2f39c]' : 'hover:text-green-600'}>Hire Me</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const menu = document.getElementById('mobile-nav-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
    });
  }
</script>
