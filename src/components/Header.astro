---
export interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;

const navLinks = [
  { name: 'WORK', href: '/work' },
  { name: 'WORKFLOWS', href: '/workflows' },
  { name: 'AI SEARCH', href: '/demand' },
  { name: 'PERFORMANCE', href: '/revops' },
  { name: 'ABOUT', href: '/about' },
];

const currentPath = Astro.url.pathname;
---

<header
  class={`w-full z-50 transition-all duration-300 ${
    transparent
      ? 'absolute top-0 left-0 bg-[#000000]/0 border-transparent'
      : 'sticky top-0 backdrop-blur-md bg-white/95 border-b border-slate-100'
  }`}
>
  <div class="h-20 sm:h-24 max-w-[1360px] mx-auto px-6 sm:px-10 lg:px-12 flex items-center justify-between">
    <!-- Brand Logo -->
    <a
      href="/"
      class={`font-bold tracking-tight text-[20px] sm:text-[22px] transition-colors ${
        transparent ? 'text-white' : 'text-slate-900'
      }`}
    >
      Tibin Jacob<span class="text-[#b4f04d]">.</span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-8 xl:gap-10" aria-label="Primary Navigation">
      {navLinks.map((link) => {
        const isActive =
          link.href === '/work'
            ? currentPath === '/' || currentPath.startsWith('/work')
            : currentPath.startsWith(link.href);
        return (
          <a
            href={link.href}
            class={`text-[12px] font-semibold tracking-[0.18em] uppercase transition-colors ${
              transparent
                ? isActive
                  ? 'text-[#b4f04d]'
                  : 'text-zinc-400 hover:text-white'
                : isActive
                  ? 'text-cyan-600 font-bold'
                  : 'text-slate-600 hover:text-slate-900'
            }`}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    <!-- Right Actions: WhatsApp & Hire Me -->
    <div class="flex items-center gap-3 sm:gap-3.5">
      <!-- WhatsApp Pill Button (Solid Super Black) -->
      <a
        href="https://wa.me/918129917227?text=Hi%20Tibin,%20interested%20in%20discussing%20GTM%20and%20AI%20Growth%20systems"
        target="_blank"
        rel="noopener noreferrer"
        class={`inline-flex items-center gap-2 px-4 sm:px-5 py-2 sm:py-2.5 rounded-full text-[11px] sm:text-[12px] font-semibold tracking-wider uppercase transition-all active:scale-95 ${
          transparent
            ? 'bg-[#000000] hover:bg-zinc-900 text-white border border-zinc-800 shadow-sm'
            : 'bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-200'
        }`}
      >
        <span>WHATSAPP</span>
        <svg
          class="w-3.5 h-3.5 text-zinc-300"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>

      <!-- Hire Me Pill Button -->
      <a
        href="/hire"
        class="inline-flex items-center gap-1.5 px-5 sm:px-6 py-2 sm:py-2.5 rounded-full text-[12px] sm:text-[13px] font-bold text-black bg-[#d2f39c] hover:bg-[#c2e887] shadow-sm transition-all active:scale-95"
      >
        <span>Hire me</span>
        <svg
          class="w-3.5 h-3.5 text-black"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-nav-toggle"
        class={`lg:hidden p-2 rounded-xl border transition-all ${
          transparent
            ? 'text-white border-zinc-800 bg-[#000000]'
            : 'text-slate-700 hover:text-slate-900 border-slate-200 bg-white'
        }`}
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer (Solid Super Black) -->
  <div
    id="mobile-nav-menu"
    class={`hidden lg:hidden border-b px-6 pt-4 pb-6 space-y-3 transition-all ${
      transparent
        ? 'bg-[#000000] border-zinc-800 text-white'
        : 'bg-white border-slate-200 text-slate-900'
    }`}
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class={`block px-3 py-2 rounded-lg text-sm font-semibold tracking-wider uppercase ${
          transparent
            ? 'text-zinc-300 hover:text-[#b4f04d] hover:bg-zinc-900'
            : 'text-slate-700 hover:text-cyan-600 hover:bg-slate-50'
        }`}
      >
        {link.name}
      </a>
    ))}
    <div
      class={`pt-4 border-t flex flex-wrap gap-4 text-xs font-mono px-3 ${
        transparent ? 'border-zinc-800 text-zinc-400' : 'border-slate-100 text-slate-500'
      }`}
    >
      <a href="/glossary" class={transparent ? 'hover:text-[#b4f04d]' : 'hover:text-slate-900'}>Glossary</a>
      <a href="/demand" class={transparent ? 'hover:text-[#b4f04d]' : 'hover:text-slate-900'}>Demand</a>
      <a href="/hire" class={transparent ? 'hover:text-[#b4f04d]' : 'hover:text-slate-900'}>Hire Me</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const menu = document.getElementById('mobile-nav-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
    });
  }
</script>
