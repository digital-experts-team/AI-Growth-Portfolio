---
// WhoIWorkWithSection.astro - Clean white background section without card container
const partners = [
  { num: '01', title: 'International B2B SaaS', description: 'Remote teams hiring in India to build or maintain GTM workflows.' },
  { num: '02', title: 'Funded Indian startups', description: 'Founders building a repeatable process for lead qualification and sales follow-up.' },
  { num: '03', title: 'Heads of GTM', description: 'Teams that need to turn account signals into a clear list of who to contact and why.' },
  { num: '04', title: 'RevOps leaders', description: 'Teams improving CRM lifecycle stages, lead scoring, and ownership across handoffs.' },
];
---

<section class="w-full bg-white text-zinc-900 py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-12 border-b border-zinc-200" id="explore-work" aria-labelledby="partners-heading">
  <div class="max-w-[1360px] mx-auto">
    <!-- Section Header -->
    <div class="flex items-center justify-between pb-6 border-b border-zinc-200 mb-10">
      <div class="flex flex-col gap-1.5">
        <span class="text-xs font-bold text-zinc-500 tracking-widest uppercase font-mono">
          GTM systems for teams building their next stage of growth
        </span>
        <h2 id="partners-heading" class="text-2xl sm:text-3xl lg:text-[44px] font-medium text-zinc-950 tracking-tight leading-tight font-display">
          Who I <span class="heading-highlight">work with.</span>
        </h2>
      </div>

      <!-- Group/Users Icon Badge on Right -->
      <div class="w-10 h-10 rounded-full bg-zinc-100 border border-zinc-200 flex items-center justify-center text-zinc-700 shadow-xs">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
      </div>
    </div>

    <!-- 4 Columns Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10">
      {partners.map((item, index) => (
        <div class={`flex flex-col gap-3 group ${index < partners.length - 1 ? 'lg:border-r lg:border-zinc-200 lg:pr-8' : ''}`}>
          <!-- Numbered Badge -->
          <span class="inline-flex w-fit px-3 py-1 rounded-full bg-[#eef3ff] text-black text-xs font-mono font-bold tracking-wider">
            {item.num}
          </span>

          <h3 class="text-zinc-950 text-lg sm:text-xl font-bold tracking-tight group-hover:text-green-600 transition-colors leading-snug font-display">
            {item.title}
          </h3>

          <p class="text-zinc-600 text-[14px] sm:text-[15px] leading-relaxed font-normal">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
