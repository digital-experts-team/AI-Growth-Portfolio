---
const partners = [
  {
    num: '01',
    title: 'Startups Who Found their ICP Fit',
    description: 'Turning scattered signals into SQL-ready accounts your SDRs can actually work, without adding headcount.',
  },
  {
    num: '02',
    title: 'Enterprise and PMF Scaling',
    description: 'Lifecycle stages, MQL to SQL rules, routing and CRM hygiene that sales trusts, documented so the next person can run it.',
  },
  {
    num: '03',
    title: "CEOs and RevOps Leaders",
    description: 'Paid, SEO and AI search programs tracked to marketing-sourced pipeline, not just lead volume.',
  },
];
---

<div class="relative z-10 w-full px-6 sm:px-10 lg:px-14 xl:px-16 pt-4 sm:pt-5 pb-6 sm:pb-8 bg-[#000000]" id="explore-work" aria-labelledby="partners-heading">
  <!-- Section Header (Compact) -->
  <div class="flex items-center justify-between pb-4">
    <h2 id="partners-heading" class="text-xl sm:text-2xl font-bold text-white tracking-tight -translate-y-[4px]">
      Who I work with<span class="text-[#d2f39c]">.</span>
    </h2>

    <!-- Group/Users Icon Badge on Right -->
    <div class="w-8 h-8 rounded-full bg-[#000000] border border-zinc-800 flex items-center justify-center text-zinc-400">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
        <circle cx="9" cy="7" r="4"></circle>
        <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
      </svg>
    </div>
  </div>

  <!-- Open 3 Columns Grid: Compact Within Hero Container (No Card Boxes) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 pt-1">
    {partners.map((item, index) => (
      <div class={`flex flex-col gap-2.5 group ${index < partners.length - 1 ? 'md:border-r md:border-zinc-800/80 md:pr-6 lg:pr-8' : ''}`}>
        <!-- Numbered Badge in Hire Me Light Green -->
        <span class="inline-flex w-fit px-2.5 py-0.5 rounded-full bg-[#182310] border border-[#d2f39c]/40 text-[#d2f39c] text-[10px] font-mono font-bold tracking-wider">
          {item.num}
        </span>

        <h3 class="text-white text-[15px] sm:text-[16px] font-semibold tracking-tight group-hover:text-[#d2f39c] transition-colors leading-snug">
          {item.title}
        </h3>

        <p class="text-zinc-400 text-[13px] sm:text-[13.5px] leading-relaxed">
          {item.description}
        </p>
      </div>
    ))}
  </div>
</div>
