---
const partners = [
  {
    num: '01',
    title: 'Startups Who Found their ICP Fit',
    description: 'Turning scattered signals into SQL-ready accounts your SDRs can actually work, without adding headcount.',
  },
  {
    num: '02',
    title: 'Enterprise and PMF Scalling',
    description: 'Lifecycle stages, MQL to SQL rules, routing and CRM hygiene that sales trusts, documented so the next person can run it.',
  },
  {
    num: '03',
    title: "CEO'S AND REV OPS LEADERS",
    description: 'Paid, SEO and AI search programs tracked to marketing-sourced pipeline, not just lead volume, not just lead volume.',
  },
];
---

<section class="flex flex-col gap-6 bg-[#000000]" id="explore-work" aria-labelledby="partners-heading">
  <!-- Section Header -->
  <div class="flex items-center justify-between">
    <div class="flex flex-col gap-1.5">
      <span class="text-[12px] font-bold text-[#b4f04d] tracking-widest uppercase font-mono">
        PARTNERSHIP TYPES
      </span>
      <h2 id="partners-heading" class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Who I work with<span class="text-[#b4f04d]">.</span>
      </h2>
    </div>

    <!-- Group/Users Icon Badge on Right -->
    <div class="w-10 h-10 rounded-full bg-[#000000] border border-zinc-800 flex items-center justify-center text-zinc-400">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
        <circle cx="9" cy="7" r="4"></circle>
        <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
      </svg>
    </div>
  </div>

  <!-- 3 Columns Grid: Solid Super Black -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {partners.map((item) => (
      <div class="p-7 rounded-[24px] bg-[#000000] hover:bg-zinc-950 border border-zinc-800 hover:border-zinc-700 transition-all flex flex-col gap-4 shadow-lg group">
        <!-- Numbered Badge in Lime -->
        <span class="inline-flex w-fit px-3 py-1 rounded-full bg-[#121c08] border border-[#b4f04d]/40 text-[#b4f04d] text-[11px] font-mono font-bold tracking-wider">
          {item.num}
        </span>

        <h3 class="text-white text-[18px] font-bold tracking-tight group-hover:text-[#b4f04d] transition-colors">
          {item.title}
        </h3>

        <p class="text-zinc-400 text-[14px] leading-relaxed">
          {item.description}
        </p>
      </div>
    ))}
  </div>
</section>
