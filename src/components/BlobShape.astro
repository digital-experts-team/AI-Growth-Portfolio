---
// BlobShape.astro - Decorative two-tone abstract organic blob accent.
// Original shape (not traced from any reference), used sparingly as a
// background accent behind portrait/hero imagery.
export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 400 400"
  fill="none"
  class={`pointer-events-none select-none ${className}`}
  aria-hidden="true"
>
  <path
    d="M317 64c42 34 68 93 61 150-7 58-47 113-101 141-54 28-122 29-170-4-49-33-78-100-70-159 7-59 50-110 104-137 54-27 134-25 176 9Z"
    fill="#1e5eff"
    opacity="0.35"
  />
  <path
    d="M281 101c33 27 52 72 46 115-6 44-37 86-78 107-41 21-93 21-129-4-37-25-58-75-52-120 6-45 38-84 79-104 41-21 101-21 134 6Z"
    fill="#6fa8ff"
    opacity="0.45"
  />
</svg>
