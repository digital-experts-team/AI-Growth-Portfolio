---
// SpeechBubble.astro - Original glossy 3D-style speech-bubble accent.
// Not traced from any reference; a generic rounded speech-bubble shape with
// a tail and a chat-squiggle glyph, using the same gradient/highlight
// treatment as IconTile. Used sparingly as a single hero-scale accent.
export interface Props {
  size?: number;
  class?: string;
}

const { size = 220, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 200 200"
  class={className}
  aria-hidden="true"
>
  <defs>
    <linearGradient id="speech-bubble-fill" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#6fa8ff" />
      <stop offset="55%" stop-color="#1e5eff" />
      <stop offset="100%" stop-color="#1748d1" />
    </linearGradient>
    <filter id="speech-bubble-shadow" x="-40%" y="-40%" width="180%" height="180%">
      <feDropShadow dx="0" dy="10" stdDeviation="14" flood-color="#0a1428" flood-opacity="0.45" />
    </filter>
    <radialGradient id="speech-bubble-highlight" cx="30%" cy="22%" r="55%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.55" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
    </radialGradient>
  </defs>

  <g filter="url(#speech-bubble-shadow)">
    <path
      d="M30 20h140a20 20 0 0 1 20 20v80a20 20 0 0 1-20 20H86l-32 32v-32H30a20 20 0 0 1-20-20V40a20 20 0 0 1 20-20Z"
      fill="url(#speech-bubble-fill)"
    />
    <path
      d="M30 20h140a20 20 0 0 1 20 20v80a20 20 0 0 1-20 20H86l-32 32v-32H30a20 20 0 0 1-20-20V40a20 20 0 0 1 20-20Z"
      fill="url(#speech-bubble-highlight)"
    />
  </g>

  <!-- Chat squiggle glyph -->
  <path
    d="M46 92c10-22 22-22 32 0s22 22 32 0 22-22 32 0"
    fill="none"
    stroke="#ffffff"
    stroke-width="9"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
