---
// HeroFromUIUX.astro - Full-width edge-to-edge hero image with text floating directly over it with balanced padding
export interface Props {
  photoUrl?: string;
}

const {
  photoUrl = "/images/hero-bg.webp",
} = Astro.props;
---

<section
  class="relative w-full min-h-[580px] sm:min-h-[640px] lg:min-h-[700px] flex items-center text-white overflow-hidden"
  aria-labelledby="hero-title"
>
  <!-- FULL WIDTH EXTENDED HERO IMAGE ACROSS THE ENTIRE SCREEN -->
  <img
    src={photoUrl}
    alt="Tibin Jacob, GTM Engineer & AI Search Specialist"
    class="absolute inset-0 w-full h-full object-cover object-[20%_top] sm:object-center select-none pointer-events-none z-0"
    loading="eager"
    fetchpriority="high"
    width="1920"
    height="1080"
    referrerpolicy="no-referrer"
    onerror="this.onerror=null; this.src='https://i.ibb.co/5gNLHSnP/Hero.webp';"
  />

  <!-- Subtle gradient scrim strictly behind text for legibility -->
  <div class="absolute inset-0 bg-gradient-to-t via-black/25 from-black/80 lg:from-black/60 to-transparent pointer-events-none z-0"></div>

  <!-- FLOATING HERO CONTENT WITH BALANCED EQUAL TOP AND BOTTOM PADDING -->
  <div class="relative z-10 w-full max-w-[1360px] mx-auto px-6 sm:px-10 lg:px-12 pt-32 sm:pt-28 pb-20 sm:pb-24 flex flex-col justify-center">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center w-full">
      
      <!-- Left spacer column allowing the portrait subject to show cleanly -->
      <div class="hidden lg:block lg:col-span-5 pointer-events-none"></div>

      <!-- Hero Text Column on Right (Brought higher up with equal vertical padding) -->
      <div class="lg:col-span-7 flex flex-col items-start gap-5 sm:gap-6 max-w-2xl">
        
        <!-- Top Badge Overline -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/60 backdrop-blur-md border border-white/20 text-[#d2f39c] text-[12px] font-mono font-bold tracking-wide uppercase shadow-lg">
          <span class="w-2 h-2 rounded-xs bg-[#d2f39c]"></span>
          <span>GTM Engineer and AI Search Specialist for B2B Companies</span>
        </div>

        <!-- Main H1 Headline -->
        <h1
          id="hero-title"
          class="text-white text-3xl sm:text-5xl lg:text-[56px] font-extrabold tracking-tight leading-[1.08] [text-shadow:_0_2px_12px_rgba(0,0,0,0.8)]"
        >
          AI Growth Expert for<br />
          <span class="text-[#d2f39c] underline decoration-[#d2f39c] underline-offset-4 sm:underline-offset-8">B2B Companies.</span>
        </h1>

        <!-- Subtitle Prose -->
        <p class="text-zinc-100 text-[15px] sm:text-[17px] lg:text-[18px] leading-relaxed font-normal max-w-xl [text-shadow:_0_1px_8px_rgba(0,0,0,0.8)]">
          I build the right systems that will drive your entire GTM outbound motion and also drive organic traffic on AI search to scale your business in 2026
        </p>

        <!-- CTA Buttons Row -->
        <div class="flex flex-wrap items-center gap-4 pt-1">
          <!-- Primary Pill Button: See how I work ↗ -->
          <a
            href="#explore-work"
            class="group inline-flex items-center gap-3 bg-white hover:bg-zinc-100 text-black font-bold text-[14px] sm:text-[15px] pl-6 pr-2.5 py-2.5 rounded-full shadow-2xl transition-all active:scale-95"
          >
            <span>See how I work</span>
            <span class="w-9 h-9 rounded-full bg-black flex items-center justify-center text-white transition-transform duration-300 group-hover:rotate-45">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>
          </a>
        </div>

      </div>

    </div>
  </div>
</section>
