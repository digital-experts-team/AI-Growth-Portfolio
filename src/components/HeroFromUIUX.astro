---
// HeroFromUIUX.astro - High impact hero imported from UIUX-Portfolio with dynamic rotating text & verified background image
export interface Props {
  bgImage?: string;
  dynamicWords?: string[];
}

const {
  bgImage = "/images/hero-bg.webp",
  dynamicWords = ["Launch MVPs.", "Increase Conversion.", "Improve Retention."]
} = Astro.props;
---

<section
  class="relative w-full min-h-[82vh] md:min-h-[88vh] rounded-3xl overflow-hidden flex flex-col justify-center items-center text-center px-4 sm:px-8 py-16 sm:py-24 bg-[#0d0d0d] border border-slate-800 shadow-2xl mb-12"
  aria-labelledby="uiux-hero-title"
>
  <!-- Background Image with progressive fallback and dark vignette overlay -->
  <div
    class="absolute inset-0 z-0 bg-cover bg-left md:bg-center bg-no-repeat transition-transform duration-1000 scale-100"
    style={`background-image: url('${bgImage}'), url('https://i.ibb.co/5gNLHSnP/Hero.webp');`}
    role="img"
    aria-label="Tibin Jacob Product & UX Leadership Visual Background"
  >
  </div>

  <!-- Deep contrast gradient overlays for maximum readability & seamless transition -->
  <div class="absolute inset-0 z-[1] bg-gradient-to-t from-black/90 via-black/45 to-black/75 pointer-events-none"></div>
  <div class="absolute inset-0 z-[1] bg-radial from-transparent via-black/30 to-black/80 pointer-events-none"></div>

  <!-- Content Container -->
  <div class="relative z-10 max-w-5xl mx-auto flex flex-col items-center justify-center">
    
    <!-- Status / Role Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/15 border border-white/15 backdrop-blur-xl mb-6 transition-all shadow-lg">
      <span class="w-2 h-2 rounded-full bg-[#d2f39c] animate-pulse"></span>
      <span class="text-[11px] sm:text-[12px] font-mono font-medium uppercase tracking-[0.2em] text-[#d2f39c]">
        Available for High-Impact Roles
      </span>
    </div>

    <!-- Main Headline with Dynamic Fading Words -->
    <h1
      id="uiux-hero-title"
      class="text-white text-[32px] sm:text-[48px] md:text-[64px] lg:text-[80px] xl:text-[88px] leading-[1.08] font-light tracking-tight drop-shadow-md"
    >
      <span class="block opacity-90 font-light">I've helped Startups</span>
      
      <!-- Fixed-height container to eliminate Cumulative Layout Shift (CLS) -->
      <div class="relative h-[1.22em] overflow-hidden flex items-center justify-center mt-1" aria-live="polite">
        <span
          id="hero-rotating-word"
          class="font-bold text-white tracking-tight drop-shadow-lg transition-all duration-700 ease-in-out inline-block"
          data-words={JSON.stringify(dynamicWords)}
        >
          {dynamicWords[0]}
        </span>
      </div>
    </h1>

    <p class="mt-6 text-[15px] sm:text-[17px] md:text-[19px] text-slate-300 font-light max-w-2xl leading-relaxed text-center drop-shadow">
      Architecting high-conversion user experiences, product strategy, and scalable full-funnel systems across Fintech, AI, and SaaS.
    </p>

    <!-- CTAs matched from UIUX-Portfolio with fast native anchors -->
    <div class="mt-10 sm:mt-12 flex flex-wrap items-center justify-center gap-4">
      <!-- Explore Work Primary Button with 45deg arrow rotation on hover -->
      <a
        href="#explore-work"
        class="group inline-flex items-center bg-white/10 hover:bg-white/15 active:scale-95 transition-all backdrop-blur-xl rounded-full p-2 pr-3 pl-7 sm:pl-9 border border-white/20 shadow-xl"
        id="explore-work-btn"
      >
        <span class="text-white text-[11px] sm:text-[12px] font-bold uppercase tracking-[0.25em] mr-4 sm:mr-5">
          Explore Work
        </span>
        <div class="bg-[#d2f39c] w-11 h-11 sm:w-13 sm:h-13 rounded-full flex items-center justify-center transition-transform duration-300 group-hover:rotate-45 shadow-md">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#111827"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </div>
      </a>

      <!-- Secondary Resume / Contact Button -->
      <a
        href="/hire"
        class="inline-flex items-center justify-center px-6 py-3.5 rounded-full bg-white/5 hover:bg-white/10 border border-white/15 text-white/90 hover:text-white text-[11px] sm:text-[12px] font-semibold uppercase tracking-[0.18em] transition-all backdrop-blur-md"
      >
        Hire / Inquire
      </a>
    </div>

  </div>
</section>

<!-- Client Script for Rotating Words -->
<script>
  function setupHeroRotatingWords() {
    const wordEl = document.getElementById('hero-rotating-word');
    if (!wordEl) return;

    let words: string[] = ['Launch MVPs.', 'Increase Conversion.', 'Improve Retention.'];
    try {
      const raw = wordEl.getAttribute('data-words');
      if (raw) {
        words = JSON.parse(raw);
      }
    } catch (e) {
      // fallback to default
    }

    if (!words || words.length <= 1) return;

    let currentIndex = 0;
    const intervalTime = 3000;

    setInterval(() => {
      // Fade out and translate up
      wordEl.style.opacity = '0';
      wordEl.style.transform = 'translateY(-24px)';

      setTimeout(() => {
        currentIndex = (currentIndex + 1) % words.length;
        wordEl.textContent = words[currentIndex];
        // Instantly move to bottom before transitioning in
        wordEl.style.transition = 'none';
        wordEl.style.transform = 'translateY(24px)';

        // Force reflow
        void wordEl.offsetHeight;

        // Animate into view
        wordEl.style.transition = 'all 700ms cubic-bezier(0.16, 1, 0.3, 1)';
        wordEl.style.opacity = '1';
        wordEl.style.transform = 'translateY(0)';
      }, 500);
    }, intervalTime);
  }

  // Run on initial load
  setupHeroRotatingWords();

  // Support Astro view transitions or navigation reloads
  document.addEventListener('astro:page-load', setupHeroRotatingWords);
</script>
