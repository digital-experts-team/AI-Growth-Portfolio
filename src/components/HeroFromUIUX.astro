---
// HeroFromUIUX.astro - Full-width edge-to-edge hero image with text floating directly over it with balanced padding
export interface Props {
  photoUrl?: string;
}

const {
  photoUrl = "/images/hero-bg.webp",
} = Astro.props;
---

<section
  class="portfolio-hero relative isolate w-full lg:min-h-[880px] flex items-center overflow-hidden text-white"
  aria-labelledby="hero-title"
>
  <!-- FULL WIDTH EXTENDED HERO IMAGE ACROSS THE ENTIRE SCREEN -->
  <img
    src={photoUrl}
    alt="Tibin Jacob, GTM Engineer"
    class="hero-portrait absolute inset-x-0 top-0 w-full object-cover select-none pointer-events-none"
    loading="eager"
    fetchpriority="high"
    width="1920"
    height="1080"
    referrerpolicy="no-referrer"
    onerror="this.onerror=null; this.src='https://i.ibb.co/5gNLHSnP/Hero.webp';"
  />

  <!-- Subtle gradient scrim strictly behind text for legibility -->
  <div aria-hidden="true" class="hero-scrim pointer-events-none absolute inset-0"></div>

  <!-- FLOATING HERO CONTENT WITH BALANCED EQUAL TOP AND BOTTOM PADDING -->
  <div class="relative z-10 w-full max-w-[1360px] mx-auto px-6 sm:px-10 lg:px-12 pt-[350px] sm:pt-[380px] lg:pt-40 pb-32 lg:pb-48 flex flex-col justify-center">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center w-full">
      
      <!-- Left spacer column allowing the portrait subject to show cleanly -->
      <div class="hidden lg:block lg:col-span-5 pointer-events-none"></div>

      <!-- Hero Text Column on Right (Brought higher up with equal vertical padding) -->
      <div class="lg:col-span-7 flex flex-col items-start gap-5 sm:gap-6 max-w-2xl">
        
        <!-- Name and role -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/60 backdrop-blur-md border border-white/20 text-white text-[12px] font-medium">
          <span class="w-2 h-2 rounded-full bg-[#91aeff]"></span>
          <span>Tibin Jacob | GTM Engineer</span>
        </div>

        <!-- Main H1 Headline -->
        <h1
          id="hero-title"
          class="text-white text-[clamp(2.25rem,5.2vw,4.25rem)] font-medium tracking-[-0.055em] leading-[1.04] text-balance [text-shadow:_0_2px_12px_rgba(0,0,0,0.8)]"
        >
          I turn buying signals into qualified pipeline.
        </h1>

        <!-- Subtitle Prose -->
        <p class="text-zinc-100 text-[15px] sm:text-[17px] lg:text-[18px] leading-relaxed font-normal max-w-xl [text-shadow:_0_1px_8px_rgba(0,0,0,0.8)]">
          I build automated GTM workflows that spot buying signals, qualify leads, and route the right prospects to the right rep so your team can book more client meetings and grow revenue.
        </p>

        <p class="text-sm font-semibold text-white">Based in India · Open to remote full-time and contract roles</p>

        <!-- CTA Buttons Row -->
        <div class="flex flex-wrap items-center gap-4 pt-1">
          <!-- Primary Pill Button: WhatsApp ↗ -->
          <a
            href="https://wa.me/918129917227"
            class="group inline-flex items-center gap-3 bg-white hover:bg-zinc-100 text-black font-bold text-[14px] sm:text-[15px] pl-6 pr-2.5 py-2.5 rounded-full shadow-2xl transition-all active:scale-95"
          >
            <span>WhatsApp</span>
            <span class="w-9 h-9 rounded-full bg-[#eef3ff] flex items-center justify-center text-[#315bd6] transition-transform duration-300 group-hover:rotate-45">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>
          </a>
          <a href="https://www.linkedin.com/in/tibinjacob/" class="inline-flex items-center rounded-full border border-white/70 bg-black/60 px-5 py-3 text-sm font-semibold text-white hover:border-[#91aeff] hover:bg-black/80 hover:text-[#b9ccff]">Connect on LinkedIn</a>
        </div>

      </div>

    </div>
  </div>
</section>

<style>
  .portfolio-hero {
    background: #080c0f;
  }

  .hero-portrait {
    height: 415px;
    object-position: left top;
    mask-image: linear-gradient(#000 63%, transparent 100%);
  }

  .hero-scrim {
    background: linear-gradient(to bottom, rgb(16 22 23 / 28%), transparent 115px);
  }

  @media (min-width: 1024px) {
    .hero-portrait {
      height: calc(100% - 112px);
      object-position: center top;
      mask-image: linear-gradient(#000 76%, transparent 100%);
    }

    .hero-scrim {
      background: linear-gradient(to right, transparent 35%, rgb(8 12 15 / 42%) 63%, rgb(8 12 15 / 64%));
    }
  }
</style>
