---
// HeroFromUIUX.astro - Single rounded container rectangle with solid super black background (no gradients)
// Encloses both hero floating content and Who I Work With within the same container
import WhoIWorkWithSection from './WhoIWorkWithSection.astro';

export interface Props {
  photoUrl?: string;
}

const {
  photoUrl = "/images/hero-bg.webp",
} = Astro.props;
---

<section
  class="relative w-full bg-[#000000] text-white pt-24 sm:pt-28 pb-8 sm:pb-12 px-4 sm:px-6 lg:px-10"
  aria-labelledby="hero-title"
>
  <div class="max-w-[1360px] mx-auto">
    <!-- SINGLE CLEAN CONTAINER RECTANGLE WITH CORNER RADIUS - PURE SUPER BLACK -->
    <div class="relative w-full rounded-[28px] sm:rounded-[36px] overflow-hidden bg-[#000000] border border-zinc-800 shadow-2xl flex flex-col">
      
      <!-- TOP HERO PORTION: PHOTO ON LEFT + FLOATING CONTENT ON RIGHT -->
      <div class="relative w-full min-h-[580px] sm:min-h-[640px] lg:min-h-[680px] flex items-center">
        <!-- Photo Layer: Anchored to left -->
        <div class="absolute inset-y-0 left-0 w-full lg:w-1/2 overflow-hidden pointer-events-none">
          <img
            src={photoUrl}
            alt="Tibin Jacob - AI Growth Expert & GTM Engineer"
            class="w-full h-full object-cover object-top sm:object-center select-none"
            loading="eager"
            fetchpriority="high"
            onerror="this.onerror=null; this.src='https://i.ibb.co/5gNLHSnP/Hero.webp';"
          />
        </div>

        <!-- Solid Super Black Overlay on Right (No Gradients) -->
        <div class="absolute inset-y-0 right-0 w-full lg:w-[58%] bg-[#000000] pointer-events-none hidden lg:block"></div>

        <!-- Mobile Solid Super Black Bottom Section (No Gradients) -->
        <div class="absolute inset-x-0 bottom-0 top-[40%] bg-[#000000] pointer-events-none lg:hidden"></div>

        <!-- Corner Watermark Badge matching screenshot -->
        <div class="absolute top-5 left-5 sm:top-6 sm:left-6 z-20 flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#000000] border border-zinc-800 text-[11px] font-mono text-white/90 shadow-lg">
          <span class="w-2 h-2 rounded-xs bg-[#b4f04d] animate-pulse"></span>
          <span>Tibin Jacob.</span>
        </div>

        <!-- FLOATING CONTENT INSIDE CONTAINER ON RIGHT SIDE (SUPER BLACK BACKGROUND) -->
        <div class="relative z-10 w-full px-6 sm:px-10 lg:px-14 xl:px-16 py-12 sm:py-16 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <!-- Spacer column on left to showcase portrait clearly -->
          <div class="hidden lg:block lg:col-span-5 pointer-events-none"></div>

          <!-- Content Column on right floating on pure solid super black -->
          <div class="lg:col-span-7 flex flex-col items-start gap-6 max-w-2xl bg-[#000000] lg:bg-transparent p-2 sm:p-0 rounded-2xl">
            
            <!-- Category Overline in Lime Accent -->
            <div class="text-[#b4f04d] text-[13px] sm:text-[14px] font-medium tracking-wide">
              GTM Engineer · AI Search (AEO/GEO) · B2B Performance Marketing
            </div>

            <!-- Main Title -->
            <h1
              id="hero-title"
              class="text-white text-3xl sm:text-5xl lg:text-[52px] xl:text-[58px] font-extrabold tracking-tight leading-[1.08]"
            >
              AI Growth Expert for<br />
              B2B Companies<span class="text-[#b4f04d]">.</span>
            </h1>

            <!-- Subtitle Paragraph -->
            <p class="text-zinc-300 text-[15px] sm:text-[16px] lg:text-[17px] leading-relaxed font-light">
              I turn buying signals, AI search and paid demand into pipeline your sales team can work. Clay, n8n and HubSpot for GTM automation; ChatGPT, Perplexity and Google AI Overviews for AI search; Meta and Google Ads measured to SQLs.
            </p>

            <!-- CTA Buttons Row -->
            <div class="flex flex-wrap items-center gap-4 pt-2">
              <!-- Primary Pill Button: See how I work ↗ -->
              <a
                href="#explore-work"
                class="group inline-flex items-center gap-3 bg-white hover:bg-zinc-100 text-black font-bold text-[14px] sm:text-[15px] pl-6 pr-2.5 py-2.5 rounded-full shadow-lg transition-all active:scale-95"
              >
                <span>See how I work</span>
                <span class="w-9 h-9 rounded-full bg-[#000000] flex items-center justify-center text-white transition-transform duration-300 group-hover:rotate-45">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                </span>
              </a>

              <!-- Secondary Pill Button: Download resume ⤓ -->
              <a
                href="https://drive.google.com/file/d/1uBhd_NZycAvqsasK7_VIY3R_Psad8N-n/view?usp=sharing"
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-3 bg-[#000000] hover:bg-zinc-900 text-white border border-zinc-800 font-semibold text-[14px] sm:text-[15px] pl-6 pr-2.5 py-2.5 rounded-full transition-all active:scale-95 shadow-md"
              >
                <span>Download resume</span>
                <span class="w-9 h-9 rounded-full bg-zinc-900 flex items-center justify-center text-zinc-300 transition-transform duration-200 group-hover:translate-y-0.5">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <polyline points="19 12 12 19 5 12"></polyline>
                  </svg>
                </span>
              </a>
            </div>

            <!-- Location & Availability Divider Note -->
            <div class="w-full pt-6 mt-2 border-t border-zinc-800">
              <p class="text-zinc-400 text-[13px] sm:text-[14px] font-normal leading-relaxed">
                Bengaluru, working with US and European hours. Open to full-time roles and project builds.
              </p>
            </div>

          </div>
        </div>
      </div>

      <!-- INTERNAL DIVIDER WITHIN HERO CONTAINER -->
      <div class="w-full border-t border-zinc-800"></div>

      <!-- WHO I WORK WITH SECTION EMBEDDED INSIDE HERO CONTAINER -->
      <WhoIWorkWithSection />

    </div>
  </div>
</section>
