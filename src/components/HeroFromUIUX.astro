---
// HeroFromUIUX.astro - Navy card block with cutout portrait, blob + speech-bubble accents
import BlobShape from './BlobShape.astro';
import SpeechBubble from './SpeechBubble.astro';

export interface Props {
  photoUrl?: string;
}

const {
  photoUrl = "/images/hero-cutout.webp",
} = Astro.props;
---

<section class="w-full bg-white py-6 sm:py-10 px-4 sm:px-6 lg:px-10" aria-labelledby="hero-title">
  <div class="max-w-[1360px] mx-auto">
    <div class="relative w-full rounded-[32px] sm:rounded-[40px] overflow-hidden bg-[#0a1428] border border-[#1b3261] shadow-2xl">
      <!-- Decorative blue blob glow -->
      <BlobShape class="absolute -right-10 -top-10 w-[480px] h-[480px] sm:w-[620px] sm:h-[620px] blur-3xl opacity-45 pointer-events-none" />
      <BlobShape class="hidden lg:block absolute left-0 bottom-0 w-[360px] h-[360px] blur-3xl opacity-25 pointer-events-none" />

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-end px-6 sm:px-10 lg:px-14">

        <!-- Cutout Portrait Column -->
        <div class="lg:col-span-5 relative flex items-end justify-center pt-10 sm:pt-12 lg:pt-14 order-1 lg:order-none">
          <img
            src={photoUrl}
            alt="Tibin Jacob, GTM Engineer and AI growth expert for B2B"
            class="relative z-10 w-full max-w-[280px] sm:max-w-[360px] lg:max-w-[420px] h-auto object-contain select-none"
            loading="eager"
            fetchpriority="high"
          />
          <!-- Dominant speech-bubble accent, scoped to the photo so it never crosses into the headline -->
          <SpeechBubble
            size={180}
            class="absolute z-20 top-0 right-0 sm:right-2 lg:right-4 w-28 sm:w-36 lg:w-40 h-auto drop-shadow-2xl pointer-events-none"
          />
        </div>

        <!-- Text Column -->
        <div class="lg:col-span-7 flex flex-col items-start gap-5 sm:gap-6 pt-6 pb-10 sm:pb-14 lg:pb-16 max-w-2xl order-2 lg:order-none">

          <!-- Top Badge Overline: hidden visually on mobile to declutter, kept in the DOM for search/AI-answer crawlers -->
          <div class="sr-only sm:not-sr-only sm:inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-[#6fa8ff]/30 text-[#6fa8ff] text-[12px] font-mono font-bold tracking-wide uppercase shadow-lg">
            <span class="w-2 h-2 rounded-xs bg-[#1e5eff]"></span>
            <span>GTM Engineer and AI Search Specialist for B2B Companies</span>
          </div>

          <!-- Main H1 Headline -->
          <h1
            id="hero-title"
            class="text-white text-4xl sm:text-6xl lg:text-[64px] font-black tracking-tight leading-[1.02] uppercase"
          >
            AI Growth Expert for<br />
            <span class="text-[#6fa8ff] underline decoration-[#1e5eff] underline-offset-4 sm:underline-offset-8">B2B Companies.</span>
          </h1>

          <!-- Subtitle Prose -->
          <p class="text-zinc-200 text-[15px] sm:text-[17px] lg:text-[18px] leading-relaxed font-normal max-w-xl">
            I build the right systems that will drive your entire GTM outbound motion and also drive organic traffic on AI search to scale your business in 2026
          </p>

          <!-- CTA Buttons Row -->
          <div class="flex flex-wrap items-center gap-4 pt-1">
            <!-- Primary Two-Tone Button: icon chip + text pill, matching the reference contact-button pattern -->
            <a
              href="#explore-work"
              class="group inline-flex items-center rounded-full overflow-hidden shadow-2xl transition-all active:scale-95"
            >
              <span class="w-11 h-11 sm:w-12 sm:h-12 flex items-center justify-center bg-[#6fa8ff] text-[#0a1428] shrink-0 transition-transform duration-300 group-hover:rotate-45">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </span>
              <span class="pl-4 pr-6 sm:pr-7 h-11 sm:h-12 flex items-center bg-[#0a1428] group-hover:bg-[#10213f] text-white font-bold text-[14px] sm:text-[15px] transition-colors">
                See how I work
              </span>
            </a>
          </div>

        </div>

      </div>
    </div>
  </div>
</section>
