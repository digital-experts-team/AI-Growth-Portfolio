---
import { ContactForm } from './ContactForm';
---

<section class="grid grid-cols-1 lg:grid-cols-12 gap-8 xl:gap-12 items-start bg-[#000000]" id="contact" aria-labelledby="contact-heading">
  <!-- Left Column: Form -->
  <div class="lg:col-span-7 flex flex-col gap-6">
    <div class="flex flex-col gap-1.5">
      <span class="text-[12px] font-bold text-[#d2f39c] tracking-widest uppercase font-mono">
        DIRECT PIPELINE
      </span>
      <h2 id="contact-heading" class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-snug">
        Tell me what’s leaking in your pipeline.
      </h2>
    </div>

    <ContactForm client:visible dark={true} />
  </div>

  <!-- Right Column: Book a meeting card (Solid Super Black) -->
  <div class="lg:col-span-5 w-full">
    <div class="rounded-[24px] bg-[#000000] border border-zinc-800 p-7 sm:p-9 flex flex-col justify-between gap-8 shadow-xl">
      <!-- Header with Clock Icon -->
      <div class="flex items-center justify-between">
        <h3 class="text-white text-xl font-bold tracking-tight">
          Book a meeting here
        </h3>
        <div class="w-8 h-8 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-400">
          <svg class="w-4 h-4 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
        </div>
      </div>

      <!-- 3 Steps -->
      <div class="flex flex-col gap-6">
        <!-- Step 1 -->
        <div class="flex items-start gap-4">
          <span class="w-7 h-7 rounded-full bg-[#d2f39c] text-black font-bold text-xs flex items-center justify-center shrink-0 shadow-sm mt-0.5">
            1
          </span>
          <p class="text-zinc-300 text-[14px] leading-relaxed">
            Your message goes straight into HubSpot, the same kind of routing I build for clients.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="flex items-start gap-4">
          <span class="w-7 h-7 rounded-full bg-[#d2f39c] text-black font-bold text-xs flex items-center justify-center shrink-0 shadow-sm mt-0.5">
            2
          </span>
          <p class="text-zinc-300 text-[14px] leading-relaxed">
            I reply with questions or a short plan.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="flex items-start gap-4">
          <span class="w-7 h-7 rounded-full bg-[#d2f39c] text-black font-bold text-xs flex items-center justify-center shrink-0 shadow-sm mt-0.5">
            3
          </span>
          <p class="text-zinc-300 text-[14px] leading-relaxed">
            If it’s a fit, we set up a call to go through your stack and goals.
          </p>
        </div>
      </div>

      <!-- Divider: Prefer direct email -->
      <div class="pt-6 border-t border-zinc-900 flex flex-col gap-1.5">
        <span class="text-zinc-500 text-xs font-mono">Prefer direct email?</span>
        <a
          href="mailto:tibin.jacob.uiux@gmail.com"
          class="text-[#d2f39c] hover:underline font-mono text-sm tracking-wide transition-all"
        >
          tibin.jacob.uiux@gmail.com
        </a>
      </div>
    </div>
  </div>
</section>
