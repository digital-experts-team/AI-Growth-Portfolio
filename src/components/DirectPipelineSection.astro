---
import { ContactForm } from './ContactForm';
import IconTile from './IconTile.astro';
---

<section class="w-full bg-white text-zinc-900 py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-12 border-b border-zinc-200" id="contact" aria-labelledby="contact-heading">
  <div class="max-w-[1360px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 xl:gap-12 items-start">
    <!-- Left Column: Form -->
    <div class="lg:col-span-7 flex flex-col gap-6">
      <div class="flex flex-col gap-1.5">
        <span class="text-xs font-bold text-zinc-500 tracking-widest uppercase font-mono">
          Zero-to-one growth & pipeline diagnostics
        </span>
        <h2 id="contact-heading" class="text-2xl sm:text-3xl lg:text-[44px] font-extrabold text-zinc-950 tracking-tight leading-snug font-display">
          Direct <span class="heading-highlight">Pipeline.</span>
        </h2>
      </div>

    <ContactForm client:visible dark={false} />
  </div>

  <!-- Right Column: Book a meeting card (Bento Black Card with Fade Stroke & Drop Shadow) -->
  <div class="lg:col-span-5 w-full">
    <div class="bento-card rounded-[24px] p-7 sm:p-9 flex flex-col justify-between gap-8">
      <!-- Header with Clock Icon -->
      <div class="flex items-center justify-between">
        <h3 class="text-white text-xl font-bold tracking-tight">
          Book a meeting here
        </h3>
        <IconTile glyph="clock" size={36} />
      </div>

      <!-- 3 Steps -->
      <div class="flex flex-col gap-6">
        <!-- Step 1 -->
        <div class="flex items-start gap-4">
          <span class="w-7 h-7 rounded-full bg-[#1e5eff] text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-sm mt-0.5">
            1
          </span>
          <p class="text-zinc-300 text-[14px] leading-relaxed">
            Your message goes straight into HubSpot, the same kind of routing I build for clients.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="flex items-start gap-4">
          <span class="w-7 h-7 rounded-full bg-[#1e5eff] text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-sm mt-0.5">
            2
          </span>
          <p class="text-zinc-300 text-[14px] leading-relaxed">
            I reply with questions or a short plan.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="flex items-start gap-4">
          <span class="w-7 h-7 rounded-full bg-[#1e5eff] text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-sm mt-0.5">
            3
          </span>
          <p class="text-zinc-300 text-[14px] leading-relaxed">
            If it’s a fit, we set up a call to go through your stack and goals.
          </p>
        </div>
      </div>

      <!-- Divider: Prefer direct email -->
      <div class="pt-6 border-t border-zinc-800 flex flex-col gap-1.5">
        <span class="text-zinc-500 text-xs font-mono">Prefer direct email?</span>
        <a
          href="mailto:tibin.jacob.uiux@gmail.com"
          class="text-[#6fa8ff] hover:underline font-mono text-sm tracking-wide transition-all"
        >
          tibin.jacob.uiux@gmail.com
        </a>
      </div>
    </div>
  </div>
</div>
</section>
