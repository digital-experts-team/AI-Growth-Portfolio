---
const tools = [
  'Clay',
  'Apollo',
  'HubSpot',
  'Instantly',
  'Claude',
  'n8n',
  'Clay',
  'Apollo',
  'HubSpot',
  'Instantly',
  'Claude',
  'n8n',
];
---

<div class="w-full py-4 bg-[#000000]" aria-label="Core Technology Integrations">
  <div class="relative w-full overflow-hidden bg-[#000000]">
    <!-- Scrolling Rail without gradients -->
    <div class="flex items-center justify-center gap-3 sm:gap-4 flex-wrap select-none py-1">
      {tools.map((tool, index) => (
        <div class="flex items-center gap-3">
          <div class="px-4 sm:px-5 py-2 rounded-full bg-[#000000] hover:bg-zinc-950 border border-zinc-800 text-zinc-300 hover:text-white text-[12px] sm:text-[13px] font-mono transition-all duration-200 shadow-sm cursor-default">
            {tool}
          </div>
          {index < tools.length - 1 && (
            <span class="text-zinc-600 text-xs hidden sm:inline-block">•</span>
          )}
        </div>
      ))}
    </div>
  </div>
</div>
