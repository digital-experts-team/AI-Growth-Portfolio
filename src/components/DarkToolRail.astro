---
// DarkToolRail.astro - Tool Stack in exact same style as WhoIWorkWithSection
const toolGroups = [
  {
    num: '01',
    label: 'GTM & Outbound',
    pills: ['Clay', 'Apollo', 'HubSpot', 'Zoho SalesIQ', 'Instantly'],
  },
  {
    num: '02',
    label: 'Automation & Agents',
    pills: ['n8n', 'Make', 'Zapier', 'Claude'],
  },
  {
    num: '03',
    label: 'Analytics & Ads',
    pills: ['GA4', 'Microsoft Clarity', 'Meta Ads', 'Google Ads', 'Looker Studio'],
  },
];
---

<section class="w-full bg-white text-zinc-900 py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-12 border-b border-zinc-200" aria-labelledby="tool-stack-heading">
  <div class="max-w-[1360px] mx-auto flex flex-col gap-8">
    
    <!-- Section Header (Identical to WhoIWorkWithSection) -->
    <div class="flex items-center justify-between pb-6 border-b border-zinc-200">
      <div class="flex flex-col gap-1.5">
        <span class="text-[12px] font-bold text-zinc-500 tracking-widest uppercase font-mono">
          The tools I build AI growth systems with
        </span>
        <h2 id="tool-stack-heading" class="text-2xl sm:text-3xl lg:text-[44px] font-extrabold text-zinc-950 tracking-tight leading-tight">
          My Tool <span class="heading-highlight">Stack.</span>
        </h2>
      </div>

      <!-- Terminal / Layers Icon Badge on Right -->
      <div class="w-10 h-10 rounded-full bg-zinc-100 border border-zinc-200 flex items-center justify-center text-zinc-700 shadow-xs">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
          <polyline points="2 17 12 22 22 17"></polyline>
          <polyline points="2 12 12 17 22 12"></polyline>
        </svg>
      </div>
    </div>

    <!-- 3 Columns Grid (Matching WhoIWorkWithSection Layout) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
      {toolGroups.map((group, index) => (
        <div class={`flex flex-col gap-4 group ${index < toolGroups.length - 1 ? 'md:border-r md:border-zinc-200 md:pr-8 lg:pr-10' : ''}`}>
          
          <!-- Numbered Badge & Group Label Header -->
          <div class="flex items-center gap-2.5">
            <span class="inline-flex w-fit px-3 py-1 rounded-full bg-[#d2f39c] text-black text-[11px] font-mono font-bold tracking-wider">
              {group.num}
            </span>
            <h3 class="text-zinc-950 text-base sm:text-lg font-bold tracking-tight uppercase font-mono text-xs">
              {group.label}
            </h3>
          </div>

          <!-- Horizontal Pill Row -->
          <div class="flex flex-wrap items-center gap-2 pt-1">
            {group.pills.map((pill) => (
              <span class="px-3.5 py-1.5 rounded-full bg-zinc-100 border border-zinc-200 text-zinc-800 text-xs font-mono font-semibold hover:bg-zinc-200 hover:border-zinc-300 transition-colors cursor-default shadow-2xs">
                {pill}
              </span>
            ))}
          </div>

        </div>
      ))}
    </div>

    <!-- Lime Link: See the workflows → -->
    <div class="pt-4 border-t border-zinc-100 flex items-center justify-between">
      <a
        href="/workflows"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#d2f39c] hover:bg-[#c2e887] text-black text-xs font-mono font-bold tracking-wider transition-all shadow-sm"
      >
        <span>See the workflows →</span>
      </a>
    </div>

  </div>
</section>
