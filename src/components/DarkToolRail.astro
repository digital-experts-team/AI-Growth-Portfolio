---
// DarkToolRail.astro - Tool Stack in exact same style as WhoIWorkWithSection
const capabilities = [
  { num: '01', label: 'Lead qualification and routing', description: 'I connect inbound signals to lead scoring, CRM lifecycle stages, and ownership rules so qualified accounts reach the right rep with a clear next step.' },
  { num: '02', label: 'Signal-based outbound', description: 'I combine account fit with hiring, funding, or website activity so reps can see why an account is worth contacting now.' },
  { num: '03', label: 'Reliable AI workflows', description: 'I build in retries, clear failure states, and human review so teams can see where a run stopped and decide what happens next.' },
  { num: '04', label: 'Acquisition and activation', description: 'I trace how users move from first interest to signup and activation, then identify where they get stuck and what the team should investigate.' },
];
const stack = ['HubSpot', 'Clay', 'n8n', 'Apollo', 'SalesIQ', 'REST APIs', 'Webhooks'];
---

<section class="w-full bg-white text-zinc-900 py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-12 border-b border-zinc-200" aria-labelledby="tool-stack-heading">
  <div class="max-w-[1360px] mx-auto flex flex-col gap-8">
    
    <!-- Section Header (Identical to WhoIWorkWithSection) -->
    <div class="flex items-center justify-between pb-6 border-b border-zinc-200">
      <div class="flex flex-col gap-1.5">
        <span class="text-[12px] font-bold text-zinc-500 tracking-widest uppercase font-mono">
          GTM engineering and Revenue Operations
        </span>
        <h2 id="tool-stack-heading" class="text-2xl sm:text-3xl lg:text-[44px] font-medium text-zinc-950 tracking-tight leading-tight">
          What I <span class="heading-highlight">build.</span>
        </h2>
      </div>

      <!-- Terminal / Layers Icon Badge on Right -->
      <div class="w-10 h-10 rounded-full bg-zinc-100 border border-zinc-200 flex items-center justify-center text-zinc-700 shadow-xs">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
          <polyline points="2 17 12 22 22 17"></polyline>
          <polyline points="2 12 12 17 22 12"></polyline>
        </svg>
      </div>
    </div>

    <!-- 3 Columns Grid (Matching WhoIWorkWithSection Layout) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10">
      {capabilities.map((group, index) => (
        <div class={`flex flex-col gap-4 group ${index < capabilities.length - 1 ? 'md:border-r md:border-zinc-200 md:pr-8 lg:pr-10' : ''}`}>
          
          <!-- Numbered Badge & Group Label Header -->
          <div class="flex items-center gap-2.5">
            <span class="inline-flex w-fit px-3 py-1 rounded-full bg-[#eef3ff] text-black text-[11px] font-mono font-bold tracking-wider">
              {group.num}
            </span>
            <h3 class="text-zinc-950 text-base sm:text-lg font-bold tracking-tight uppercase font-mono text-xs">
              {group.label}
            </h3>
          </div>

          <p class="text-sm leading-relaxed text-zinc-600">{group.description}</p>

        </div>
      ))}
    </div>

    <div class="flex flex-col gap-2">
      <h3 class="text-sm font-bold text-zinc-950">Core stack</h3>
      <ul class="flex flex-wrap gap-2">
        {stack.map((tool) => <li class="rounded-full border border-zinc-200 bg-zinc-100 px-3.5 py-1.5 text-xs font-mono font-semibold text-zinc-800">{tool}</li>)}
      </ul>
    </div>

    <!-- Lime Link: See the workflows → -->
    <div class="pt-4 border-t border-zinc-100 flex items-center justify-between">
      <a
        href="/workflows"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#eef3ff] hover:bg-[#dce7ff] text-black text-xs font-mono font-bold tracking-wider transition-all shadow-sm"
      >
        <span>See the workflows →</span>
      </a>
    </div>

  </div>
</section>
