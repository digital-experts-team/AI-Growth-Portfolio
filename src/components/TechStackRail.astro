---

<section class="flex flex-col gap-3 -mt-6 sm:-mt-8" aria-label="GTM and AI Tool Integrations Rail">
  <div class="flex items-center justify-between px-1">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="text-[11px] font-semibold text-slate-500 tracking-wider uppercase font-mono">
        ORCHESTRATING WORKFLOWS ACROSS THE MODERN GTM & AI STACK
      </span>
    </div>
    <span class="text-[11px] font-mono text-slate-400 hidden sm:inline-block">
      12+ Core Connectors
    </span>
  </div>

  <!-- Marquee Scroller Container with Edge Gradient Fade -->
  <div class="relative w-full overflow-hidden rounded-2xl bg-slate-50/70 border border-slate-200/80 py-3 sm:py-3.5 shadow-[inset_0_1px_2px_rgba(0,0,0,0.02)]">
    <!-- Gradient Masks -->
    <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-16 sm:w-28 bg-gradient-to-r from-slate-50 via-slate-50/90 to-transparent z-10"></div>
    <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-16 sm:w-28 bg-gradient-to-l from-slate-50 via-slate-50/90 to-transparent z-10"></div>

    <!-- Scrolling Rail -->
    <div class="animate-marquee flex items-center gap-3 sm:gap-4 px-4 select-none">
      {marqueeList.map((tool) => (
        <div
          class="flex items-center gap-3 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl bg-white border border-slate-200/90 shadow-2xs hover:shadow-xs hover:border-slate-300 hover:bg-slate-50/50 transition-all duration-150 shrink-0 cursor-default group"
          title={`${tool.name} — ${tool.category}`}
        >
          <div class="w-8 h-8 rounded-lg bg-slate-50 border border-slate-200/80 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform duration-150">
            <Fragment set:html={tool.svg} />
          </div>
          <div class="flex flex-col">
            <span class="text-[13px] font-bold text-slate-900 group-hover:text-blue-600 transition-colors leading-tight">
              {tool.name}
            </span>
            <span class="text-[10px] font-mono text-slate-500 font-medium leading-tight pt-0.5">
              {tool.category}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
