---
export interface Props {
  trigger: string;
  steps: { title: string; body: string; tool?: string; node?: string }[];
  tools: string[];
  output?: string;
}

const { trigger, steps, tools, output } = Astro.props;
const outcome = output || steps[steps.length - 1]?.title || 'Outcome';
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="architecture" class="scroll-mt-24 my-14" aria-labelledby="architecture-heading">
  <h2 id="architecture-heading" class="text-2xl sm:text-3xl font-bold text-zinc-950 tracking-tight mb-2">Architecture at a glance</h2>
  <p class="text-sm sm:text-base text-zinc-600 mb-6">The whole workflow as one flow: a trigger, {steps.length} stages and the outcome.</p>

  <figure class="rounded-2xl border border-zinc-200 bg-[#f8fafc] p-5 sm:p-8 m-0">
    <div class="mx-auto max-w-lg" role="list" aria-label="Workflow flow chart">
      <div role="listitem" class="rounded-xl bg-zinc-950 px-4 py-3.5 shadow-sm">
        <div class="text-[10px] font-bold uppercase tracking-widest text-[#d2f39c] mb-1">Trigger</div>
        <div class="text-sm font-semibold text-white leading-snug">{trigger}</div>
      </div>

      {steps.map((s, i) => (
        <Fragment>
          <div class="flex justify-center py-1" aria-hidden="true">
            <svg width="16" height="24" viewBox="0 0 16 24" fill="none">
              <path d="M8 1v19M2.5 15l5.5 6 5.5-6" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <div role="listitem" class="rounded-xl border border-zinc-300 bg-white px-4 py-3 flex items-center justify-between gap-3 shadow-sm">
            <div class="flex items-center gap-3 min-w-0">
              <span class="flex-none text-xs font-bold text-[#16a34a]">{pad(i + 1)}</span>
              <span class="text-sm font-semibold text-zinc-950 leading-snug">{s.node || s.title}</span>
            </div>
            {s.tool && (
              <span class="flex-none max-w-[45%] text-right text-[11px] font-semibold text-zinc-700 bg-zinc-100 border border-zinc-200 rounded-full px-2 py-0.5">
                {s.tool}
              </span>
            )}
          </div>
        </Fragment>
      ))}

      <div class="flex justify-center py-1" aria-hidden="true">
        <svg width="16" height="24" viewBox="0 0 16 24" fill="none">
          <path d="M8 1v19M2.5 15l5.5 6 5.5-6" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      <div role="listitem" class="rounded-xl bg-[#d2f39c] border border-[#b5dd74] px-4 py-3.5">
        <div class="text-[10px] font-bold uppercase tracking-widest text-zinc-800 mb-1">Outcome</div>
        <div class="text-sm font-semibold text-zinc-950 leading-snug">{outcome}</div>
      </div>
    </div>

    <figcaption class="mt-6 pt-4 border-t border-zinc-200 flex flex-wrap items-center gap-2 text-xs">
      <span class="font-semibold text-zinc-600 mr-1">Stack:</span>
      {tools.map((t) => (
        <span class="px-2 py-0.5 rounded-full bg-white border border-zinc-200 text-zinc-800 font-semibold">{t}</span>
      ))}
    </figcaption>
  </figure>
</section>
