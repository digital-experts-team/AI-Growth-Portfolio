---
// Quick Direct Contact Links Row - Navy bento cards with glossy blue icon tiles
import IconTile from './IconTile.astro';
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4" aria-label="Direct Contact Links">
  <!-- Email Card -->
  <a
    href="mailto:tibin.jacob.uiux@gmail.com"
    class="bento-card p-6 rounded-[22px] flex flex-col items-center justify-center text-center gap-2 group"
  >
    <IconTile glyph="mail" size={40} />
    <span class="text-zinc-500 text-[10px] font-mono tracking-widest uppercase font-semibold">
      EMAIL
    </span>
    <span class="text-white text-[14px] font-medium group-hover:text-[#6fa8ff] transition-colors font-mono">
      tibin.jacob.uiux@gmail.com
    </span>
  </a>

  <!-- LinkedIn Card -->
  <a
    href="https://www.linkedin.com/in/tibinjacob"
    target="_blank"
    rel="noopener noreferrer"
    class="bento-card p-6 rounded-[22px] flex flex-col items-center justify-center text-center gap-2 group"
  >
    <IconTile glyph="linkedin" size={40} />
    <span class="text-zinc-500 text-[10px] font-mono tracking-widest uppercase font-semibold">
      LINKEDIN
    </span>
    <span class="text-white text-[14px] font-medium group-hover:text-[#6fa8ff] transition-colors font-mono">
      in/tibinjacob
    </span>
  </a>

  <!-- WhatsApp Card -->
  <a
    href="https://wa.me/918129917227"
    target="_blank"
    rel="noopener noreferrer"
    class="bento-card p-6 rounded-[22px] flex flex-col items-center justify-center text-center gap-2 group"
  >
    <IconTile glyph="whatsapp" size={40} />
    <span class="text-zinc-500 text-[10px] font-mono tracking-widest uppercase font-semibold">
      WHATSAPP / CALL
    </span>
    <span class="text-white text-[14px] font-medium group-hover:text-[#6fa8ff] transition-colors font-mono">
      +91 8129917227
    </span>
  </a>
</div>
