---
const awards = [
  {
    title: "#1 Product Hunt launch",
    org: "PADDLEBOAT AI",
    description: "Contributed to a #1 Product Hunt launch for an AI sales roleplay and coaching product.",
    icon: `<svg class="w-6 h-6 text-zinc-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.45 1-1 1H7.5c-.83 0-1.5.67-1.5 1.5v1h12v-1c0-.83-.67-1.5-1.5-1.5H15c-.55 0-1-.45-1-1v-2.34"/><path d="M6 4h12v6a6 6 0 0 1-12 0V4Z"/></svg>`,
  },
  {
    title: "New service line brief",
    org: "MAVLERS",
    description: "Ran the ICP workshop that became the brief for a new automation vertical on top of white-label PPC and SEO/AEO delivery.",
    icon: `<svg class="w-6 h-6 text-zinc-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>`,
  },
  {
    title: "Agents behind a human gate",
    org: "HEURIST AI",
    description: "Autopilot content agents on X and LinkedIn, built with state-machine logic, retries and error handling.",
    icon: `<svg class="w-6 h-6 text-zinc-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9Z"/><path d="M11 3 8 9l4 12 4-12-3-6"/><path d="M2 9h20"/></svg>`,
  },
  {
    title: "Founder-led GTM",
    org: "SONIC",
    description: "Automations for investor briefings, growth and support across X, LinkedIn, Discord and email.",
    icon: `<svg class="w-6 h-6 text-zinc-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>`,
  },
];
---

<section class="flex flex-col gap-6 bg-white text-zinc-900" aria-labelledby="awards-heading">
  <!-- Header Row -->
  <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4">
    <h2 id="awards-heading" class="text-3xl sm:text-4xl font-extrabold text-zinc-950 tracking-tight">
      Proof & <span class="text-zinc-950 underline decoration-[#d2f39c] underline-offset-4">recognition.</span>
    </h2>
    <p class="text-zinc-600 text-sm max-w-md sm:text-right font-light leading-relaxed">
      Validation from the industry across B2B SaaS, Web3, and growth platforms.
    </p>
  </div>

  <!-- Cards Grid: Clean White Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {awards.map((award) => (
      <div class="p-6 sm:p-7 rounded-2xl bg-white hover:bg-zinc-50 border border-zinc-200 hover:border-zinc-300 transition-all flex flex-col gap-5 shadow-xs hover:shadow-md group">
        <!-- Icon Container -->
        <div class="w-12 h-12 rounded-xl bg-zinc-100 border border-zinc-200 flex items-center justify-center text-zinc-700 group-hover:scale-105 transition-transform">
          <Fragment set:html={award.icon} />
        </div>

        <div class="flex flex-col gap-1.5">
          <h3 class="text-zinc-950 text-[17px] font-bold tracking-tight">
            {award.title}
          </h3>
          <span class="text-zinc-700 text-[11px] font-mono font-semibold tracking-wider uppercase">
            {award.org}
          </span>
          <p class="text-zinc-600 text-[13px] leading-relaxed pt-2">
            {award.description}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
