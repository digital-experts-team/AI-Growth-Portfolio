---
export interface Props {
  items: { q: string; a: string }[];
  title?: string;
}

const { items, title = 'Frequently Asked Questions' } = Astro.props;
---

<section class="faq-section my-12" aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="text-2xl font-semibold mb-6 tracking-tight">{title}</h2>
  <div class="space-y-4">
    {items.map((item, idx) => (
      <details class="group border border-[var(--surface-border)] rounded-xl bg-[var(--surface)] p-5 transition-colors hover:border-white/20 open:bg-[var(--surface-elevated)]">
        <summary class="flex justify-between items-center cursor-pointer font-medium text-lg text-white list-none">
          <span>{item.q}</span>
          <span class="text-[var(--accent)] transition-transform duration-200 group-open:rotate-180 ml-4 shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <p class="mt-4 text-gray-300 leading-relaxed text-sm sm:text-base border-t border-[var(--surface-border)] pt-4">
          {item.a}
        </p>
      </details>
    ))}
  </div>
</section>
