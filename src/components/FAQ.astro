---
export interface Props {
  items: { q: string; a: string }[];
  title?: string;
}

const { items, title = 'Frequently Asked Questions' } = Astro.props;
---

<section class="faq-section my-12" aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="text-2xl font-bold text-slate-900 mb-6 tracking-tight">{title}</h2>
  <div class="space-y-4">
    {items.map((item) => (
      <details class="group border border-slate-200/90 rounded-xl bg-white p-5 transition-all hover:border-slate-300 shadow-sm open:bg-slate-50/50">
        <summary class="flex justify-between items-center cursor-pointer font-semibold text-base sm:text-lg text-slate-900 list-none">
          <span>{item.q}</span>
          <span class="text-cyan-600 transition-transform duration-200 group-open:rotate-180 ml-4 shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <p class="mt-4 text-slate-600 leading-relaxed text-sm sm:text-base border-t border-slate-100 pt-4">
          {item.a}
        </p>
      </details>
    ))}
  </div>
</section>
