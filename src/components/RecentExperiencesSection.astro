---
// Recent Experiences Section - Modern Dark Grey Container Cards with Image Layout
import { getCollection } from 'astro:content';

const allCaseStudies = await getCollection('caseStudies');
// Sort or re-order if needed (Mavlers, Paddleboat, Heurist, Sonic)
const order = ['mavlers-partner-agency-signals', 'paddleboat-sdr-scaling-signals', 'heurist-autopilot-agents', 'sonic-founder-led-gtm'];
const caseStudies = allCaseStudies.sort((a, b) => {
  const indexA = order.indexOf(a.data.slug || a.id);
  const indexB = order.indexOf(b.data.slug || b.id);
  return (indexA === -1 ? 99 : indexA) - (indexB === -1 ? 99 : indexB);
});
---

<section class="w-full bg-white text-zinc-900 py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-12 border-b border-zinc-200" aria-labelledby="experience-heading">
  <div class="max-w-[1360px] mx-auto flex flex-col gap-8">
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 pb-6 border-b border-zinc-200 mb-2">
      <div class="flex flex-col gap-1.5">
        <span class="text-[12px] font-bold text-zinc-500 tracking-widest uppercase font-mono">
          GTM engineering case studies & outcomes
        </span>
        <h2 id="experience-heading" class="text-2xl sm:text-3xl lg:text-[44px] font-extrabold text-zinc-950 tracking-tight leading-tight">
          Recent <span class="heading-highlight">Experience.</span>
        </h2>
      </div>

    <!-- Link to all case studies -->
    <a
      href="/work"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-zinc-100 hover:bg-zinc-200 border border-zinc-200 text-zinc-900 text-[12px] font-semibold tracking-wider transition-all"
    >
      <span>All case studies</span>
      <svg class="w-3.5 h-3.5 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="7" y1="17" x2="17" y2="7"></line>
        <polyline points="7 7 17 7 17 17"></polyline>
      </svg>
    </a>
  </div>

  <div class="flex flex-col gap-6">
    {caseStudies.map((cs) => {
      const slug = cs.data.slug || cs.id;
      const imageUrl = cs.data.image || `/images/case-studies/${slug.split('-')[0]}.jpg`;
      const tag = cs.data.tag || `#${cs.data.cluster.replace(/\s+/g, '')}`;
      const avatarUrl = cs.data.authorAvatar || "/images/tibin-avatar.jpg";

      return (
        <article class="bento-card p-4 sm:p-6 rounded-[24px] sm:rounded-[28px] transition-all group">
          <a href={`/work/${slug}`} class="grid grid-cols-1 md:grid-cols-12 gap-5 sm:gap-6 items-center">
            
            <!-- Left Side: Image with Tag Overlay -->
            <div class="md:col-span-5 relative aspect-[4/3] w-full rounded-2xl overflow-hidden bg-zinc-900">
              <span class="absolute top-3 left-3 z-10 px-2.5 py-1 rounded-md bg-black/75 backdrop-blur-md text-[11px] font-mono font-bold text-white tracking-wide border border-white/10">
                {tag}
              </span>
              <img
                src={imageUrl}
                alt={cs.data.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                referrerPolicy="no-referrer"
                loading="lazy"
                onerror="this.onerror=null; this.src='/images/hero-bg.webp';"
              />
            </div>

            <!-- Right Side: Content & Metadata -->
            <div class="md:col-span-7 flex flex-col justify-between h-full py-1 gap-4">
              <div class="flex flex-col gap-2.5">
                <div class="flex items-center justify-between text-xs font-mono text-zinc-400">
                  <span class="text-zinc-400 font-semibold uppercase">{cs.data.company}</span>
                  <span class="text-zinc-500">{cs.data.dates}</span>
                </div>

                <h3 class="text-white text-xl sm:text-2xl font-bold tracking-tight leading-snug group-hover:text-[#d2f39c] transition-colors">
                  {cs.data.title}
                </h3>

                <p class="text-zinc-300 text-sm sm:text-[15px] leading-relaxed font-light line-clamp-3">
                  {cs.data.description}
                </p>
              </div>

              <!-- Author & Action Footer Row -->
              <div class="pt-4 border-t border-zinc-800/80 flex items-center justify-between gap-4 mt-2">
                <div class="flex items-center gap-3">
                  <img
                    src={avatarUrl}
                    alt={cs.data.author || "Tibin Jacob"}
                    class="w-8 h-8 rounded-full object-cover border border-zinc-700 shrink-0"
                    referrerPolicy="no-referrer"
                  />
                  <div class="flex flex-col">
                    <span class="text-xs font-semibold text-white">
                      by {cs.data.author || "Tibin Jacob"}
                    </span>
                    <span class="text-[11px] text-zinc-400 font-mono">
                      {cs.data.role}
                    </span>
                  </div>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                  <div class="w-9 h-9 rounded-full bg-[#6366f1] group-hover:bg-[#d2f39c] group-hover:text-black text-white flex items-center justify-center transition-all duration-300 shadow-md">
                    <svg class="w-4 h-4 transition-transform group-hover:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="7" y1="17" x2="17" y2="7"></line>
                      <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                  </div>
                </div>
              </div>

            </div>
          </a>
        </article>
      );
    })}
  </div>
</div>
</section>
