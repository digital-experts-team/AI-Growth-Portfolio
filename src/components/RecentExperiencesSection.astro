---
---

<section class="flex flex-col gap-6" aria-labelledby="experience-heading">
  <!-- Section Header -->
  <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4">
    <div class="flex flex-col gap-1.5">
      <span class="text-[12px] font-bold text-[#b4f04d] tracking-widest uppercase font-mono">
        EVIDENCE & OUTCOMES
      </span>
      <h2 id="experience-heading" class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Recent Experiences
      </h2>
    </div>

    <!-- Link to all case studies -->
    <a
      href="/work"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#111111] hover:bg-[#1a1a1a] border border-white/10 text-white text-[12px] font-semibold tracking-wider transition-all"
    >
      <span>All case studies, including Sonic</span>
      <svg class="w-3.5 h-3.5 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="7" y1="17" x2="17" y2="7"></line>
        <polyline points="7 7 17 7 17 17"></polyline>
      </svg>
    </a>
  </div>

  <div class="flex flex-col gap-4">
    <!-- Featured Large Case Study: Mavlers -->
    <a
      href="/work/mavlers-partner-agency-signals"
      class="p-7 sm:p-9 rounded-[24px] bg-[#0c0c0c] hover:bg-[#121212] border border-white/10 hover:border-white/20 transition-all flex flex-col gap-4 group shadow-xl"
    >
      <div class="flex items-center justify-between">
        <span class="px-3.5 py-1 rounded-full bg-[#1a1a1a] border border-white/10 text-[11px] font-mono text-zinc-300 font-semibold uppercase tracking-wider">
          MAVLERS · GTM AUTOMATION LEAD · APR 2026 – SEP 2026
        </span>
        <div class="w-8 h-8 rounded-full bg-white/5 group-hover:bg-[#b4f04d] flex items-center justify-center text-zinc-400 group-hover:text-black transition-all">
          <svg class="w-4 h-4 transition-transform group-hover:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </div>
      </div>

      <h3 class="text-white text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight group-hover:text-[#b4f04d] transition-colors max-w-4xl">
        Finding partner agencies for white-label delivery with a multi-signal HubSpot motion
      </h3>

      <p class="text-zinc-400 text-[14px] sm:text-[15px] leading-relaxed max-w-4xl font-light">
        Combined Sales IQ site intent, firmographics and engagement data, scored against the partner-agency ICP, and routed SQL-ready accounts into HubSpot using the MQL to SQL stages sales already trusted. Ran the ICP workshop that became the brief for a new automation service line.
      </p>
    </a>

    <!-- Split 2-Column Case Studies: Paddleboat AI & Heurist AI -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      <!-- Paddleboat AI -->
      <a
        href="/work/paddleboat-sdr-scaling-signals"
        class="p-7 sm:p-8 rounded-[24px] bg-[#0c0c0c] hover:bg-[#121212] border border-white/10 hover:border-white/20 transition-all flex flex-col justify-between gap-6 group shadow-lg"
      >
        <div class="flex flex-col gap-3">
          <div class="flex items-center justify-between">
            <span class="px-3 py-1 rounded-full bg-[#1a1a1a] border border-white/10 text-[10px] font-mono text-zinc-300 font-semibold uppercase tracking-wider">
              PADDLEBOAT AI · GTM ENGINEER · 2022 – 2023
            </span>
            <div class="w-7 h-7 rounded-full bg-white/5 group-hover:bg-[#b4f04d] flex items-center justify-center text-zinc-400 group-hover:text-black transition-all">
              <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </div>
          </div>

          <h3 class="text-white text-lg sm:text-xl font-bold tracking-tight group-hover:text-[#b4f04d] transition-colors">
            Flagging B2B SaaS companies scaling their SDR org
          </h3>

          <p class="text-zinc-400 text-[13px] sm:text-[14px] leading-relaxed">
            Site intent and engagement combined with funding, hiring and team-scale signals to target VPs and Heads of Sales at 50–500 person companies. Contributed to a #1 Product Hunt launch.
          </p>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-white/5 text-[11px] font-mono">
          <span class="text-zinc-400">Intent + Scaling Trigger</span>
          <span class="text-[#b4f04d] font-semibold">Product Hunt #1 🏆</span>
        </div>
      </a>

      <!-- Heurist AI -->
      <a
        href="/work/heurist-autopilot-agents"
        class="p-7 sm:p-8 rounded-[24px] bg-[#0c0c0c] hover:bg-[#121212] border border-white/10 hover:border-white/20 transition-all flex flex-col justify-between gap-6 group shadow-lg"
      >
        <div class="flex flex-col gap-3">
          <div class="flex items-center justify-between">
            <span class="px-3 py-1 rounded-full bg-[#1a1a1a] border border-white/10 text-[10px] font-mono text-zinc-300 font-semibold uppercase tracking-wider">
              HEURIST AI · GTM AUTOMATION · 2024 – 2025
            </span>
            <div class="w-7 h-7 rounded-full bg-white/5 group-hover:bg-[#b4f04d] flex items-center justify-center text-zinc-400 group-hover:text-black transition-all">
              <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </div>
          </div>

          <h3 class="text-white text-lg sm:text-xl font-bold tracking-tight group-hover:text-[#b4f04d] transition-colors">
            Autopilot content agents with a human approval gate
          </h3>

          <p class="text-zinc-400 text-[13px] sm:text-[14px] leading-relaxed">
            Agents that generated and distributed top-of-funnel content on X and LinkedIn, built with state-machine logic, retries and error handling so they ran without daily babysitting.
          </p>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-white/5 text-[11px] font-mono">
          <span class="text-zinc-400">State Machines · Error Gates</span>
          <span class="text-[#b4f04d] font-semibold">Autonomous</span>
        </div>
      </a>
    </div>
  </div>
</section>
