---
// Questions & Answers Accordion Section - Pure Solid Super Black (No Gradients)
const faqs = [
  {
    q: 'What does a GTM engineer do?',
    a: 'A GTM engineer builds the systems that turn buying signals into qualified pipeline: capturing intent, enriching and scoring accounts, routing them into the CRM, and automating follow-up so sales works the right accounts at the right time.',
    isOpen: true,
  },
  {
    q: 'What is answer engine optimization (AEO)?',
    a: 'AEO structures your technical case studies, entity data, and product proof so generative engines like Perplexity, ChatGPT Search, and Google AI Overviews cite your solutions during enterprise vendor evaluations.',
    isOpen: false,
  },
  {
    q: 'What is generative engine optimization (GEO)?',
    a: 'GEO focuses on knowledge graph presence, clear comparative data points, and technical documentation indexing to ensure AI models accurately explain your product\'s architecture and capabilities.',
    isOpen: false,
  },
  {
    q: 'How do you measure marketing to SQLs?',
    a: 'Through closed-loop webhook attribution linking ad conversions, website deanonymization, and outbound touches directly to accepted pipeline opportunities inside HubSpot and Salesforce.',
    isOpen: false,
  },
  {
    q: 'Do you work full-time or on projects?',
    a: 'I take on selective full-time GTM engineering leadership roles as well as targeted quarterly automation sprints for venture-backed B2B companies.',
    isOpen: false,
  },
];
---

<section class="flex flex-col gap-6 bg-[#000000]" aria-labelledby="questions-heading">
  <!-- Section Header -->
  <div class="flex items-center justify-between">
    <div class="flex flex-col gap-1.5">
      <span class="text-[12px] font-bold text-[#b4f04d] tracking-widest uppercase font-mono">
        CLEAR ANSWERS
      </span>
      <h2 id="questions-heading" class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Questions<span class="text-[#b4f04d]">.</span>
      </h2>
    </div>

    <!-- Question Mark Icon Circle -->
    <div class="w-10 h-10 rounded-full bg-[#000000] border border-zinc-800 flex items-center justify-center text-zinc-400">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
        <line x1="12" y1="17" x2="12.01" y2="17"></line>
      </svg>
    </div>
  </div>

  <!-- Accordion List: Solid Super Black (No Gradients) -->
  <div class="flex flex-col gap-3">
    {faqs.map((item, idx) => (
      <details
        class="group bg-[#000000] hover:bg-zinc-950 border border-zinc-800 rounded-2xl overflow-hidden transition-all duration-200"
        open={item.isOpen}
      >
        <summary class="flex items-center justify-between px-6 py-5 cursor-pointer list-none select-none">
          <span class="text-white text-[16px] sm:text-[17px] font-bold group-hover:text-[#b4f04d] transition-colors">
            {item.q}
          </span>
          <div class="w-8 h-8 rounded-full bg-zinc-900 flex items-center justify-center text-zinc-400 group-hover:text-white transition-transform duration-300 group-open:rotate-180 shrink-0">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </div>
        </summary>
        <div class="px-6 pb-6 pt-1 text-zinc-400 text-[14px] sm:text-[15px] leading-relaxed border-t border-zinc-900">
          <p>{item.a}</p>
        </div>
      </details>
    ))}
  </div>
</section>
