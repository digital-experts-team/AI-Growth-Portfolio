---
// Questions & Answers Accordion Section
const faqs = [
  { q: 'What roles are you open to?', a: 'GTM Engineer, Revenue Operations Specialist, and GTM Systems roles. I’m based in India and open to remote full-time and contract work.' },
  { q: 'What kind of work can you own?', a: 'I can take a qualification or routing problem from discovery through implementation. That includes gathering input from sales, defining the rules, connecting the data sources, and setting up the workflow in the CRM.' },
  { q: 'Can you work with our existing CRM and sales process?', a: 'Yes. I start with the lifecycle stages, handoffs, and ownership rules your team already uses. My core CRM experience is with HubSpot, alongside integrations through REST APIs and webhooks.' },
];
---

<section class="w-full bg-zinc-950 text-white py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-12 border-b border-zinc-900" aria-labelledby="questions-heading">
  <div class="max-w-[1360px] mx-auto flex flex-col gap-8">
    <!-- Section Header -->
    <div class="flex items-center justify-between pb-6 border-b border-zinc-800/80 mb-2">
      <div class="flex flex-col gap-1.5">
        <span class="text-xs font-bold text-zinc-400 tracking-widest uppercase font-mono">
          GTM engineering and Revenue Operations
        </span>
        <h2 id="questions-heading" class="text-2xl sm:text-3xl lg:text-[44px] font-extrabold text-white tracking-tight leading-tight font-display">
          Clear <span class="heading-highlight">Answers.</span>
        </h2>
      </div>

      <!-- Question Mark Icon Circle -->
      <div class="w-10 h-10 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-[#d2f39c]">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
          <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
      </div>
    </div>

    <!-- Accordion List -->
    <div class="flex flex-col gap-4">
      {faqs.map((item) => (
        <details
          class="bento-card group rounded-2xl overflow-hidden border border-zinc-800 hover:border-zinc-700 transition-all animate-none"
          open={item.isOpen}
        >
          <summary class="flex items-center justify-between px-6 py-5 cursor-pointer list-none select-none">
            <span class="text-white text-[16px] sm:text-[18px] font-bold group-hover:text-[#d2f39c] transition-colors font-display">
              {item.q}
            </span>
            <div class="w-8 h-8 rounded-full bg-zinc-900 group-hover:bg-[#d2f39c] border border-zinc-800 flex items-center justify-center text-zinc-300 group-hover:text-black transition-all duration-300 group-open:rotate-180 shrink-0">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </summary>
          <div class="px-6 pb-6 pt-2 text-zinc-300 text-sm sm:text-base leading-relaxed border-t border-zinc-800/80 font-normal">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
