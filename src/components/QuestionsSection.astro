---
// Questions & Answers Accordion Section - Pure Solid Super Black (No Gradients)
import { homeFaq } from '../data/homeFaq';
const faqs = homeFaq.map((f, i) => ({ ...f, isOpen: i === 0 }));
---

<section class="flex flex-col gap-6 bg-[#000000]" aria-labelledby="questions-heading">
  <!-- Section Header -->
  <div class="flex items-center justify-between">
    <div class="flex flex-col gap-1.5">
      <span class="text-[12px] font-bold text-[#d2f39c] tracking-widest uppercase font-mono">
        Questions.
      </span>
      <h2 id="questions-heading" class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        GTM engineering and AI search questions
      </h2>
    </div>

    <!-- Question Mark Icon Circle -->
    <div class="w-10 h-10 rounded-full bg-[#000000] border border-zinc-800 flex items-center justify-center text-zinc-400">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
        <line x1="12" y1="17" x2="12.01" y2="17"></line>
      </svg>
    </div>
  </div>

  <!-- Accordion List: Solid Super Black (No Gradients) -->
  <div class="flex flex-col gap-3">
    {faqs.map((item, idx) => (
      <details
        class="group bg-[#000000] hover:bg-zinc-950 border border-zinc-800 rounded-2xl overflow-hidden transition-all duration-200"
        open={item.isOpen}
      >
        <summary class="flex items-center justify-between px-6 py-5 cursor-pointer list-none select-none">
          <span class="text-white text-[16px] sm:text-[17px] font-bold group-hover:text-[#d2f39c] transition-colors">
            {item.q}
          </span>
          <div class="w-8 h-8 rounded-full bg-zinc-900 flex items-center justify-center text-zinc-400 group-hover:text-white transition-transform duration-300 group-open:rotate-180 shrink-0">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </div>
        </summary>
        <div class="px-6 pb-6 pt-1 text-zinc-400 text-[14px] sm:text-[15px] leading-relaxed border-t border-zinc-900">
          <p>{item.a}</p>
        </div>
      </details>
    ))}
  </div>
</section>
